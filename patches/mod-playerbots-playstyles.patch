+Unit* ArenaKillTargetValue::Calculate()
+{
+    if (!bot->InArena())
+        return nullptr;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetStatus() != STATUS_IN_PROGRESS)
+        return nullptr;
+
+    // A real player on the team calls the kill target just by attacking:
+    // whatever the human is hitting, the bots assist.
+    for (auto const& itr : bg->GetPlayers())
+    {
+        Player* member = ObjectAccessor::FindPlayer(itr.first);
+        if (!member || member->GetBgTeamId() != bot->GetBgTeamId())
+            continue;
+
+        PlayerbotAI* memberAI = GET_PLAYERBOT_AI(member);
+        if (memberAI && !memberAI->IsRealPlayer())
+            continue;
+
+        Unit* victim = member->GetVictim();
+        if (victim && victim->IsAlive() && victim->IsPlayer() &&
+            victim->ToPlayer()->GetBgTeamId() != bot->GetBgTeamId())
+            return victim;
+    }
+
+    // The players map is guid-ordered and health is bucketed, so every member
+    // of the team picks the same enemy and the pick doesn't flap between
+    // similar-health targets mid-fight.
+    Unit* best = nullptr;
+    uint32 bestScore = 0xFFFFFFFF;
+    for (auto const& itr : bg->GetPlayers())
+    {
+        Player* enemy = ObjectAccessor::FindPlayer(itr.first);
+        if (!enemy || !enemy->IsAlive() || enemy->GetBgTeamId() == bot->GetBgTeamId())
+            continue;
+
+        uint32 score = (PlayerbotAI::IsHeal(enemy, true) ? 0 : 1000) + uint32(enemy->GetHealthPct()) / 15;
+        if (score < bestScore)
+        {
+            best = enemy;
+            bestScore = score;
+        }
+    }
+
+    return best;
+}
