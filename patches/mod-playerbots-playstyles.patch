+bool QuestHelpOfferTrigger::IsActive()
+{
+    int tier = 0;
+    if (!OfferQuestHelpAction::FindQuestHelpTarget(bot, botAI, tier))
+        return false;
+
+    float chance = tier == 2 ? sPlayerbotAIConfig.questHelpConfirmedChance
+                 : tier == 1 ? sPlayerbotAIConfig.questHelpNearbyChance
+                             : sPlayerbotAIConfig.questHelpRandomChance;
+    return roll_chance_f(chance);
+}
+
+bool AhSellSparesTrigger::IsActive()
+{
+    if (sPlayerbotAIConfig.botAhSellChance <= 0.0f || bot->GetGroup() || bot->IsInCombat())
+        return false;
+    if (!AhSellSparesAction::FindNearbyAuctioneer(bot, botAI))
+        return false;
+    return roll_chance_f(sPlayerbotAIConfig.botAhSellChance);
+}
