+Creature* AhSellSparesAction::FindNearbyAuctioneer(Player* bot, PlayerbotAI* botAI)
+{
+    GuidVector npcs = botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest npcs")->Get();
+    for (ObjectGuid const& guid : npcs)
+        if (Creature* auctioneer = bot->GetNPCIfCanInteractWith(guid, UNIT_NPC_FLAG_AUCTIONEER))
+            return auctioneer;
+    return nullptr;
+}
+
+bool AhSellSparesAction::Execute(Event /*event*/)
+{
+    Creature* auctioneer = FindNearbyAuctioneer(bot, botAI);
+    if (!auctioneer)
+        return false;
+
+    // respect the per-bot listing cap
+    uint32 active = 0;
+    if (QueryResult countResult = CharacterDatabase.Query(
+            "SELECT COUNT(*) FROM auctionhouse WHERE itemowner = {}", bot->GetGUID().GetCounter()))
+        active = (*countResult)[0].Get<uint32>();
+    if (active >= sPlayerbotAIConfig.botAhSellMaxListings)
+        return false;
+
+    AuctionHouseEntry const* ahEntry =
+        AuctionHouseMgr::GetAuctionHouseEntryFromFactionTemplate(auctioneer->GetFaction());
+    if (!ahEntry)
+        return false;
+    AuctionHouseObject* auctionHouse = sAuctionMgr->GetAuctionsMap(auctioneer->GetFaction());
+    if (!auctionHouse)
+        return false;
+
+    // collect a few sellable spares: tradeable, decent quality or trade goods
+    std::vector<Item*> spares;
+    auto consider = [&](Item* item)
+    {
+        if (!item || item->IsSoulBound() || spares.size() >= 3)
+            return;
+        ItemTemplate const* proto = item->GetTemplate();
+        bool sellable = (proto->Class == ITEM_CLASS_ARMOR || proto->Class == ITEM_CLASS_WEAPON)
+                            ? proto->Quality >= ITEM_QUALITY_UNCOMMON
+                            : (proto->Class == ITEM_CLASS_TRADE_GOODS && proto->Quality >= ITEM_QUALITY_NORMAL);
+        if (sellable && proto->SellPrice > 0)
+            spares.push_back(item);
+    };
+    for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, i));
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (Bag* bag = bot->GetBagByPos(b))
+            for (uint32 s = 0; s < bag->GetBagSize(); ++s)
+                consider(bag->GetItemByPos(s));
+
+    if (spares.empty())
+        return false;
+
+    float priceFactor = AhPriceFactorFor(bot);
+    uint32 listed = 0;
+    for (Item* item : spares)
+    {
+        ItemTemplate const* proto = item->GetTemplate();
+        uint32 base = std::max<uint32>(proto->SellPrice, 25) * 3 * item->GetCount();
+        uint32 bid = std::max<uint32>(uint32(base * priceFactor) * urand(80, 120) / 100, 100);
+        uint32 buyout = bid * 13 / 10;
+
+        AuctionEntry* auction = new AuctionEntry();
+        auction->Id = sObjectMgr->GenerateAuctionID();
+        auction->houseId = AuctionHouseId(ahEntry->houseId);
+        auction->item_guid = item->GetGUID();
+        auction->item_template = item->GetEntry();
+        auction->itemCount = item->GetCount();
+        auction->owner = bot->GetGUID();
+        auction->startbid = bid;
+        auction->bidder = ObjectGuid::Empty;
+        auction->bid = 0;
+        auction->buyout = buyout;
+        auction->expire_time = GameTime::GetGameTime().count() +
+                               uint32(12 * HOUR * sWorld->getRate(RATE_AUCTION_TIME));
+        auction->deposit = 0;
+        auction->auctionHouseEntry = ahEntry;
+
+        sAuctionMgr->AddAItem(item);
+        auctionHouse->AddAuction(auction);
+        bot->MoveItemFromInventory(item->GetBagSlot(), item->GetSlot(), true);
+
+        CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+        item->DeleteFromInventoryDB(trans);
+        item->SaveToDB(trans);
+        auction->SaveToDB(trans);
+        bot->SaveInventoryAndGoldToDB(trans);
+        CharacterDatabase.CommitTransaction(trans);
+        ++listed;
+
+        LOG_DEBUG("playerbots", "[BotAH] {} listed {} x{} (bid {} buyout {} copper)",
+                  bot->GetName(), proto->Name1, item->GetCount(), bid, buyout);
+    }
+
+    if (listed)
+        LOG_INFO("playerbots", "[BotAH] {} listed {} item(s) at the auction house", bot->GetName(), listed);
+    return listed > 0;
+}
