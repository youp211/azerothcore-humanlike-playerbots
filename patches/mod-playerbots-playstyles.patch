+bool TradeStatusAction::HandlePendingGearGive(Event& event, Player* trader, ObjectGuid::LowType itemGuidLow, uint32 cod)
+{
+    WorldPacket p(event.getPacket());
+    p.rpos(0);
+    uint32 status;
+    p >> status;
+
+    Item* item = bot->GetItemByGuid(ObjectGuid::Create<HighGuid::Item>(itemGuidLow));
+
+    switch (status)
+    {
+        case TRADE_STATUS_BEGIN_TRADE:
+        {
+            if (!item)
+            {
+                // item vanished (equipped/sold/mailed meanwhile) - apologize and bail
+                ClearPendingGive(bot, trader);
+                SpeakSituation(bot, trader, "you promised them a piece of gear but no longer have it", true);
+                WorldPacket cancel;
+                uint32 cancelStatus = 0;
+                cancel << cancelStatus;
+                bot->GetSession()->HandleCancelTradeOpcode(cancel);
+                return false;
+            }
+            if (!bot->HasInArc(CAST_ANGLE_IN_FRONT, trader, sPlayerbotAIConfig.sightDistance))
+                bot->SetFacingToObject(trader);
+            WorldPacket begin;
+            bot->GetSession()->HandleBeginTradeOpcode(begin);
+            return true;
+        }
+        case TRADE_STATUS_OPEN_WINDOW:
+        {
+            TradeData* myTrade = bot->GetTradeData();
+            if (!myTrade || !item)
+                return false;
+            myTrade->SetItem(TradeSlots(0), item);
+            if (cod)
+                SpeakSituation(bot, trader, Acore::StringFormat(
+                    "you put your {} in the trade window; it costs them {} silver, ask them to add the money",
+                    item->GetTemplate()->Name1, cod / 100), true);
+            WorldPacket accept;
+            uint32 acceptStatus = 0;
+            accept << acceptStatus;
+            bot->GetSession()->HandleAcceptTradeOpcode(accept);
+            return true;
+        }
+        case TRADE_STATUS_TRADE_ACCEPT:
+        case TRADE_STATUS_BACK_TO_TRADE:
+        {
+            // for a paid hand-over, hold acceptance until the money is in
+            if (cod && trader->GetTradeData() && trader->GetTradeData()->GetMoney() < cod)
+                return true;
+            WorldPacket accept;
+            uint32 acceptStatus = 0;
+            accept << acceptStatus;
+            bot->GetSession()->HandleAcceptTradeOpcode(accept);
+            return true;
+        }
+        case TRADE_STATUS_TRADE_COMPLETE:
+        {
+            ClearPendingGive(bot, trader);
+            SpeakSituation(bot, trader, cod ? "you just sold them a piece of gear in a trade, they paid up"
+                                            : "you just gave them a piece of gear for free in a trade", true);
+            LOG_INFO("playerbots", "[GearGive] {} handed item over to {} in trade (cod {} copper)",
+                     bot->GetName(), trader->GetName(), cod);
+            return true;
+        }
+        default:
+            return false;
+    }
+}
