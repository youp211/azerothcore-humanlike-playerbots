+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_GUILDRECRUITMENTEVENT_H
+#define PLAYERBOTS_GUILDRECRUITMENTEVENT_H
+
+#include "ObjectGuid.h"
+
+#include <string>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+// Realm-start guild recruitment. Right after personality guilds form on a fresh
+// world, each guild LEADER travels to its faction's starting area and spends
+// ~15 minutes recruiting: it periodically pitches its guild in its own voice and
+// sends guild invites to nearby unguilded, low-level REAL players (the invite
+// popup is the ask - very 2008). When the window closes each leader teleports
+// back to where it was and resumes normal bot life. Driven from a world-thread
+// tick; cheap when idle. Guarded so it only fires as a realm-start experience.
+class GuildRecruitmentEvent
+{
+public:
+    static GuildRecruitmentEvent& instance();
+
+    // Called at the end of PersonalityGuildFactory::FormPersonalityGuilds with
+    // the freshly-formed guild leaders (leader guid + archetype name). Teleports
+    // each leader to its race's starting area and opens a recruiting window.
+    // No-op when disabled, when leaders is empty, or when the server has been up
+    // too long (not a realm start).
+    void Begin(std::vector<std::pair<ObjectGuid, std::string>> const& leaders);
+
+    // World-thread tick driver; call every world update. Returns immediately when
+    // no recruitment is in progress. Heavy work is throttled to every ~5s.
+    void Update(uint32 diff);
+
+private:
+    GuildRecruitmentEvent() = default;
+
+    struct Recruiter
+    {
+        ObjectGuid leaderGuid;
+        std::string archetype;
+        std::string guildName;
+        uint32 guildId = 0;
+
+        // Where the leader was before it left to recruit - teleported back after.
+        uint32 returnMapId = 0;
+        float returnX = 0.0f;
+        float returnY = 0.0f;
+        float returnZ = 0.0f;
+        float returnO = 0.0f;
+
+        uint32 remainingMs = 0;   // recruiting window left
+        uint32 nextPitchMs = 0;   // countdown to the next in-voice pitch
+        uint32 invitesSent = 0;   // total invites this event (capped)
+        std::unordered_set<ObjectGuid> invited;  // players already invited by this leader
+    };
+
+    void Tick(uint32 elapsed);
+    void Finish(Recruiter const& recruiter, bool teleportBack);
+
+    std::vector<Recruiter> _recruiters;
+    uint32 _tickAccumMs = 0;
+};
+
+#endif
