+        char const* statusNames[RPG_STATUS_END] = {"Idle", "GoGrind", "GoCamp", "WanderRandom",
+                                                   "WanderNpc", "DoQuest", "TravelFlight", "Rest", "OutdoorPvp"};
+        for (ProfileDefault const& prof : profiles)
