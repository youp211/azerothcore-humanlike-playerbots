+###################################################################################################
+# DUNGEON COMPANIONS - EXPERIENCE-BASED PERSISTENCE (local patch)
+#
+# Every dungeon RUN (a group with the real player + >= 1 random bot that actually zones into an
+# instance) is tracked. When it ends, each participating bot is judged by its live mod-ollama-chat
+# sentiment toward the player, after a run-outcome nudge (a clean, long-enough run raises it; each
+# member death lowers it):
+#   - GOOD experience (sentiment >= GoodThreshold)  -> saved as a "friend"
+#   - very BAD        (sentiment <= TrollThreshold)  -> saved as a "troll"
+#   - NEUTRAL in between                             -> NOT saved; the bot returns to the random
+#     pool (instance-only, re-randomised as usual).
+# Saved companions (loved OR hated) are excluded from the random-bot re-randomise churn, so they
+# keep their identity and can be run into again in the world. Requires mod-ollama-chat sentiment
+# tracking; with it disabled, no companions are saved. Thresholds are on the 0.0-1.0 scale.
+###################################################################################################
+
+# Master switch for companion persistence
+AiPlayerbot.DungeonCompanion.Enabled = 1
+
+# Sentiment at/above which a bot is saved as a friend
+AiPlayerbot.DungeonCompanion.GoodThreshold = 0.65
+
+# Sentiment at/below which a bot is saved as a troll
+AiPlayerbot.DungeonCompanion.TrollThreshold = 0.20
+
+# Minutes a run must have lasted for the completion nudge to apply (filters quick abandons)
+AiPlayerbot.DungeonCompanion.MinMinutes = 8
+
+# Sentiment bump applied to each bot for a clean, long-enough completed run
+AiPlayerbot.DungeonCompanion.CompletionNudge = 0.15
+
+# Sentiment drop applied to each bot per member death during the run
+AiPlayerbot.DungeonCompanion.DeathNudge = 0.04
+
+# Seconds between "resolve finished/stale runs" sweeps
+AiPlayerbot.DungeonCompanion.ResolveIntervalSec = 30
diff --git a/data/sql/characters/base/2026_07_10_dungeon_companions.sql b/data/sql/characters/base/2026_07_10_dungeon_companions.sql
new file mode 100644
index 0000000..75cec93
--- /dev/null
+++ b/data/sql/characters/base/2026_07_10_dungeon_companions.sql
@@ -0,0 +1,15 @@
+-- Persistent dungeon companions: random bots that a real player ran a dungeon
+-- with and came away feeling STRONGLY about -- either a great run (friend) or a
+-- genuinely bad one (troll). Both are memorable, so both stick around: while a
+-- guid is in this table, RandomPlayerbotMgr skips re-randomising it, so the bot
+-- keeps its name/level/gear identity and can be run into again out in the world.
+-- Bots the player felt neutral about are never inserted -- they stay throwaway
+-- random-pool bots (instance-only). One row per bot; the newest run wins.
+CREATE TABLE IF NOT EXISTS mod_playerbots_companions (
+    bot_guid    INT UNSIGNED NOT NULL PRIMARY KEY COMMENT 'Character guid (low) of the persisted bot',
+    player_guid INT UNSIGNED NOT NULL COMMENT 'Character guid (low) of the real player who made it memorable',
+    disposition TINYINT UNSIGNED NOT NULL DEFAULT 1 COMMENT '1 = friend (good run), 2 = troll (bad run)',
+    sentiment   FLOAT NOT NULL DEFAULT 0.5 COMMENT 'Bot->player sentiment at save time (0=hostile,1=friendly)',
+    created_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    KEY idx_player (player_guid)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
