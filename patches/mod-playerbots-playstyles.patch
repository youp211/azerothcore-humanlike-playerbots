index 0000000..5ccce29
--- /dev/null
+++ b/src/Bot/Factory/PartyGuildFormation.cpp
@@ -0,0 +1,551 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#include "PartyGuildFormation.h"
+
+#include "Common.h"
+#include "Config.h"
+#include "DatabaseEnv.h"
+#include "Group.h"
+#include "GroupMgr.h"
+#include "GroupScript.h"
+#include "Guild.h"
+#include "GuildMgr.h"
+#include "Log.h"
+#include "ObjectAccessor.h"
+#include "Opcodes.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "PlayerbotGuildMgr.h"
+#include "PlayerbotMgr.h"
+#include "Random.h"
+#include "RandomPlayerbotFactory.h"
+#include "RandomPlayerbotMgr.h"
+#include "ScriptMgr.h"
+#include "StringFormat.h"
+#include "Timer.h"
+#include "WorldPacket.h"
+#include "WorldSession.h"
+
+#include <algorithm>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// Provided by mod-ollama-chat (same binary), weakly optional (null and the call
+// a no-op when the chat module is disabled). Same hooks PersonalityGuildFactory /
+// OngoingGuildRecruit use: a bot SAYS a short in-character line about a concrete
+// situation, and the founder's personality invents the applied guild name.
+[[gnu::weak]] void OllamaChat_SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper);
+[[gnu::weak]] void OllamaChat_RenameGuildInVoice(Player* leader, uint32 guildId, std::string const& archetype);
+
+namespace
+{
+    void SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper)
+    {
+        if (OllamaChat_SpeakSituation)
+            OllamaChat_SpeakSituation(bot, target, situation, whisper);
+    }
+
+    void RenameGuildInVoice(Player* leader, uint32 guildId, std::string const& archetype)
+    {
+        if (OllamaChat_RenameGuildInVoice)
+            OllamaChat_RenameGuildInVoice(leader, guildId, archetype);
+    }
+
+    // ---- Config (read live, same idiom as the sibling guild factories) -----
+    bool PgEnabled() { return sConfigMgr->GetOption<bool>("AiPlayerbot.PartyGuild.Enabled", true); }
+    uint32 PgMinMinutes() { return sConfigMgr->GetOption<uint32>("AiPlayerbot.PartyGuild.MinMinutes", 5); }
+    float PgBaseChance() { return sConfigMgr->GetOption<float>("AiPlayerbot.PartyGuild.BaseChance", 8.0f); }
+    float PgDeathPenalty() { return sConfigMgr->GetOption<float>("AiPlayerbot.PartyGuild.DeathPenalty", 6.0f); }
+    uint32 PgCheckIntervalSec() { return sConfigMgr->GetOption<uint32>("AiPlayerbot.PartyGuild.CheckIntervalSec", 120); }
+
+    // Outcome-adjusted formation chance: starts at BaseChance, reduced by
+    // DeathPenalty per death, floored at 0. A wipe drives it to 0.
+    float OutcomeChance(uint32 deaths)
+    {
+        float chance = PgBaseChance() - PgDeathPenalty() * float(deaths);
+        return chance < 0.0f ? 0.0f : chance;
+    }
+
+    using PersonalitySet = std::unordered_set<std::string>;
+
+    // Archetype leader sets - a verbatim mirror of PersonalityGuildFactory's
+    // (they live in that file's anonymous namespace), used only to derive the
+    // founder's archetype label for the in-voice guild rename.
+    PersonalitySet const RAID_LEADERS = {"HARDCORE_RAIDLEAD", "THEORYCRAFTER", "MIN_MAXER", "LORE_NERD"};
+    PersonalitySet const PVP_LEADERS  = {"ELITE_ARENA_PVPER", "PVP_TRASHTALKER", "DUELIST", "RAGER"};
+
+    char const* ArchetypeForPersonality(std::string const& personality)
+    {
+        if (RAID_LEADERS.count(personality))
+            return "raid";
+        if (PVP_LEADERS.count(personality))
+            return "pvp";
+        return "casual";
+    }
+
+    // How well a personality suits founding/leading a guild. The six named tiers
+    // come straight from the design; a spread of other recognised leader-ish
+    // personalities score lower; everything else scores 0 (no leader fit).
+    uint32 LeaderScore(std::string const& personality)
+    {
+        static std::unordered_map<std::string, uint32> const kScores = {
+            {"GUILD_RECRUITER", 100}, {"HEROIC_LEADER", 90}, {"HARDCORE_RAIDLEAD", 85},
+            {"MENTOR", 80},           {"WOW_MOM", 75},       {"ELITE_ARENA_PVPER", 70},
+            {"LFG_SPAMMER", 65},      {"CHILL_DAD", 60},     {"THEORYCRAFTER", 60},
+            {"JOLLY_BEER_LOVER", 55}, {"MIN_MAXER", 50},     {"LORE_NERD", 45},
+            {"DUELIST", 40},          {"PVP_TRASHTALKER", 40}, {"RAGER", 30},
+        };
+        auto it = kScores.find(personality);
+        return it != kScores.end() ? it->second : 0;
+    }
+
+    // guid -> mod-ollama-chat personality from the shared characters DB, guid-
+    // cached; empty results retried after 5 min. Mirrors OngoingGuildRecruit's
+    // GetPersonality exactly.
+    std::string GetPersonality(ObjectGuid guid)
+    {
+        static int hasTable = -1;
+        if (hasTable == -1)
+            hasTable = CharacterDatabase.Query(
+                          "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+                          "AND TABLE_NAME = 'mod_ollama_chat_personality'")
+                          ? 1
+                          : 0;
+        if (!hasTable)
+            return "";
+
+        ObjectGuid::LowType const low = guid.GetCounter();
+        uint32 const now = getMSTime();
+        static std::mutex cacheMutex;
+        static std::map<ObjectGuid::LowType, std::pair<std::string, uint32>> cache;
+        {
+            std::lock_guard<std::mutex> lock(cacheMutex);
+            auto it = cache.find(low);
+            if (it != cache.end() &&
+                (!it->second.first.empty() || now - it->second.second < 5 * MINUTE * IN_MILLISECONDS))
+                return it->second.first;
+        }
+
+        std::string personality;
+        if (QueryResult result = CharacterDatabase.Query(
+                "SELECT personality FROM mod_ollama_chat_personality WHERE guid = {}", low))
+            personality = (*result)[0].Get<std::string>();
+
+        std::lock_guard<std::mutex> lock(cacheMutex);
+        cache[low] = {personality, now};
+        return personality;
+    }
+
+    bool IsBotMember(Player* member) { return sPlayerbotsMgr.GetPlayerbotAI(member) != nullptr; }
+
+    // The online members of a group, resolved to live Player pointers (offline
+    // slots skipped). Used for qualification, founder pick, death routing.
+    std::vector<Player*> OnlineMembers(Group* group)
+    {
+        std::vector<Player*> members;
+        if (!group)
+            return members;
+        for (auto const& slot : group->GetMemberSlots())
+            if (Player* p = ObjectAccessor::FindPlayer(slot.guid))
+                members.push_back(p);
+        return members;
+    }
+
+    // A "party" = a group with a non-bot player member AND at least one random
+    // bot member. (Both evaluated over the currently-online members.)
+    bool PartyQualifies(Group* group)
+    {
+        bool hasRealPlayer = false;
+        bool hasRandomBot = false;
+        for (Player* member : OnlineMembers(group))
+        {
+            if (!IsBotMember(member))
+                hasRealPlayer = true;
+            else if (sRandomPlayerbotMgr.IsRandomBot(member))
+                hasRandomBot = true;
+        }
+        return hasRealPlayer && hasRandomBot;
+    }
+
+    // Queue a CMSG_GUILD_INVITE on the founder's session for `target` - exactly
+    // OngoingGuildRecruit::SendGuildInvite / GuildRecruitmentEvent::SendGuildInvite.
+    // A BOT target's own "guild invite" handler auto-accepts; a real player gets
+    // the dialog and chooses.
+    void SendGuildInvite(Player* founder, Player* target)
+    {
+        WorldSession* session = founder->GetSession();
+        if (!session)
+            return;
+
+        WorldPacket* data = new WorldPacket(CMSG_GUILD_INVITE);
+        *data << target->GetName();
+        session->QueuePacket(data);
+    }
+}  // namespace
+
+PartyGuildFormation& PartyGuildFormation::instance()
+{
+    static PartyGuildFormation instance;
+    return instance;
+}
+
+void PartyGuildFormation::OnPartyChanged(Group* group)
+{
+    if (!PgEnabled() || !group)
+        return;
+
+    ObjectGuid const key = group->GetGUID();
+    bool const qualifies = PartyQualifies(group);
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _parties.find(key);
+    if (qualifies)
+    {
+        if (it == _parties.end())
+        {
+            PartyState state;
+            state.startMs = getMSTime();
+            _parties.emplace(key, state);  // fresh party - start its clock
+        }
+        // Already tracked: keep the original start time / counters.
+    }
+    else if (it != _parties.end() && !it->second.formed)
+    {
+        _parties.erase(it);  // stopped qualifying before it formed - forget it
+    }
+}
+
+void PartyGuildFormation::OnPartyDisband(ObjectGuid groupGuid)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    _parties.erase(groupGuid);
+}
+
+void PartyGuildFormation::OnMemberDeath(Player* member)
+{
+    if (!PgEnabled() || !member)
+        return;
+
+    Group* group = member->GetGroup();
+    if (!group)
+        return;
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _parties.find(group->GetGUID());
+    if (it != _parties.end() && !it->second.formed)
+        ++it->second.deaths;
+}
+
+void PartyGuildFormation::OnMemberQuestComplete(Player* member)
+{
+    if (!PgEnabled() || !member)
+        return;
+
+    Group* group = member->GetGroup();
+    if (!group)
+        return;
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _parties.find(group->GetGUID());
+    if (it != _parties.end() && !it->second.formed)
+        ++it->second.questCompletions;
+}
+
+void PartyGuildFormation::Update(uint32 diff)
+{
+    if (!PgEnabled())
+        return;
+
+    uint32 const intervalMs = PgCheckIntervalSec() * IN_MILLISECONDS;
+    if (intervalMs == 0)
+        return;
+
+    _accumMs += diff;
+    if (_accumMs < intervalMs)
+        return;
+    _accumMs = 0;
+
+    uint32 const minMs = PgMinMinutes() * MINUTE * IN_MILLISECONDS;
+    uint32 const now = getMSTime();
+
+    // Snapshot the groups that pass the gate + random roll under the lock, then
+    // do the (heavier) forming outside it. Also reap entries whose group is gone.
+    std::vector<ObjectGuid> toForm;
+    std::vector<ObjectGuid> toErase;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        for (auto const& kv : _parties)
+        {
+            if (kv.second.formed)
+                continue;
+
+            Group* group = sGroupMgr->GetGroupByGUID(kv.first.GetCounter());
+            if (!group)
+            {
+                toErase.push_back(kv.first);
+                continue;
+            }
+            if (now - kv.second.startMs < minMs)
+                continue;
+
+            if (roll_chance_f(OutcomeChance(kv.second.deaths)))
+                toForm.push_back(kv.first);
+        }
+        for (ObjectGuid const& guid : toErase)
+            _parties.erase(guid);
+    }
+
+    for (ObjectGuid const& guid : toForm)
+        if (Group* group = sGroupMgr->GetGroupByGUID(guid.GetCounter()))
+            TryForm(group, /*playerInitiated=*/false);
+}
+
+void PartyGuildFormation::OnPlayerRequest(Player* player)
+{
+    if (!PgEnabled() || !player)
+        return;
+
+    Group* group = player->GetGroup();
+    if (!group)
+        return;
+
+    // Only act if this group is a tracked qualifying party (has bots to answer).
+    uint32 deaths = 0;
+    uint32 startMs = 0;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto it = _parties.find(group->GetGUID());
+        if (it == _parties.end() || it->second.formed)
+            return;
+        deaths = it->second.deaths;
+        startMs = it->second.startMs;
+    }
+
+    uint32 const minMs = PgMinMinutes() * MINUTE * IN_MILLISECONDS;
+    bool const oldEnough = (getMSTime() - startMs) >= minMs;
+    bool const notWiped = OutcomeChance(deaths) > 0.0f;
+
+    // Initiation bypasses the random roll but keeps the >= MinMinutes + not-wiped
+    // gate. If it passes, form now; otherwise a party bot declines in-voice.
+    if (oldEnough && notWiped)
+    {
+        TryForm(group, /*playerInitiated=*/true);
+        return;
+    }
+
+    // Pick a random bot member to voice the decline.
+    Player* speaker = nullptr;
+    for (Player* member : OnlineMembers(group))
+    {
+        if (IsBotMember(member))
+        {
+            speaker = member;
+            break;
+        }
+    }
+    if (!speaker)
+        return;
+
+    if (!oldEnough)
+        SpeakSituation(speaker, nullptr,
+                       "a groupmate suggested your party form a guild, but you've only just met - gently say give it "
+                       "time",
+                       false);
+    else  // wiped
+        SpeakSituation(speaker, nullptr,
+                       "a groupmate suggested your party form a guild right after a rough run full of deaths - say "
+                       "maybe later",
+                       false);
+}
+
+bool PartyGuildFormation::TryForm(Group* group, bool playerInitiated)
+{
+    if (!group)
+        return false;
+
+    ObjectGuid const key = group->GetGUID();
+
+    // Claim the party (guard against double-create) and read its death count.
+    uint32 deaths = 0;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto it = _parties.find(key);
+        if (it == _parties.end() || it->second.formed)
+            return false;
+        deaths = it->second.deaths;
+        it->second.formed = true;  // world-thread only, but claim before we build
+    }
+
+    auto unclaim = [&]()
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        auto it = _parties.find(key);
+        if (it != _parties.end())
+            it->second.formed = false;
+    };
+
+    std::vector<Player*> const members = OnlineMembers(group);
+
+    // INVARIANT: don't form if the crew is already guilded together (the real
+    // player and any bot already share a guild).
+    Player* realPlayer = nullptr;
+    for (Player* member : members)
+        if (!IsBotMember(member))
+        {
+            realPlayer = member;
+            break;
+        }
+    if (realPlayer && realPlayer->GetGuildId())
+    {
+        for (Player* member : members)
+            if (member != realPlayer && member->GetGuildId() == realPlayer->GetGuildId())
+            {
+                unclaim();
+                return false;  // already in one guild together
+            }
+    }
+
+    // FOUNDER = the best guild-leader personality among the GUILDLESS bot members
+    // (a founder must be guildless or CreateGuild fails). Best score wins; if none
+    // scores, the top guildless bot still founds - it's the player's chosen crew.
+    Player* founder = nullptr;
+    uint32 bestScore = 0;
+    std::string founderPersonality;
+    for (Player* member : members)
+    {
+        if (!IsBotMember(member) || member->GetGuildId())
+            continue;
+
+        std::string const personality = GetPersonality(member->GetGUID());
+        uint32 const score = LeaderScore(personality);
+        if (!founder || score > bestScore)
+        {
+            founder = member;
+            bestScore = score;
+            founderPersonality = personality;
+        }
+    }
+    if (!founder)
+    {
+        unclaim();
+        return false;  // no guildless bot to found the guild
+    }
+
+    // Start with a random unused pool name; the founder's LLM voice renames it.
+    std::string const initialName = RandomPlayerbotFactory::CreateRandomGuildName();
+    if (initialName.empty() || !PlayerbotGuildMgr::instance().CreateGuild(founder, initialName))
+    {
+        LOG_ERROR("playerbots", "[PartyGuild] failed to create guild (founder {})", founder->GetName());
+        unclaim();
+        return false;
+    }
+
+    Guild* guild = sGuildMgr->GetGuildByName(initialName);
+    if (!guild)
+    {
+        unclaim();
+        return false;
+    }
+
+    // Suggest names in party chat first (1-2 bots) so the player sees ideas; the
+    // founder's async LLM rename is the one actually applied.
+    uint32 suggested = 0;
+    for (Player* member : members)
+    {
+        if (suggested >= 2)
+            break;
+        if (member == founder || !IsBotMember(member))
+            continue;
+        SpeakSituation(member, nullptr,
+                       "your party had a great run together and is forming a guild - suggest a cool guild name", false);
+        ++suggested;
+    }
+
+    // Invite EVERY other party member: bots (auto-accept) and the real player
+    // (their choice). Intentional elite-purity exception - this is the player's
+    // chosen crew, so invite regardless of personality fit.
+    for (Player* member : members)
+    {
+        if (member == founder)
+            continue;
+        if (member->GetGuildId())
+            continue;  // already guilded elsewhere - can't join a second
+        SendGuildInvite(founder, member);
+    }
+
+    PlayerbotGuildMgr::instance().OnGuildUpdate(guild);
+
+    // Founder's personality invents + applies the real guild name (async).
+    RenameGuildInVoice(founder, guild->GetId(), ArchetypeForPersonality(founderPersonality));
+
+    LOG_INFO("playerbots", "[PartyGuild] party of {} formed guild (founder {} {}, {} deaths, {})", members.size(),
+             founder->GetName(), founderPersonality.empty() ? "no-personality" : founderPersonality, deaths,
+             playerInitiated ? "player-initiated" : "spontaneous");
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Weak-symbol entry point for mod-ollama-chat's party-chat "let's guild up"
+// intent. Plain global (external linkage) so the module's `[[gnu::weak]]` extern
+// binds to it. World thread (called synchronously from the chat handler).
+// ---------------------------------------------------------------------------
+void PartyGuild_OnPlayerRequest(Player* player)
+{
+    PartyGuildFormation::instance().OnPlayerRequest(player);
+}
+
+// ---------------------------------------------------------------------------
+// Scripts that feed the singleton. GroupScript membership changes maintain the
+// party registry; the PlayerScript counts member deaths / quest completions.
+// Empty enabled-hook lists (all hooks on) mirror mod-ollama-chat's SentimentOnGroup
+// GroupScript and ChatOnDeath PlayerScript, which use the same OnAddMember /
+// OnPlayerJustDied hooks in this fork.
+// ---------------------------------------------------------------------------
+class PartyGuildGroupScript : public GroupScript
+{
+public:
+    PartyGuildGroupScript() : GroupScript("PartyGuildGroupScript") {}
+
+    void OnCreate(Group* group, Player* /*leader*/) override { PartyGuildFormation::instance().OnPartyChanged(group); }
+
+    void OnAddMember(Group* group, ObjectGuid /*guid*/) override
+    {
+        PartyGuildFormation::instance().OnPartyChanged(group);
+    }
+
+    void OnRemoveMember(Group* group, ObjectGuid /*guid*/, RemoveMethod /*method*/, ObjectGuid /*kicker*/,
+                        char const* /*reason*/) override
+    {
+        PartyGuildFormation::instance().OnPartyChanged(group);
+    }
+
+    void OnDisband(Group* group) override
+    {
+        if (group)
+            PartyGuildFormation::instance().OnPartyDisband(group->GetGUID());
+    }
+};
+
+class PartyGuildPlayerScript : public PlayerScript
+{
+public:
+    PartyGuildPlayerScript() : PlayerScript("PartyGuildPlayerScript") {}
+
+    void OnPlayerJustDied(Player* player) override { PartyGuildFormation::instance().OnMemberDeath(player); }
+
+    void OnPlayerCompleteQuest(Player* player, Quest const* /*quest*/) override
+    {
+        PartyGuildFormation::instance().OnMemberQuestComplete(player);
+    }
+};
+
+void AddSC_PartyGuildFormation()
+{
+    new PartyGuildGroupScript();
+    new PartyGuildPlayerScript();
+}
diff --git a/src/Bot/Factory/PartyGuildFormation.h b/src/Bot/Factory/PartyGuildFormation.h
new file mode 100644
index 0000000..1069007
--- /dev/null
+++ b/src/Bot/Factory/PartyGuildFormation.h
@@ -0,0 +1,90 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_PARTYGUILDFORMATION_H
+#define PLAYERBOTS_PARTYGUILDFORMATION_H
+
+#include "ObjectGuid.h"
+
+#include <map>
+#include <mutex>
+
+class Group;
+class Player;
+
+// Emergent PARTY -> GUILD formation.
+//
+// Every GROUP that contains the real player and at least one random bot (a
+// "party") is tracked from the moment it qualifies: its start time and the
+// number of member deaths during its life (quest completions too, for flavor).
+// When such a party has been alive long enough and the run went WELL, it can
+// spontaneously become a guild founded by its most leader-suited bot, which
+// then invites the whole crew (bots auto-accept; the real player chooses).
+//
+// Two trigger paths:
+//   (1) SPONTANEOUS - a periodic world-thread tick rolls an outcome-adjusted
+//       chance (starts at PartyGuild.BaseChance, minus PartyGuild.DeathPenalty
+//       per death); a clean, long-lived party is far likelier than a wiped one.
+//   (2) PLAYER-INITIATED - the real player says a "let's guild up" line in party
+//       chat; mod-ollama-chat routes it here via the weak PartyGuild_OnPlayerRequest
+//       symbol. Initiation bypasses the random roll but still requires the
+//       >= MinMinutes + not-wiped gate; otherwise a party bot answers in-voice.
+//
+// All state lives in a single world-thread-driven singleton. The GroupScript
+// and PlayerScript that feed it are registered from AddPlayerbotsScripts().
+class PartyGuildFormation
+{
+public:
+    static PartyGuildFormation& instance();
+
+    // --- GroupScript feed (world thread) ---------------------------------
+    // Re-evaluate a group's membership: register it the moment it becomes a
+    // qualifying party, or drop an un-formed entry that stopped qualifying.
+    void OnPartyChanged(Group* group);
+    // Forget a disbanded group entirely (clears any registry state).
+    void OnPartyDisband(ObjectGuid groupGuid);
+
+    // --- PlayerScript feed (world thread) --------------------------------
+    // Count a member death against the party the dead member belongs to.
+    void OnMemberDeath(Player* member);
+    // Count a member quest completion (flavor only; not used in the odds).
+    void OnMemberQuestComplete(Player* member);
+
+    // --- Drivers ----------------------------------------------------------
+    // World-thread spontaneous tick; call every world update.
+    void Update(uint32 diff);
+    // Player-initiated path (invoked from mod-ollama-chat's party-chat intent).
+    void OnPlayerRequest(Player* player);
+
+private:
+    PartyGuildFormation() = default;
+
+    struct PartyState
+    {
+        uint32 startMs = 0;            // getMSTime() when the party first qualified
+        uint32 deaths = 0;             // member deaths during the party's life
+        uint32 questCompletions = 0;   // member quest completions (flavor)
+        bool formed = false;           // guard against double-forming one group
+    };
+
+    // Attempt to actually found the guild for `group` (founder pick + create +
+    // invites + async name). Returns true on success; sets the party formed.
+    bool TryForm(Group* group, bool playerInitiated);
+
+    std::mutex _mutex;                            // sibling-consistent guard
+    std::map<ObjectGuid, PartyState> _parties;    // group GUID -> tracked state
+    uint32 _accumMs = 0;                          // spontaneous-tick accumulator
+};
+
+// Plain global (external linkage) so mod-ollama-chat's `[[gnu::weak]]` extern
+// binds to it in the same binary. Routes a real player's party-chat "let's
+// guild up" line to the player-initiated formation path.
+void PartyGuild_OnPlayerRequest(Player* player);
+
+// Registration entry (AddSC-style). Registers the GroupScript + PlayerScript
+// that feed the singleton; call from AddPlayerbotsScripts().
+void AddSC_PartyGuildFormation();
+
+#endif
diff --git a/src/Bot/Factory/PersonalityGuildFactory.cpp b/src/Bot/Factory/PersonalityGuildFactory.cpp
new file mode 100644
index 0000000..366bd35
--- /dev/null
+++ b/src/Bot/Factory/PersonalityGuildFactory.cpp
@@ -0,0 +1,380 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#include "PersonalityGuildFactory.h"
+
+#include "Common.h"
+#include "Config.h"
+#include "DatabaseEnv.h"
+#include "Guild.h"
+#include "GuildMgr.h"
+#include "Log.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "PlayerbotAIConfig.h"
+#include "PlayerbotGuildMgr.h"
+#include "Random.h"
+#include "RandomPlayerbotFactory.h"
+#include "RandomPlayerbotMgr.h"
+#include "StringFormat.h"
+
+#include <algorithm>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// Provided by mod-ollama-chat (same binary): right after a personality guild is
+// formed, have the bot LEADER's personality invent a better guild name via the
+// local LLM and rename the guild asynchronously. Weakly optional - if the chat
+// module is disabled the call is a no-op stub below.
+[[gnu::weak]] void OllamaChat_RenameGuildInVoice(Player* leader, uint32 guildId, std::string const& archetype);
+static void SpeakGuildName(Player* leader, uint32 guildId, std::string const& archetype)
+{
+    if (OllamaChat_RenameGuildInVoice)
+        OllamaChat_RenameGuildInVoice(leader, guildId, archetype);
+}
+
+namespace
+{
+    enum class GuildArchetype : uint8
+    {
+        Raid = 0,
+        Pvp,
+        Casual
+    };
+
+    char const* ArchetypeName(GuildArchetype archetype)
+    {
+        switch (archetype)
+        {
+            case GuildArchetype::Raid:
+                return "raid";
+            case GuildArchetype::Pvp:
+                return "pvp";
+            default:
+                return "casual";
+        }
+    }
+
+    using PersonalitySet = std::unordered_set<std::string>;
+
+    // --- Leader personalities: a guild's GM must be one of these ------------
+    PersonalitySet const RAID_LEADERS   = {"HARDCORE_RAIDLEAD", "THEORYCRAFTER", "MIN_MAXER", "LORE_NERD"};
+    PersonalitySet const PVP_LEADERS    = {"ELITE_ARENA_PVPER", "PVP_TRASHTALKER", "DUELIST", "RAGER"};
+    PersonalitySet const CASUAL_LEADERS = {"WOW_MOM",     "MENTOR",           "GUILD_RECRUITER",
+                                           "CHILL_DAD",   "JOLLY_BEER_LOVER", "HEROIC_LEADER"};
+
+    // --- Elite membership fit-sets: fit is REQUIRED, no randomness ----------
+    // Leader personalities are unioned in so a leader always fits its own guild.
+    PersonalitySet const RAID_FIT = {"RAIDER",     "THEORYCRAFTER",      "MIN_MAXER",   "HARDCORE_RAIDLEAD",
+                                     "HEALER_MAIN", "SPEEDRUNNER",       "ACHIEVEMENT_HUNTER", "LORE_NERD"};
+    PersonalitySet const PVP_FIT  = {"PVP_HARDCORE", "PVP_TRASHTALKER", "DUELIST",
+                                     "ELITE_ARENA_PVPER", "RAGER", "EDGE_LORD"};
+
+    struct Candidate
+    {
+        ObjectGuid guid;
+        uint32 lowGuid = 0;
+        uint32 level = 0;
+        uint8 team = 0;  // TeamId
+        std::string personality;
+    };
+
+    // Bulk-load guid -> personality from the shared characters DB (one query).
+    void LoadPersonalities(std::unordered_map<uint32, std::string>& out)
+    {
+        QueryResult result = CharacterDatabase.Query("SELECT guid, personality FROM mod_ollama_chat_personality");
+        if (!result)
+            return;
+
+        do
+        {
+            Field* fields = result->Fetch();
+            out[fields[0].Get<uint32>()] = fields[1].Get<std::string>();
+        } while (result->NextRow());
+    }
+
+    // Build the working set: currently-online, guildless random bots, tagged
+    // with level / faction / personality. Mirrors the random-bot pool query
+    // used by RandomPlayerbotFactory::CreateRandomArenaTeams.
+    void LoadOnlineGuildlessBots(std::vector<Candidate>& out,
+                                 std::unordered_map<uint32, std::string> const& personalities)
+    {
+        PlayerbotsDatabasePreparedStatement* stmt =
+            PlayerbotsDatabase.GetPreparedStatement(PLAYERBOTS_SEL_RANDOM_BOTS_BOT);
+        stmt->SetData(0, "add");
+        PreparedQueryResult result = PlayerbotsDatabase.Query(stmt);
+        if (!result)
+            return;
+
+        do
+        {
+            Field* fields = result->Fetch();
+            uint32 lowGuid = fields[0].Get<uint32>();
+            ObjectGuid guid = ObjectGuid::Create<HighGuid::Player>(lowGuid);
+
+            Player* bot = ObjectAccessor::FindConnectedPlayer(guid);
+            if (!bot || bot->GetGuildId())
+                continue;
+
+            Candidate candidate;
+            candidate.guid = guid;
+            candidate.lowGuid = lowGuid;
+            candidate.level = bot->GetLevel();
+            candidate.team = bot->GetTeamId();
+            auto it = personalities.find(lowGuid);
+            candidate.personality = (it != personalities.end()) ? it->second : "";
+            out.push_back(std::move(candidate));
+        } while (result->NextRow());
+    }
+
+    // Small themed-name generator. Falls back to the module's unused-name pool
+    // (playerbots_guild_names) if it cannot mint a short, unique themed name.
+    std::string MakeThemedName(GuildArchetype archetype)
+    {
+        static std::vector<std::string> const raidPrefix   = {"Wrath",   "Nightfall", "Ascended", "Molten",
+                                                              "Ruin",    "Vengeance", "Eternal",  "Heroic"};
+        static std::vector<std::string> const raidSuffix   = {"Legion",     "Covenant", "Vanguard",
+                                                              "Dominion",   "Ascendancy", "Reckoning"};
+        static std::vector<std::string> const pvpPrefix    = {"Savage",  "Bloodthirst", "Rampage", "Cutthroat",
+                                                              "Feral",   "Merciless",   "Brutal"};
+        static std::vector<std::string> const pvpSuffix    = {"Warband",  "Marauders", "Onslaught",
+                                                              "Gladiators", "Reavers", "Bloodbath"};
+        static std::vector<std::string> const casualPrefix = {"Cozy",   "Chill",    "Sunday",   "Friendly",
+                                                              "Hearth", "Campfire", "Merry"};
+        static std::vector<std::string> const casualSuffix = {"Questers", "Wanderers", "Crew",
+                                                              "Company",  "Friends",   "Adventurers"};
+
+        std::vector<std::string> const* prefix = &casualPrefix;
+        std::vector<std::string> const* suffix = &casualSuffix;
+        switch (archetype)
+        {
+            case GuildArchetype::Raid:
+                prefix = &raidPrefix;
+                suffix = &raidSuffix;
+                break;
+            case GuildArchetype::Pvp:
+                prefix = &pvpPrefix;
+                suffix = &pvpSuffix;
+                break;
+            default:
+                break;
+        }
+
+        for (uint32 attempt = 0; attempt < 20; ++attempt)
+        {
+            std::string name = Acore::StringFormat("{} {}", (*prefix)[urand(0, prefix->size() - 1)],
+                                                   (*suffix)[urand(0, suffix->size() - 1)]);
+            if (name.size() > 24)  // WoW guild-name limit
+                continue;
+            if (!sGuildMgr->GetGuildByName(name))
+                return name;
+        }
+
+        return RandomPlayerbotFactory::CreateRandomGuildName();
+    }
+}  // namespace
+
+void PersonalityGuildFactory::FormPersonalityGuilds()
+{
+    // Seed the world with a few guilds at startup; the rest emerge gradually via
+    // UpdateEmergentFounding + the ongoing recruiter. Runs at most once per process.
+    static bool seeded = false;
+    if (seeded)
+        return;
+    seeded = true;
+
+    uint32 const seedCount = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.SeedCount", 2);
+
+    uint32 formed = 0;
+    for (uint32 i = 0; i < seedCount; ++i)
+        if (TryFoundOneGuild())
+            ++formed;
+
+    LOG_INFO("playerbots", "[PersonalityGuild] Seeded {} of {} initial guilds; the rest form over time", formed,
+             seedCount);
+}
+
+bool PersonalityGuildFactory::TryFoundOneGuild()
+{
+    uint32 const raidCount = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.RaidCount", 4);
+    uint32 const pvpCount = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.PvpCount", 3);
+    uint32 const casualCount = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.CasualCount", 8);
+    uint32 const leaderMinLevel = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.LeaderMinLevel", 10);
+    float const casualJoinChance = sConfigMgr->GetOption<float>("AiPlayerbot.PersonalityGuild.CasualJoinChance", 40.0f);
+    uint32 const maxMembers = std::max<uint32>(2, sPlayerbotAIConfig.randomBotGuildSizeMax);
+    uint32 const foundInitial = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.FoundInitialMembers", 4);
+    uint32 const initialCap = std::min(std::max<uint32>(1, foundInitial), maxMembers);
+
+    // Fresh snapshot of the CURRENT online, guildless random bots + personalities
+    // (self-contained, like OngoingGuildRecruit::Tick - no captured batch state).
+    std::unordered_map<uint32, std::string> personalities;
+    LoadPersonalities(personalities);
+
+    std::vector<Candidate> pool;
+    LoadOnlineGuildlessBots(pool, personalities);
+    if (pool.empty())
+        return false;
+
+    // Archetype preference weighted by the configured Raid:Pvp:Casual mix (defaults
+    // ~1:1:2). Build a fallback order so the tick still founds something when the
+    // primary archetype has no eligible leader online right now.
+    uint32 weights[3] = {raidCount, pvpCount, casualCount};
+    uint32 total = weights[0] + weights[1] + weights[2];
+    if (total == 0)
+    {
+        weights[0] = 1;
+        weights[1] = 1;
+        weights[2] = 2;
+        total = 4;
+    }
+
+    uint32 roll = urand(0, total - 1);
+    uint32 primary = 0;
+    for (; primary < 2; ++primary)  // last bucket (casual) is the default remainder
+    {
+        if (roll < weights[primary])
+            break;
+        roll -= weights[primary];
+    }
+
+    GuildArchetype const archetypes[3] = {GuildArchetype::Raid, GuildArchetype::Pvp, GuildArchetype::Casual};
+    std::vector<GuildArchetype> order;
+    order.push_back(archetypes[primary]);
+    for (uint32 i = 0; i < 3; ++i)
+        if (i != primary)
+            order.push_back(archetypes[i]);
+
+    for (GuildArchetype const archetype : order)
+    {
+        PersonalitySet const* leaderSet = &CASUAL_LEADERS;
+        PersonalitySet const* fitSet = nullptr;  // casual: any personality fits
+        switch (archetype)
+        {
+            case GuildArchetype::Raid:
+                leaderSet = &RAID_LEADERS;
+                fitSet = &RAID_FIT;
+                break;
+            case GuildArchetype::Pvp:
+                leaderSet = &PVP_LEADERS;
+                fitSet = &PVP_FIT;
+                break;
+            default:
+                break;
+        }
+        bool const casual = (fitSet == nullptr);
+
+        // Find an eligible ONLINE guildless leader whose personality fits this
+        // archetype's leader set and meets the minimum level.
+        Candidate leader;
+        Player* leaderPlayer = nullptr;
+        for (Candidate const& candidate : pool)
+        {
+            if (candidate.level < leaderMinLevel || !leaderSet->count(candidate.personality))
+                continue;
+
+            Player* player = ObjectAccessor::FindConnectedPlayer(candidate.guid);
+            if (!player || player->GetGuildId())
+                continue;
+
+            leader = candidate;
+            leaderPlayer = player;
+            break;
+        }
+        if (!leaderPlayer)
+            continue;  // no eligible leader for this archetype - try the next
+
+        std::string name = MakeThemedName(archetype);
+        if (name.empty())
+            continue;
+
+        if (!PlayerbotGuildMgr::instance().CreateGuild(leaderPlayer, name))
+        {
+            LOG_ERROR("playerbots", "[EmergentGuild] Failed to create {} guild '{}' led by {}",
+                      ArchetypeName(archetype), name, leaderPlayer->GetName());
+            continue;
+        }
+
+        // Seed a SMALL guild (headroom stays for the ongoing recruiter to grow it
+        // and for the real player to join). Never exceed maxMembers. Elite: strictly
+        // fit-set, same faction. Casual: any same-faction bot, admitted with chance.
+        uint32 memberCount = 1;  // leader
+        Guild* guild = sGuildMgr->GetGuildByName(name);
+        if (guild)
+        {
+            std::unordered_set<uint32> committed;
+            committed.insert(leader.lowGuid);
+            for (Candidate const& candidate : pool)
+            {
+                if (memberCount >= initialCap)
+                    break;
+                if (committed.count(candidate.lowGuid) || candidate.team != leader.team)
+                    continue;
+                if (casual)
+                {
+                    if (!roll_chance_f(casualJoinChance))  // randomness: anyone may roll in
+                        continue;
+                }
+                else if (!fitSet->count(candidate.personality))
+                {
+                    continue;  // elite purity: fit-set only
+                }
+
+                Player* member = ObjectAccessor::FindConnectedPlayer(candidate.guid);
+                if (!member || member->GetGuildId())
+                {
+                    committed.insert(candidate.lowGuid);
+                    continue;
+                }
+
+                if (guild->AddMember(candidate.guid, uint8(urand(GR_OFFICER, GR_INITIATE))))
+                {
+                    committed.insert(candidate.lowGuid);
+                    ++memberCount;
+                }
+            }
+            PlayerbotGuildMgr::instance().OnGuildUpdate(guild);
+            SpeakGuildName(leaderPlayer, guild->GetId(), ArchetypeName(archetype));
+        }
+
+        LOG_INFO("playerbots", "[EmergentGuild] founded {} guild '{}' led by {} ({})", ArchetypeName(archetype), name,
+                 leaderPlayer->GetName(), leader.personality);
+        return true;
+    }
+
+    return false;
+}
+
+void PersonalityGuildFactory::UpdateEmergentFounding(uint32 diff)
+{
+    uint32 const intervalMs =
+        sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.FoundIntervalSec", 300) * IN_MILLISECONDS;
+    if (intervalMs == 0)
+        return;
+
+    // World-thread only (PlayerbotsWorldScript::OnUpdate) - a plain static suffices.
+    static uint32 accumMs = 0;
+    accumMs += diff;
+    if (accumMs < intervalMs)
+        return;
+    accumMs = 0;
+
+    uint32 const targetCount = sConfigMgr->GetOption<uint32>("AiPlayerbot.PersonalityGuild.TargetCount", 12);
+
+    // Count distinct random-bot guilds (every guild an online random bot belongs
+    // to). Cheap, and mirrors the ongoing recruiter's bot-pool walk.
+    std::unordered_set<uint32> guildIds;
+    for (auto const& kv : sRandomPlayerbotMgr.GetAllBots())
+    {
+        Player* bot = kv.second;
+        if (bot && bot->GetGuildId())
+            guildIds.insert(bot->GetGuildId());
+    }
+    if (guildIds.size() >= targetCount)
+        return;
+
+    TryFoundOneGuild();
+}
