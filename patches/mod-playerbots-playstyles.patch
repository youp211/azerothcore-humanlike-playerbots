+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_DUNGEONCOMPANIONS_H
+#define PLAYERBOTS_DUNGEONCOMPANIONS_H
+
+#include "ObjectGuid.h"
+
+#include <map>
+#include <mutex>
+#include <set>
+#include <unordered_set>
+#include <vector>
+
+class Group;
+class Player;
+
+// Dungeon autofill + experience-based companion persistence.
+//
+// AUTOFILL (AiPlayerbot.DungeonAutofill.*)
+//   A world-thread tick keeps every real player's dungeon-finder queue fed with
+//   role/level-appropriate random bots, so a queued dungeon ALWAYS fills instead
+//   of waiting for the vanilla matchmaker to happen to have the right bots queued.
+//   It reuses the exact CMSG_LFG_JOIN mechanism the module's LfgJoinAction uses
+//   (queue a bot for the player's selected dungeons with a chosen role); the core
+//   LFG matcher then forms the group. Self-healing: if a tick doesn't form the
+//   group it simply re-evaluates and tops the queue up again next tick.
+//
+// PERSISTENCE (AiPlayerbot.DungeonCompanion.*)
+//   Every dungeon RUN - a group holding a real player and >= 1 random bot that
+//   actually zones into an instance - is tracked. When the run ends (the player
+//   leaves / the group disbands), each participating random bot is judged by its
+//   live mod-ollama-chat sentiment toward the player, after a run-outcome nudge
+//   (a clean completed run raises it, deaths lower it):
+//     - GOOD experience  (sentiment >= GoodThreshold)  -> saved as a "friend"
+//     - very BAD          (sentiment <= TrollThreshold) -> saved as a "troll"
+//     - NEUTRAL in between                              -> NOT saved; the bot
+//       stays a throwaway random-pool bot (instance-only, re-randomised as usual)
+//   Saved companions are persisted to acore_characters.mod_playerbots_companions
+//   and excluded from the random-bot RE-RANDOMISE churn in RandomPlayerbotMgr, so
+//   they keep their name/level/gear identity and can be run into again out in the
+//   world - the memorable ones (loved OR hated) stick around; the forgettable
+//   ones don't.
+//
+// All state lives in a single world-thread-driven singleton. The GroupScript and
+// PlayerScript that feed it are registered from AddPlayerbotsScripts().
+class DungeonCompanions
+{
+public:
+    static DungeonCompanions& instance();
+
+    enum Disposition : uint8
+    {
+        DISPOSITION_FRIEND = 1,
+        DISPOSITION_TROLL  = 2,
+    };
+
+    // Load persisted companion guids once (lazy, on the first world tick).
+    void EnsureLoaded();
+
+    // True if this bot (low guid) is a saved companion. RandomPlayerbotMgr calls
+    // this to skip re-randomising the bot so its identity is preserved. O(log n),
+    // lock-guarded; safe to call from the world thread every process pass.
+    bool IsCompanion(ObjectGuid::LowType botLow);
+
+    // --- GroupScript feed (world thread) ---------------------------------
+    // (Re)register a group the moment it becomes a qualifying dungeon party;
+    // resolve + drop it once it stops qualifying (player left / bots all gone).
+    void OnPartyChanged(Group* group);
+    // Resolve + forget a disbanded group entirely.
+    void OnPartyDisband(ObjectGuid groupGuid);
+
+    // --- PlayerScript feed (world thread) --------------------------------
+    // Count a member death against the run the dead member belongs to.
+    void OnMemberDeath(Player* member);
+
+    // --- Driver -----------------------------------------------------------
+    // World-thread tick: autofill queued players + resolve finished/stale runs.
+    void Update(uint32 diff);
+
+private:
+    DungeonCompanions() = default;
+
+    struct RunState
+    {
+        ObjectGuid playerGuid;              // the real player the run belongs to
+        std::set<ObjectGuid> botGuids;      // every random bot ever seen in the run
+        uint32 startMs = 0;                 // getMSTime() when the run first qualified
+        uint32 deaths = 0;                  // member deaths during the run
+        bool entered = false;               // group actually zoned into an instance
+        bool resolved = false;              // classification already done
+    };
+
+    // Autofill: top up every queued real player's dungeon with random bots.
+    void AutofillTick();
+    // Resolve runs whose group is gone (completion / disband we didn't catch).
+    void ResolveStaleRuns();
+    // Judge each bot in a finished run and persist the memorable ones.
+    void ResolveRun(RunState& run);
+    void SaveCompanion(Player* bot, Player* player, uint8 disposition, float sentiment);
+
+    std::mutex _mutex;
+    std::map<ObjectGuid, RunState> _runs;             // group GUID -> tracked run
+    std::vector<RunState> _pendingResolve;            // runs whose group ended, awaiting resolve
+    std::set<ObjectGuid::LowType> _companions;        // saved companion low-guids
+    std::map<ObjectGuid::LowType, uint32> _lastFill;  // player low-guid -> last autofill ms
+    uint32 _autofillAccumMs = 0;
+    uint32 _resolveAccumMs = 0;
+    bool _loaded = false;
+};
+
+// Registration entry (AddSC-style): the GroupScript + PlayerScript feeds. Call
+// from AddPlayerbotsScripts().
+void AddSC_DungeonCompanions();
+
+#endif
