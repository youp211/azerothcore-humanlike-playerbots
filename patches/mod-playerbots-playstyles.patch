+    // Resolves a bot's playstyle (RPG weight profile name) from its
+    // mod-ollama-chat personality via the shared characters DB. Cached per
+    // guid; empty results are retried every 5 min so bots that get their
+    // personality assigned after login still pick up a profile mid-session.
+    std::mutex playstyleCacheMutex;
+    std::unordered_map<ObjectGuid::LowType, std::pair<std::string, uint32>> playstyleCache;
+
+    std::string GetBotPlaystyle(Player* bot)
+    {
+        static int hasPlaystyleColumn = -1;
+        if (hasPlaystyleColumn == -1)
+        {
+            QueryResult probe = CharacterDatabase.Query(
+                "SELECT 1 FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() "
+                "AND TABLE_NAME = 'mod_ollama_chat_personality_templates' AND COLUMN_NAME = 'playstyle'");
+            hasPlaystyleColumn = probe ? 1 : 0;
+            if (hasPlaystyleColumn)
+                LOG_INFO("playerbots", "[Playstyle] personality playstyle column found - per-personality RPG profiles active");
+        }
+        if (!hasPlaystyleColumn)
+            return "";
+
+        ObjectGuid::LowType guid = bot->GetGUID().GetCounter();
+        uint32 now = getMSTime();
+        {
+            std::lock_guard<std::mutex> lock(playstyleCacheMutex);
+            auto it = playstyleCache.find(guid);
+            if (it != playstyleCache.end() && (!it->second.first.empty() || now - it->second.second < 5 * MINUTE * IN_MILLISECONDS))
+                return it->second.first;
+        }
+
+        std::string playstyle;
+        QueryResult result = CharacterDatabase.Query(
+            "SELECT t.playstyle FROM mod_ollama_chat_personality p "
+            "JOIN mod_ollama_chat_personality_templates t ON t.`key` = p.personality "
+            "WHERE p.guid = {}", guid);
+        if (result)
+            playstyle = (*result)[0].Get<std::string>();
+        if (playstyle == "default")
+            playstyle.clear();
+        if (!playstyle.empty())
+            LOG_DEBUG("playerbots", "[Playstyle] Bot {} uses RPG profile '{}'", bot->GetName(), playstyle);
+
+        std::lock_guard<std::mutex> lock(playstyleCacheMutex);
+        playstyleCache[guid] = {playstyle, now};
+        return playstyle;
+    }
+}
