diff --git a/src/PlayerbotAIConfig.cpp b/src/PlayerbotAIConfig.cpp
index eef9bfc..941938e 100644
--- a/src/PlayerbotAIConfig.cpp
+++ b/src/PlayerbotAIConfig.cpp
@@ -712,9 +712,45 @@ bool PlayerbotAIConfig::Initialize()
