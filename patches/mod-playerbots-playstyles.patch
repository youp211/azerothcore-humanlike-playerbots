+// Sentiment bridge to mod-ollama-chat (shared characters DB, guid counters):
+// cached per pair, neutral 0.5 when the chat module or the row is absent.
+static float GetBotPlayerSentiment(Player* bot, Player* player)
+{
+    static int hasTable = -1;
+    if (hasTable == -1)
+        hasTable = CharacterDatabase.Query(
+            "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+            "AND TABLE_NAME = 'mod_ollama_chat_bot_player_sentiments'") ? 1 : 0;
+    if (!hasTable)
+        return 0.5f;
+
+    static std::mutex sentimentCacheMutex;
+    static std::map<std::pair<ObjectGuid::LowType, ObjectGuid::LowType>, std::pair<float, uint32>> sentimentCache;
+    auto key = std::make_pair(bot->GetGUID().GetCounter(), player->GetGUID().GetCounter());
+    uint32 now = getMSTime();
+    {
+        std::lock_guard<std::mutex> lock(sentimentCacheMutex);
+        auto it = sentimentCache.find(key);
+        if (it != sentimentCache.end() && now - it->second.second < 5 * MINUTE * IN_MILLISECONDS)
+            return it->second.first;
+    }
+
+    float value = 0.5f;
+    QueryResult result = CharacterDatabase.Query(
+        "SELECT sentiment_value FROM mod_ollama_chat_bot_player_sentiments WHERE bot_guid = {} AND player_guid = {}",
+        key.first, key.second);
+    if (result)
+        value = (*result)[0].Get<float>();
+
+    std::lock_guard<std::mutex> lock(sentimentCacheMutex);
+    sentimentCache[key] = {value, now};
+    return value;
+}
+
+Player* OfferQuestHelpAction::FindQuestHelpTarget(Player* bot, PlayerbotAI* botAI, int& tier)
+{
+    if (!bot->IsAlive() || bot->GetGroup() || bot->InBattleground() || bot->IsInCombat())
+        return nullptr;
+
+    uint32 questId = 0;
+    if (botAI->rpgInfo.GetStatus() == RPG_DO_QUEST)
+        questId = std::get<NewRpgInfo::DoQuest>(botAI->rpgInfo.data).questId;
+
+    GuidVector nearGuids = botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest friendly players")->Get();
+    for (ObjectGuid const& guid : nearGuids)
+    {
+        Player* player = ObjectAccessor::FindPlayer(guid);
+        if (!player || player == bot || !player->IsAlive() || player->GetGroup())
+            continue;
+        if (GET_PLAYERBOT_AI(player))
+            continue; // offer to real players; bots group up via other features
+        if (player->isDND() || player->IsBeingTeleported())
+            continue;
+        if (bot->GetDistance(player) > 30.0f)
+            continue;
+        if (GetBotPlayerSentiment(bot, player) < sPlayerbotAIConfig.questHelpSentimentThreshold)
+            continue;
+
+        if (questId && player->GetQuestStatus(questId) == QUEST_STATUS_INCOMPLETE)
+            tier = 2; // confirmed: same quest in both logs
+        else if (questId)
+            tier = 1; // bot is questing here, can't confirm the player is
+        else
+            tier = 0; // not questing - the rare generic help offer
+        return player;
+    }
+
+    return nullptr;
+}
+
+bool OfferQuestHelpAction::Execute(Event /*event*/)
+{
+    int tier = 0;
+    Player* target = FindQuestHelpTarget(bot, botAI, tier);
+    if (!target)
+        return false;
+
+    std::string line;
+    if (tier == 2)
+    {
+        uint32 questId = std::get<NewRpgInfo::DoQuest>(botAI->rpgInfo.data).questId;
+        Quest const* quest = sObjectMgr->GetQuestTemplate(questId);
+        std::string title = quest ? quest->GetTitle() : "this quest";
+        line = urand(0, 1) ? Acore::StringFormat("hey you're on {} too right? group up, goes way faster", title)
+                           : Acore::StringFormat("doing {} as well - wanna knock it out together?", title);
+    }
+    else if (tier == 1)
+        line = urand(0, 1) ? "you questing around here too? wanna group up"
+                           : "grinding the same camp it looks like - group?";
+    else
+        line = urand(0, 1) ? "need a hand with anything? im around"
+                           : "if you need help with something just say";
+
+    bot->Say(line, LANG_UNIVERSAL);
+    bool invited = Invite(bot, target);
+    if (invited)
+        LOG_DEBUG("playerbots", "[QuestHelp] Bot {} offered quest help to {} (tier {})",
+                  bot->GetName(), target->GetName(), tier);
+    return invited;
+}
