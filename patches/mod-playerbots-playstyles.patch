+// mod-ollama-chat parks in-person gear gives in mod_ollama_chat_pending_gives
+// (the bot promised an item in chat); the hand-over completes here when the
+// player opens a trade window with the bot. Returns parked item guid (0 = none).
+static ObjectGuid::LowType PendingGiveItemGuid(Player* bot, Player* trader, uint32* codOut)
+{
+    static int hasTable = -1;
+    if (hasTable == -1)
+        hasTable = CharacterDatabase.Query(
+            "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+            "AND TABLE_NAME = 'mod_ollama_chat_pending_gives'") ? 1 : 0;
+    if (!hasTable)
+        return 0;
+
+    QueryResult result = CharacterDatabase.Query(
+        "SELECT item_guid, cod FROM mod_ollama_chat_pending_gives "
+        "WHERE bot_guid = {} AND player_guid = {} AND created_at > NOW() - INTERVAL 10 MINUTE",
+        bot->GetGUID().GetCounter(), trader->GetGUID().GetCounter());
+    if (!result)
+        return 0;
+
+    if (codOut)
+        *codOut = (*result)[1].Get<uint32>();
+    return (*result)[0].Get<ObjectGuid::LowType>();
+}
+
+static void ClearPendingGive(Player* bot, Player* trader)
+{
+    CharacterDatabase.Execute("DELETE FROM mod_ollama_chat_pending_gives WHERE bot_guid = {} AND player_guid = {}",
+                              bot->GetGUID().GetCounter(), trader->GetGUID().GetCounter());
+}
