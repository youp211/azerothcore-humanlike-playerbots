+void DungeonCompanions::EnsureLoaded()
+{
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        if (_loaded)
+            return;
+        _loaded = true;
+    }
+
+    // Guard against the table not existing yet (module SQL not applied).
+    if (!CharacterDatabase.Query("SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+                                 "AND TABLE_NAME = 'mod_playerbots_companions'"))
+    {
+        LOG_INFO("playerbots", "[DungeonCompanions] companions table absent; persistence idle until SQL applies");
+        return;
+    }
+
+    uint32 count = 0;
+    if (QueryResult result = CharacterDatabase.Query("SELECT bot_guid FROM mod_playerbots_companions"))
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        do
+        {
+            _companions.insert((*result)[0].Get<uint32>());
+            ++count;
+        } while (result->NextRow());
+    }
+    LOG_INFO("playerbots", "[DungeonCompanions] loaded {} persistent companion(s)", count);
+}
+
+bool DungeonCompanions::IsCompanion(ObjectGuid::LowType botLow)
+{
+    if (!_loaded)
+        EnsureLoaded();
+    std::lock_guard<std::mutex> lock(_mutex);
+    return _companions.find(botLow) != _companions.end();
+}
+
+void DungeonCompanions::OnPartyChanged(Group* group)
+{
+    if (!DcEnabled() || !group)
+        return;
+
+    // Qualify the group and snapshot its real player + random-bot members.
+    ObjectGuid playerGuid;
+    std::vector<ObjectGuid> botGuids;
+    for (auto const& slot : group->GetMemberSlots())
+    {
+        Player* member = ObjectAccessor::FindPlayer(slot.guid);
+        if (!member)
+            continue;
+        if (!IsBot(member))
+            playerGuid = member->GetGUID();
+        else if (sRandomPlayerbotMgr.IsRandomBot(member))
+            botGuids.push_back(member->GetGUID());
+    }
+
+    ObjectGuid const key = group->GetGUID();
+    bool const qualifies = playerGuid && !botGuids.empty();
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _runs.find(key);
+    if (qualifies)
+    {
+        RunState& run = (it == _runs.end()) ? _runs[key] : it->second;
+        if (run.startMs == 0)
+        {
+            run.startMs = getMSTime();
+            run.playerGuid = playerGuid;
+        }
+        // Accumulate bots - remember everyone who was ever part of the run, even
+        // members who later drop, so they still get judged at the end.
+        for (ObjectGuid const& g : botGuids)
+            run.botGuids.insert(g);
+    }
+    else if (it != _runs.end() && !it->second.resolved)
+    {
+        // Stopped qualifying (player left, or all bots gone) -> the run is over.
+        // Defer the (heavier, DB/LLM-touching) resolve to the next world tick so
+        // this GroupScript hook never does it while holding the lock.
+        _pendingResolve.push_back(std::move(it->second));
+        _runs.erase(it);
+    }
+}
+
+void DungeonCompanions::OnPartyDisband(ObjectGuid groupGuid)
+{
+    if (!DcEnabled())
+        return;
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _runs.find(groupGuid);
+    if (it == _runs.end() || it->second.resolved)
+        return;
+    RunState run = it->second;
+    _runs.erase(it);
+    _pendingResolve.push_back(std::move(run));
+}
+
+void DungeonCompanions::OnMemberDeath(Player* member)
+{
+    if (!DcEnabled() || !member)
+        return;
+
+    Group* group = member->GetGroup();
+    if (!group)
+        return;
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _runs.find(group->GetGUID());
+    if (it != _runs.end() && !it->second.resolved)
+        ++it->second.deaths;
+}
+
+void DungeonCompanions::Update(uint32 diff)
+{
+    EnsureLoaded();
+
+    // 1) every tick, latch "this run zoned into a dungeon" for live runs. Done
+    // continuously (not just on the 30s sweep) so a run that ends via disband /
+    // player-leave BEFORE a sweep still carries the flag when it resolves.
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        for (auto& kv : _runs)
+        {
+            if (kv.second.entered)
+                continue;
+            if (Player* p = ObjectAccessor::FindPlayer(kv.second.playerGuid))
+                if (p->IsInWorld() && p->GetMap() && p->GetMap()->IsDungeon())
+                    kv.second.entered = true;
+        }
+    }
+
+    // 2) drain any runs that ended since the last tick (resolved off-lock).
+    std::vector<RunState> toResolve;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        toResolve.swap(_pendingResolve);
+    }
+    for (RunState& run : toResolve)
+        ResolveRun(run);
+
+    // 3) reap runs whose group vanished without a disband hook, resolving them.
+    _resolveAccumMs += diff;
+    if (_resolveAccumMs >= DcResolveIntervalSec() * IN_MILLISECONDS)
+    {
+        _resolveAccumMs = 0;
+        ResolveStaleRuns();
+    }
+
+    // 4) autofill queued players.
+    if (AfEnabled())
+    {
+        _autofillAccumMs += diff;
+        if (_autofillAccumMs >= std::max<uint32>(1, AfIntervalSec()) * IN_MILLISECONDS)
+        {
+            _autofillAccumMs = 0;
+            AutofillTick();
+        }
+    }
+}
+
+void DungeonCompanions::ResolveStaleRuns()
+{
+    std::vector<RunState> toResolve;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        for (auto it = _runs.begin(); it != _runs.end();)
+        {
+            Group* group = sGroupMgr->GetGroupByGUID(it->first.GetCounter());
+            if (!group && !it->second.resolved)
+            {
+                toResolve.push_back(it->second);  // group vanished without a disband hook
+                it = _runs.erase(it);
+                continue;
+            }
+            ++it;
+        }
+    }
+    for (RunState& run : toResolve)
+        ResolveRun(run);
+}
+
+void DungeonCompanions::ResolveRun(RunState& run)
+{
+    if (run.startMs == 0 || run.botGuids.empty())
+        return;
+
+    // Only a run that actually zoned into a dungeon produces companions - merely
+    // queuing and cancelling leaves the bots as throwaway pool bots.
+    if (!run.entered)
+        return;
+
+    Player* player = ObjectAccessor::FindPlayer(run.playerGuid);
+    if (!player)
+        return;
+
+    uint32 const minMs = DcMinMinutes() * MINUTE * IN_MILLISECONDS;
+    bool const longEnough = (getMSTime() - run.startMs) >= minMs;
+    float const goodThreshold = DcGoodThreshold();
+    float const trollThreshold = DcTrollThreshold();
+
+    // Run-outcome nudge, applied per bot before we read the resulting standing:
+    // a clean, long-enough run rewards; each death penalises. This is what lets a
+    // single memorable run push a bot across the friend / troll line.
+    float outcome = 0.0f;
+    if (longEnough)
+        outcome += DcCompletionNudge();
+    outcome -= DcDeathNudge() * float(run.deaths);
+
+    uint32 friends = 0, trolls = 0;
+    for (ObjectGuid const& botGuid : run.botGuids)
+    {
+        Player* bot = ObjectAccessor::FindPlayer(botGuid);
+        if (!bot || !sRandomPlayerbotMgr.IsRandomBot(bot))
+            continue;
+        if (IsCompanion(botGuid.GetCounter()))
+            continue;  // already a saved companion
+
+        if (outcome != 0.0f)
+            Nudge(bot, player, outcome);
+
+        float const sentiment = OllamaChat_GetSentiment ? OllamaChat_GetSentiment(bot, player) : -1.0f;
+        if (sentiment < 0.0f)
+            continue;  // sentiment unavailable (chat module off) - stay ephemeral
+
+        if (sentiment >= goodThreshold)
+        {
+            SaveCompanion(bot, player, DISPOSITION_FRIEND, sentiment);
+            Speak(bot, player, "you had a great dungeon run together and want to keep adventuring with them", true);
+            ++friends;
+        }
+        else if (sentiment <= trollThreshold)
+        {
+            SaveCompanion(bot, player, DISPOSITION_TROLL, sentiment);
+            // A troll sticks around to keep being a nuisance - no friendly line.
+            ++trolls;
+        }
+        // else neutral: not saved; returns to the random pool as normal.
+    }
+
+    if (friends || trolls)
+        LOG_INFO("playerbots", "[DungeonCompanions] run for {} ended ({} deaths, {}): +{} friend(s) +{} troll(s)",
+                 player->GetName(), run.deaths, longEnough ? "completed" : "short", friends, trolls);
+}
+
+void DungeonCompanions::SaveCompanion(Player* bot, Player* player, uint8 disposition, float sentiment)
+{
+    ObjectGuid::LowType const botLow = bot->GetGUID().GetCounter();
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        if (!_companions.insert(botLow).second)
+            return;  // raced - already saved
+    }
+
+    CharacterDatabase.Execute(
+        "INSERT INTO mod_playerbots_companions (bot_guid, player_guid, disposition, sentiment) VALUES ({}, {}, {}, {:.3f}) "
+        "ON DUPLICATE KEY UPDATE player_guid = VALUES(player_guid), disposition = VALUES(disposition), "
+        "sentiment = VALUES(sentiment)",
+        botLow, player->GetGUID().GetCounter(), uint32(disposition), sentiment);
+
+    LOG_INFO("playerbots", "[DungeonCompanions] {} <{}> saved as {} of {} (sentiment {:.2f})",
+             bot->GetName(), botLow, disposition == DISPOSITION_TROLL ? "TROLL" : "FRIEND", player->GetName(), sentiment);
+}
+
+void DungeonCompanions::AutofillTick()
+{
+    int32 const levelSpread = std::max<int32>(1, AfLevelSpread());
+    uint32 const cooldownMs = AfPlayerCooldownSec() * IN_MILLISECONDS;
+    uint32 const now = getMSTime();
+
+    HashMapHolder<Player>::MapType const& players = ObjectAccessor::GetPlayers();
+    for (auto const& kv : players)
+    {
+        Player* player = kv.second;
+        if (!player || !player->IsInWorld() || IsBot(player))
+            continue;  // real players only
+
+        // Act once per queue via the queue owner (solo player or group leader).
+        Group* group = player->GetGroup();
+        if (group && group->GetLeaderGUID() != player->GetGUID())
+            continue;
+
+        // LFG state + selection live under the GROUP guid when grouped, else the
+        // player guid. Must be actively queued (not yet matched into a proposal).
+        ObjectGuid const queueGuid = group ? group->GetGUID() : player->GetGUID();
+        if (sLFGMgr->GetState(queueGuid) != LFG_STATE_QUEUED)
+            continue;
+
+        uint32 const have = group ? group->GetMembersCount() : 1;
+        if (have >= 5)
+            continue;
+
+        // Per-player cooldown so we top the queue up gently, not every tick.
+        ObjectGuid::LowType const pLow = player->GetGUID().GetCounter();
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            auto it = _lastFill.find(pLow);
+            if (it != _lastFill.end() && now - it->second < cooldownMs)
+                continue;
+            _lastFill[pLow] = now;
+        }
+
+        LfgDungeonSet const selected = sLFGMgr->GetSelectedDungeons(queueGuid);
+        if (selected.empty())
+            continue;
+
+        // Gather free, level-appropriate random bots split by natural role.
+        std::vector<Player*> tanks, heals, dps;
+        for (auto const& bkv : sRandomPlayerbotMgr.GetAllBots())
+        {
+            Player* bot = bkv.second;
+            if (!AutofillCandidate(bot, player, levelSpread))
+                continue;
+            if (BotValidDungeons(bot, selected).empty())
+                continue;
+            uint32 const rm = BotRoleMask(bot);
+            if (rm & PLAYER_ROLE_TANK)
+                tanks.push_back(bot);
+            else if (rm & PLAYER_ROLE_HEALER)
+                heals.push_back(bot);
+            else
+                dps.push_back(bot);
+        }
+
+        // Build the fill list: prefer a full tank/heal/dps comp for the missing
+        // slots, falling back to whatever is available.
+        uint32 need = 5 - have;
+        std::vector<std::pair<Player*, uint32>> toQueue;  // bot -> role
+        auto take = [&](std::vector<Player*>& pool, uint32 role)
+        {
+            if (need == 0 || pool.empty())
+                return;
+            toQueue.emplace_back(pool.back(), role);
+            pool.pop_back();
+            --need;
+        };
+
+        take(tanks, PLAYER_ROLE_TANK);
+        take(heals, PLAYER_ROLE_HEALER);
+        while (need > 0 && !dps.empty())
+            take(dps, PLAYER_ROLE_DAMAGE);
+        // If we still need bodies, backfill from leftover tanks/heals as DPS.
+        while (need > 0 && !tanks.empty())
+            take(tanks, PLAYER_ROLE_DAMAGE);
+        while (need > 0 && !heals.empty())
+            take(heals, PLAYER_ROLE_DAMAGE);
+
+        for (auto const& tq : toQueue)
+            QueueBotForDungeons(tq.first, BotValidDungeons(tq.first, selected), tq.second);
+
+        if (!toQueue.empty())
+            LOG_INFO("playerbots", "[DungeonAutofill] queued {} bot(s) to fill {}'s dungeon ({} needed)",
+                     toQueue.size(), player->GetName(), 5 - have);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Scripts that feed the singleton. The GroupScript tracks dungeon-party
+// membership; the PlayerScript counts member deaths. Empty enabled-hook lists
+// (all hooks on) mirror the sibling PartyGuildFormation scripts.
+// ---------------------------------------------------------------------------
+class DungeonCompanionsGroupScript : public GroupScript
+{
+public:
+    DungeonCompanionsGroupScript() : GroupScript("DungeonCompanionsGroupScript") {}
+
+    void OnCreate(Group* group, Player* /*leader*/) override { DungeonCompanions::instance().OnPartyChanged(group); }
+
+    void OnAddMember(Group* group, ObjectGuid /*guid*/) override
+    {
+        DungeonCompanions::instance().OnPartyChanged(group);
+    }
+
+    void OnRemoveMember(Group* group, ObjectGuid /*guid*/, RemoveMethod /*method*/, ObjectGuid /*kicker*/,
+                        char const* /*reason*/) override
+    {
+        DungeonCompanions::instance().OnPartyChanged(group);
+    }
+
+    void OnDisband(Group* group) override
+    {
+        if (group)
+            DungeonCompanions::instance().OnPartyDisband(group->GetGUID());
+    }
+};
+
+class DungeonCompanionsPlayerScript : public PlayerScript
+{
+public:
+    DungeonCompanionsPlayerScript() : PlayerScript("DungeonCompanionsPlayerScript") {}
+
+    void OnPlayerJustDied(Player* player) override { DungeonCompanions::instance().OnMemberDeath(player); }
+};
+
+void AddSC_DungeonCompanions()
+{
+    new DungeonCompanionsGroupScript();
+    new DungeonCompanionsPlayerScript();
+}
