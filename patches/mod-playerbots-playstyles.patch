@@ -0,0 +1,20 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_PERSONALITYGUILDFACTORY_H
+#define PLAYERBOTS_PERSONALITYGUILDFACTORY_H
+
+class PersonalityGuildFactory
+{
+public:
+    // Forms themed, personality-driven guilds (raid / pvp / casual) from the
+    // pool of currently-online, guildless random bots. Leaders and elite
+    // membership are picked by mod-ollama-chat personality; casual guilds take
+    // the remainder with randomness. Runs at most once per server process
+    // (guarded internally), so it is safe to call from a bot-login hook.
+    static void FormPersonalityGuilds();
+};
+
+#endif
