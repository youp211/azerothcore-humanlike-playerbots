+// Iconic offensive burst cooldowns per class (3.3.5a). Used to detect that a
+// teammate - bot or real player - just opened a burst window.
+static bool HasBurstAura(Player* player)
+{
+    static uint32 const burstAuras[] = {
+        1719,   // Recklessness
+        12292,  // Death Wish
+        31884,  // Avenging Wrath
+        12472,  // Icy Veins
+        12042,  // Arcane Power
+        11129,  // Combustion
+        13750,  // Adrenaline Rush
+        51690,  // Killing Spree
+        51713,  // Shadow Dance
+        19574,  // Bestial Wrath
+        3045,   // Rapid Fire
+        2825,   // Bloodlust
+        32182,  // Heroism
+        16166,  // Elemental Mastery
+        47241,  // Metamorphosis
+        49016,  // Hysteria
+        50334,  // Berserk (feral)
+        49206   // Summon Gargoyle
+    };
+    for (uint32 spellId : burstAuras)
+        if (player->HasAura(spellId))
+            return true;
+
+    return false;
+}
+
+bool ArenaBurstWindowTrigger::IsActive()
+{
+    if (!bot->InArena() || !bot->IsAlive())
+        return false;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetStatus() != STATUS_IN_PROGRESS)
+        return false;
+
+    bool window = false;
+    for (auto const& itr : bg->GetPlayers())
+    {
+        Player* member = ObjectAccessor::FindPlayer(itr.first);
+        if (!member || !member->IsAlive() || member->GetBgTeamId() != bot->GetBgTeamId())
+            continue;
+
+        if (HasBurstAura(member))
+        {
+            window = true;
+            break;
+        }
+    }
+
+    if (!window)
+    {
+        Unit* killTarget = AI_VALUE(Unit*, "arena kill target");
+        window = killTarget && killTarget->GetHealthPct() <= 50.0f;
+    }
+
+    return window != botAI->HasStrategy("boost", BOT_STATE_COMBAT);
+}
