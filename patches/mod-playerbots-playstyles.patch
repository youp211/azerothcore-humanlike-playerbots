+###################################################################################################
+# PERSONALITY-DRIVEN GUILDS (EMERGENT FORMATION)
+#
+# Themed guilds (raid / pvp / casual) form GRADUALLY as the world evolves, rather than in one batch
+# at realm start. A few seed guilds are founded at startup (SeedCount); thereafter, every
+# FoundIntervalSec, one more guild is founded while the number of random-bot guilds is below
+# TargetCount. Each founding picks a leader by mod-ollama-chat personality and seeds the guild SMALL
+# (FoundInitialMembers), leaving headroom for the ongoing recruiter (below) to grow it over time and
+# for the real player to join. Elite (raid/pvp) guilds admit only personality-fit members; casual
+# guilds admit anyone with a join chance. Guild size is capped by AiPlayerbot.RandomBotGuildSizeMax.
+###################################################################################################
+
+# Number of guilds founded immediately at realm start (the rest emerge over time)
+AiPlayerbot.PersonalityGuild.SeedCount = 2
+
+# Stop founding new guilds once this many random-bot guilds exist
+AiPlayerbot.PersonalityGuild.TargetCount = 12
+
+# Seconds between emergent-founding attempts (0 disables ongoing founding)
+AiPlayerbot.PersonalityGuild.FoundIntervalSec = 300
+
+# Members a newly-founded guild starts with, INCLUDING the leader (kept small on purpose;
+# the ongoing recruiter grows the guild the rest of the way toward RandomBotGuildSizeMax)
+AiPlayerbot.PersonalityGuild.FoundInitialMembers = 4
+
+# Relative weights for the archetype of each founded guild (Raid : Pvp : Casual). These no longer
+# set fixed guild counts - they only bias which archetype the next guild will be. Set all to 0 to
+# fall back to the built-in ~1:1:2 mix.
+AiPlayerbot.PersonalityGuild.RaidCount = 4
+AiPlayerbot.PersonalityGuild.PvpCount = 3
+AiPlayerbot.PersonalityGuild.CasualCount = 8
+
+# Minimum level a bot must be to lead a personality guild
+AiPlayerbot.PersonalityGuild.LeaderMinLevel = 1
+
+# Per-bot chance (0-100) that an eligible bot rolls into a casual guild at founding
+AiPlayerbot.PersonalityGuild.CasualJoinChance = 40.0
+
+###################################################################################################
+# ONGOING OPPORTUNISTIC GUILD RECRUITMENT
+#
+# During normal play, a bot that FOUNDED a guild (it is the leader) and has a leader/interactive
+# personality keeps recruiting: it periodically sends guild invites to nearby unguilded bots and
+# to the nearby unguilded real player, in its own voice. Elite (raid/pvp) guilds only admit bots
+# whose personality fits the guild (purity preserved); casual guilds admit anyone. Invited bots
+# auto-accept; the real player chooses. Guild size is capped by AiPlayerbot.RandomBotGuildSizeMax.
+###################################################################################################
+
+# Master switch for ongoing opportunistic guild recruitment
+AiPlayerbot.OngoingRecruitEnabled = 1
+
+# Seconds between recruitment passes over online guild-leader bots
+AiPlayerbot.OngoingRecruitIntervalSec = 180
+
+# Yard radius scanned around a recruiting leader for candidates
+AiPlayerbot.OngoingRecruitRange = 30.0
+
+# Minutes before the same target may be re-invited by the same recruiter
+AiPlayerbot.OngoingRecruitCooldownMin = 120
+
+# Chance bonus (0-100) added when the recruiter's sentiment toward the player is high (>= 0.6)
+AiPlayerbot.OngoingRecruitSentimentBonus = 15
+AiPlayerbot.OngoingRecruitPlayerCooldownMin = 30
+
+###################################################################################################
+# PARTY -> GUILD EMERGENT FORMATION
+#
+# When the real player groups with random bots and the run goes WELL, that party can spontaneously
+# become a guild. Every group that contains the real player plus at least one random bot is tracked
+# from the moment it qualifies: how long it has lived and how many member deaths it has suffered.
+# A party becomes guild-eligible once it has been alive at least MinMinutes and the outcome is good -
+# a formation chance that STARTS at BaseChance and is reduced by DeathPenalty per death (floored at
+# 0), so a clean, long-lived party is far likelier to guild up than a wiped one.
+#
+# Two triggers: (1) a periodic world-thread tick (every CheckIntervalSec) rolls the outcome-adjusted
+# chance; (2) the player says a "let's guild up" line in party chat (routed from mod-ollama-chat),
+# which bypasses the random roll but still requires the MinMinutes + not-wiped gate - otherwise a
+# party bot declines in-voice. On formation, the most leader-suited bot founds the guild and invites
+# the whole crew (bots auto-accept; the player chooses); the founder's personality names the guild.
+###################################################################################################
+
+# Master switch for party -> guild emergent formation
+AiPlayerbot.PartyGuild.Enabled = 1
