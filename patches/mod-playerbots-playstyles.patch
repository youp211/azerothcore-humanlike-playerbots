+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#include "OngoingGuildRecruit.h"
+
+#include "Cell.h"
+#include "CellImpl.h"
+#include "Common.h"
+#include "Config.h"
+#include "DatabaseEnv.h"
+#include "GridNotifiers.h"
+#include "GridNotifiersImpl.h"
+#include "Guild.h"
+#include "GuildMgr.h"
+#include "Log.h"
+#include "ObjectAccessor.h"
+#include "Opcodes.h"
+#include "Player.h"
+#include "PlayerbotAIConfig.h"
+#include "PlayerbotMgr.h"
+#include "Random.h"
+#include "RandomPlayerbotMgr.h"
+#include "StringFormat.h"
+#include "Timer.h"
+#include "WorldPacket.h"
+#include "WorldSession.h"
+
+#include <algorithm>
+#include <list>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+
+// Provided by mod-ollama-chat (same binary): make a bot SAY or WHISPER a short,
+// in-character, LLM-generated line about a concrete situation. Weakly optional -
+// null (and the call a no-op) when the chat module is disabled. Same weak hook
+// GuildRecruitmentEvent uses for its realm-start pitches.
+[[gnu::weak]] void OllamaChat_SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper);
+
+namespace
+{
+    // Global "last time the REAL player was sent a guild invite" (any leader).
+    // World-thread-only access (the recruiter tick), so a plain static is safe.
+    uint32 g_lastPlayerInviteMs = 0;
+
+    void SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper)
+    {
+        if (OllamaChat_SpeakSituation)
+            OllamaChat_SpeakSituation(bot, target, situation, whisper);
+    }
+
+    using PersonalitySet = std::unordered_set<std::string>;
+
+    // Authoritative leader / fit sets - a verbatim mirror of PersonalityGuildFactory's
+    // (they live in that file's anonymous namespace, so cannot be shared directly).
+    // Archetype and elite fit enforcement below reconstruct a guild's original rules
+    // from its leader's personality, keeping recruitment consistent with formation.
+    PersonalitySet const RAID_LEADERS   = {"HARDCORE_RAIDLEAD", "THEORYCRAFTER", "MIN_MAXER", "LORE_NERD"};
+    PersonalitySet const PVP_LEADERS    = {"ELITE_ARENA_PVPER", "PVP_TRASHTALKER", "DUELIST", "RAGER"};
+    PersonalitySet const CASUAL_LEADERS = {"WOW_MOM",     "MENTOR",           "GUILD_RECRUITER",
+                                           "CHILL_DAD",   "JOLLY_BEER_LOVER", "HEROIC_LEADER"};
+
+    PersonalitySet const RAID_FIT = {"RAIDER",      "THEORYCRAFTER", "MIN_MAXER",          "HARDCORE_RAIDLEAD",
+                                     "HEALER_MAIN", "SPEEDRUNNER",   "ACHIEVEMENT_HUNTER", "LORE_NERD"};
+    PersonalitySet const PVP_FIT  = {"PVP_HARDCORE", "PVP_TRASHTALKER", "DUELIST",
+                                     "ELITE_ARENA_PVPER", "RAGER", "EDGE_LORD"};
+
+    // How often (0-100) a guild leader with this personality opportunistically
+    // recruits during normal play - the "frequently a party leader / interactive"
+    // gate. Any other recognised leader personality gets 25; a non-leader
+    // personality gets 0 and never recruits (guild leaders only reach here anyway).
+    float OngoingRecruitChanceFor(std::string const& personality)
+    {
+        // Tight per-check chances (combined with a 3-min interval + 2-hr per-pair
+        // cooldown, so even the chattiest recruiter invites a given target rarely).
+        static std::unordered_map<std::string, float> const kChances = {
+            {"GUILD_RECRUITER", 50.0f}, {"LFG_SPAMMER", 35.0f},       {"HEROIC_LEADER", 30.0f},
+            {"MENTOR", 28.0f},          {"WOW_MOM", 28.0f},           {"JOLLY_BEER_LOVER", 22.0f},
+            {"CHILL_DAD", 22.0f},       {"HARDCORE_RAIDLEAD", 20.0f}, {"ELITE_ARENA_PVPER", 15.0f},
+        };
+        auto it = kChances.find(personality);
+        if (it != kChances.end())
+            return it->second;
+        if (RAID_LEADERS.count(personality) || PVP_LEADERS.count(personality) || CASUAL_LEADERS.count(personality))
+            return 12.0f;
+        return 0.0f;
+    }
+
+    // The fit-set an elite guild enforces on bot recruits, derived from its
+    // leader's personality; nullptr for a casual guild (anyone fits).
+    PersonalitySet const* FitSetForLeader(std::string const& leaderPersonality)
+    {
+        if (RAID_LEADERS.count(leaderPersonality))
+            return &RAID_FIT;
+        if (PVP_LEADERS.count(leaderPersonality))
+            return &PVP_FIT;
+        return nullptr;  // casual: no fit requirement
+    }
+
+    char const* ArchetypeName(std::string const& leaderPersonality)
+    {
+        if (RAID_LEADERS.count(leaderPersonality))
+            return "raid";
+        if (PVP_LEADERS.count(leaderPersonality))
+            return "pvp";
+        return "casual";
+    }
+
+    // guid -> personality from the shared characters DB, guid-cached. Empty
+    // results are re-checked after 5 min; a found personality is cached for good.
+    // Mirrors GetBotPlaystyle's cache shape (NewRpgBaseAction.cpp).
+    std::string GetPersonality(ObjectGuid guid)
+    {
+        static int hasTable = -1;
+        if (hasTable == -1)
+            hasTable = CharacterDatabase.Query(
+                          "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+                          "AND TABLE_NAME = 'mod_ollama_chat_personality'")
+                          ? 1
+                          : 0;
+        if (!hasTable)
+            return "";
+
+        ObjectGuid::LowType const low = guid.GetCounter();
+        uint32 const now = getMSTime();
+        static std::mutex cacheMutex;
+        static std::map<ObjectGuid::LowType, std::pair<std::string, uint32>> cache;
+        {
+            std::lock_guard<std::mutex> lock(cacheMutex);
+            auto it = cache.find(low);
+            if (it != cache.end() &&
+                (!it->second.first.empty() || now - it->second.second < 5 * MINUTE * IN_MILLISECONDS))
+                return it->second.first;
+        }
+
+        std::string personality;
+        if (QueryResult result = CharacterDatabase.Query(
+                "SELECT personality FROM mod_ollama_chat_personality WHERE guid = {}", low))
+            personality = (*result)[0].Get<std::string>();
+
+        std::lock_guard<std::mutex> lock(cacheMutex);
+        cache[low] = {personality, now};
+        return personality;
+    }
+
+    // Recruiter -> real-player sentiment (shared characters DB, guid counters),
+    // cached per pair; neutral 0.5 when the chat module or the row is absent.
+    // Mirrors InviteToGroupAction's GetBotPlayerSentiment.
+    float GetSentiment(Player* bot, Player* player)
+    {
+        static int hasTable = -1;
+        if (hasTable == -1)
+            hasTable = CharacterDatabase.Query(
+                          "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+                          "AND TABLE_NAME = 'mod_ollama_chat_bot_player_sentiments'")
+                          ? 1
+                          : 0;
+        if (!hasTable)
+            return 0.5f;
+
+        static std::mutex cacheMutex;
+        static std::map<std::pair<ObjectGuid::LowType, ObjectGuid::LowType>, std::pair<float, uint32>> cache;
+        auto const key = std::make_pair(bot->GetGUID().GetCounter(), player->GetGUID().GetCounter());
+        uint32 const now = getMSTime();
+        {
+            std::lock_guard<std::mutex> lock(cacheMutex);
+            auto it = cache.find(key);
+            if (it != cache.end() && now - it->second.second < 5 * MINUTE * IN_MILLISECONDS)
+                return it->second.first;
+        }
+
+        float value = 0.5f;
+        if (QueryResult result = CharacterDatabase.Query(
+                "SELECT sentiment_value FROM mod_ollama_chat_bot_player_sentiments "
+                "WHERE bot_guid = {} AND player_guid = {}",
+                key.first, key.second))
+            value = (*result)[0].Get<float>();
+
+        std::lock_guard<std::mutex> lock(cacheMutex);
+        cache[key] = {value, now};
+        return value;
+    }
+
+    // Queue a CMSG_GUILD_INVITE on the leader's session for `target` - identical
+    // to GuildRecruitmentEvent::SendGuildInvite. The core runs the full invite
+    // path; the target pops SMSG_GUILD_INVITE. For a BOT target that outgoing
+    // packet is caught by its own "guild invite" handler (PlayerbotAI.cpp) which
+    // the world_packet ("default") strategy routes to GuildAcceptAction, so the
+    // bot auto-accepts. A real player gets the dialog and chooses.
+    void SendGuildInvite(Player* leader, Player* target)
+    {
+        WorldSession* session = leader->GetSession();
+        if (!session)
+            return;
+
+        WorldPacket* data = new WorldPacket(CMSG_GUILD_INVITE);
+        *data << target->GetName();
+        session->QueuePacket(data);
+    }
+}  // namespace
+
+OngoingGuildRecruit& OngoingGuildRecruit::instance()
+{
+    static OngoingGuildRecruit instance;
+    return instance;
+}
+
+void OngoingGuildRecruit::Update(uint32 diff)
+{
+    if (!sConfigMgr->GetOption<bool>("AiPlayerbot.OngoingRecruitEnabled", true))
+        return;
+
+    _accumMs += diff;
+    uint32 const intervalMs =
+        sConfigMgr->GetOption<uint32>("AiPlayerbot.OngoingRecruitIntervalSec", 180) * IN_MILLISECONDS;
+    if (_accumMs < intervalMs)
+        return;
+
+    _accumMs = 0;
+    Tick();
+}
+
+void OngoingGuildRecruit::Tick()
+{
+    float const range = sConfigMgr->GetOption<float>("AiPlayerbot.OngoingRecruitRange", 30.0f);
+    uint32 const cooldownMin = sConfigMgr->GetOption<uint32>("AiPlayerbot.OngoingRecruitCooldownMin", 120);
+    float const sentimentBonus = sConfigMgr->GetOption<float>("AiPlayerbot.OngoingRecruitSentimentBonus", 15.0f);
+    // Global anti-spam for the REAL player: at most one guild invite popup per
+    // this window across ALL leaders, no matter how many they pass.
+    uint32 const playerCdMs =
+        sConfigMgr->GetOption<uint32>("AiPlayerbot.OngoingRecruitPlayerCooldownMin", 30) * MINUTE * IN_MILLISECONDS;
+    uint32 const cooldownMs = cooldownMin * MINUTE * IN_MILLISECONDS;
+    uint32 const cap = std::max<uint32>(2, sPlayerbotAIConfig.randomBotGuildSizeMax);
+    uint32 const now = getMSTime();
+
+    for (auto const& kv : sRandomPlayerbotMgr.GetAllBots())
+    {
+        Player* leader = kv.second;
+        if (!leader || !leader->IsInWorld() || leader->IsBeingTeleported())
+            continue;
+
+        uint32 const guildId = leader->GetGuildId();
+        if (!guildId)
+            continue;
+
+        // Only a guild's FOUNDER/leader recruits for it.
+        Guild* guild = sGuildMgr->GetGuildById(guildId);
+        if (!guild || guild->GetLeaderGUID() != leader->GetGUID())
+            continue;
+
+        if (guild->GetMemberCount() >= cap)
+            continue;  // guild full - do not recruit
+
+        std::string const leaderPersonality = GetPersonality(leader->GetGUID());
+        float const baseChance = OngoingRecruitChanceFor(leaderPersonality);
+        if (baseChance <= 0.0f)
+            continue;  // not a leader/interactive personality
+
+        PersonalitySet const* fitSet = FitSetForLeader(leaderPersonality);
+        std::string const guildName = guild->GetName();
+        TeamId const team = leader->GetTeamId();
+        int32 slots = int32(cap) - int32(guild->GetMemberCount());
+
+        std::list<Player*> nearby;
+        Acore::AnyPlayerInObjectRangeCheck check(leader, range);
+        Acore::PlayerListSearcher<Acore::AnyPlayerInObjectRangeCheck> searcher(leader, nearby, check);
+        Cell::VisitObjects(leader, searcher, range);
+
+        for (Player* target : nearby)
+        {
+            if (slots <= 0)
+                break;  // guild is (about to be) full
+            if (!target || target == leader)
+                continue;
+            if (target->GetTeamId() != team)
+                continue;  // guild invites are same-faction
+            if (target->GetGuildId() || target->GetGuildIdInvited())
+                continue;  // already guilded, or already has a pending invite
+
+            // Per-(recruiter, target) cooldown so nobody is re-spammed.
+            auto const cdKey = std::make_pair(leader->GetGUID(), target->GetGUID());
+            {
+                std::lock_guard<std::mutex> lock(_mutex);
+                auto it = _lastInvite.find(cdKey);
+                if (it != _lastInvite.end() && now - it->second < cooldownMs)
+                    continue;
+            }
+
+            bool const targetIsBot = sPlayerbotsMgr.GetPlayerbotAI(target) != nullptr;
+
+            if (targetIsBot)
+            {
+                // Preserve elite purity: an elite guild only admits bots whose
+                // personality is in its fit-set. Casual guilds admit anyone.
+                if (fitSet && !fitSet->count(GetPersonality(target->GetGUID())))
+                    continue;
+
+                if (!roll_chance_f(baseChance))
+                    continue;
+
+                SendGuildInvite(leader, target);  // bot auto-accepts via its own packet handler
+                {
+                    std::lock_guard<std::mutex> lock(_mutex);
+                    _lastInvite[cdKey] = now;
+                }
+                --slots;
+                LOG_INFO("playerbots", "[OngoingRecruit] {} ({}) invited bot {} to '{}'", leader->GetName(),
+                         leaderPersonality, target->GetName(), guildName);
+
+                // Occasional in-voice say - audible recruitment without spam.
+                if (roll_chance_i(25))
+                    SpeakSituation(leader, nullptr,
+                                   Acore::StringFormat("you just recruited a fellow adventurer into your {} guild "
+                                                       "'{}' - say something short and welcoming",
+                                                       ArchetypeName(leaderPersonality), guildName),
+                                   false);
+            }
+            else
+            {
+                // The real player: always archetype-eligible, gated on sentiment;
+                // higher standing raises the chance. No auto-accept - they choose.
+                // Global cooldown first: never popup-spam the player across leaders.
+                if (playerCdMs && g_lastPlayerInviteMs && now - g_lastPlayerInviteMs < playerCdMs)
+                    continue;
+
+                float chance = baseChance;
+                if (GetSentiment(leader, target) >= 0.6f)
+                    chance += sentimentBonus;
+
+                if (!roll_chance_f(chance))
+                    continue;
+
+                SendGuildInvite(leader, target);
+                g_lastPlayerInviteMs = now;
+                {
+                    std::lock_guard<std::mutex> lock(_mutex);
+                    _lastInvite[cdKey] = now;
+                }
+                LOG_INFO("playerbots", "[OngoingRecruit] {} ({}) invited player {} to '{}'", leader->GetName(),
+                         leaderPersonality, target->GetName(), guildName);
+                SpeakSituation(leader, target,
+                               Acore::StringFormat("you're inviting {} to join your guild '{}' - give a short "
+                                                   "in-character pitch for why they should",
+                                                   target->GetName(), guildName),
+                               true);
+            }
+        }
+    }
+}
