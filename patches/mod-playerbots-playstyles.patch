+    bool IsBot(Player* p) { return p && sPlayerbotsMgr.GetPlayerbotAI(p) != nullptr; }
+
+    // A candidate's natural LFG role, mirroring LfgJoinAction::GetRoles' random-bot
+    // branch (spec-tab -> role). Keeps autofill comps sensible (tank/heal/dps).
+    uint32 BotRoleMask(Player* bot)
+    {
+        uint8 spec = AiFactory::GetPlayerSpecTab(bot);
+        switch (bot->getClass())
+        {
+            case CLASS_DRUID:
+                if (spec == 2)
+                    return PLAYER_ROLE_HEALER;
+                if (spec == 1 && bot->HasAura(16931) /* thick hide */)
+                    return PLAYER_ROLE_TANK;
+                return PLAYER_ROLE_DAMAGE;
+            case CLASS_PALADIN:
+                if (spec == 1)
+                    return PLAYER_ROLE_TANK;
+                if (!spec)
+                    return PLAYER_ROLE_HEALER;
+                return PLAYER_ROLE_DAMAGE;
+            case CLASS_PRIEST:
+                return spec != 2 ? PLAYER_ROLE_HEALER : PLAYER_ROLE_DAMAGE;
+            case CLASS_SHAMAN:
+                return spec == 2 ? PLAYER_ROLE_HEALER : PLAYER_ROLE_DAMAGE;
+            case CLASS_WARRIOR:
+                return spec == 2 ? PLAYER_ROLE_TANK : PLAYER_ROLE_DAMAGE;
+            case CLASS_DEATH_KNIGHT:
+                return spec == 0 ? PLAYER_ROLE_TANK : PLAYER_ROLE_DAMAGE;
+            default:
+                return PLAYER_ROLE_DAMAGE;
+        }
+    }
+
+    // The subset of `selected` (the real player's queued dungeon values) that this
+    // bot is level-eligible for, normalised to raw dungeon IDs. Same normalisation
+    // + level gate LfgJoinAction applies, so the queued packet is well-formed. The
+    // low 3 bytes strip the LFG type bits so LookupEntry resolves the entry.
+    std::vector<uint32> BotValidDungeons(Player* bot, LfgDungeonSet const& selected)
+    {
+        std::vector<uint32> out;
+        uint32 const botLevel = bot->GetLevel();
+        for (uint32 value : selected)
+        {
+            LFGDungeonEntry const* dungeon = sLFGDungeonStore.LookupEntry(value & 0x00FFFFFF);
+            if (!dungeon || (dungeon->TypeID != LFG_TYPE_RANDOM && dungeon->TypeID != LFG_TYPE_DUNGEON &&
+                             dungeon->TypeID != LFG_TYPE_HEROIC && dungeon->TypeID != LFG_TYPE_RAID))
+                continue;
+            if (dungeon->MinLevel && (botLevel < dungeon->MinLevel || botLevel > dungeon->MaxLevel))
+                continue;
+            if (botLevel > uint32(dungeon->MinLevel) + 10 && dungeon->TypeID == LFG_TYPE_DUNGEON)
+                continue;
+            out.push_back(dungeon->ID);
+        }
+        return out;
+    }
+
+    // Queue `bot` into the dungeon-finder for `dungeons` as `roleMask`, using the
+    // exact CMSG_LFG_JOIN packet form LfgJoinAction::JoinLFG uses (JoinLfg itself
+    // is not thread-safe, so we push a packet onto the bot's session instead).
+    void QueueBotForDungeons(Player* bot, std::vector<uint32> const& dungeons, uint32 roleMask)
+    {
+        if (dungeons.empty() || !bot->GetSession())
+            return;
+
+        PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+        std::string const gs = botAI ? std::to_string(botAI->GetEquipGearScore(bot)) : "0";
+
+        WorldPacket* data = new WorldPacket(CMSG_LFG_JOIN);
+        *data << (uint32)roleMask;
+        *data << (bool)false;
+        *data << (bool)false;
+        *data << (uint8)(dungeons.size());
+        for (uint32 dungeon : dungeons)
+            *data << (uint32)dungeon;
+        *data << (uint8)3 << (uint8)0 << (uint8)0 << (uint8)0;  // needs
+        *data << gs;
+        bot->GetSession()->QueuePacket(data);
+    }
+
+    // Is this random bot free to be pulled into a player's dungeon queue right now?
+    bool AutofillCandidate(Player* bot, Player* player, int32 levelSpread)
+    {
+        if (!bot || bot == player || !bot->IsInWorld() || bot->IsBeingTeleported())
+            return false;
+        if (!sRandomPlayerbotMgr.IsRandomBot(bot))
+            return false;
+        if (bot->GetTeamId() != player->GetTeamId())
+            return false;
+        if (bot->GetLevel() < 15)
+            return false;
+        if (bot->isDead() || bot->IsInCombat())
+            return false;
+        if (bot->GetGroup() || bot->InBattleground() || bot->InBattlegroundQueue())
+            return false;
+        if (Map* map = bot->GetMap())
+            if (map->Instanceable())
+                return false;
+        if (sLFGMgr->GetState(bot->GetGUID()) != LFG_STATE_NONE)
+            return false;
+        // Keep the queued crew near the player's level so the core accepts the join.
+        int32 const diff = int32(bot->GetLevel()) - int32(player->GetLevel());
+        if (diff < -levelSpread || diff > levelSpread)
+            return false;
+        return true;
+    }
+}  // namespace
