+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_PERSONALITYGUILDFACTORY_H
+#define PLAYERBOTS_PERSONALITYGUILDFACTORY_H
+
+#include "Define.h"
+
+class PersonalityGuildFactory
+{
+public:
+    // Seeds the world with a few personality guilds at startup (AiPlayerbot.
+    // PersonalityGuild.SeedCount), then leaves the rest to emerge over time. Runs
+    // at most once per server process (guarded internally), so it is safe to call
+    // from a bot-login hook.
+    static void FormPersonalityGuilds();
+
+    // Founds ONE themed, personality-driven guild (raid / pvp / casual) on demand
+    // from a FRESH snapshot of the currently-online, guildless random bots. Picks
+    // an archetype weighted by the configured Raid:Pvp:Casual mix, finds an online
+    // guildless leader whose mod-ollama-chat personality is in that archetype's
+    // leader set (>= LeaderMinLevel), creates the guild, then seeds it SMALL (up to
+    // FoundInitialMembers members): elite guilds admit only fit-set same-faction
+    // bots, casual guilds admit any same-faction bot with a join chance. The
+    // ongoing recruiter grows it the rest of the way and lets the real player join.
+    // Returns false if no eligible leader is online. Self-contained; safe to call
+    // repeatedly from a world tick.
+    static bool TryFoundOneGuild();
+
+    // World-thread tick driver for emergent formation: every AiPlayerbot.
+    // PersonalityGuild.FoundIntervalSec, founds one more guild while the number of
+    // random-bot guilds is below AiPlayerbot.PersonalityGuild.TargetCount. Call
+    // every world update.
+    static void UpdateEmergentFounding(uint32 diff);
+};
+
+#endif
