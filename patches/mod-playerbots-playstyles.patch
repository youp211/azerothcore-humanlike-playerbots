+bool ArenaBurstWindowTrigger::IsActive()
+{
+    if (!bot->InArena() || !bot->IsAlive())
+        return false;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetStatus() != STATUS_IN_PROGRESS)
+        return false;
+
+    bool window = false;
+    for (auto const& itr : bg->GetPlayers())
+    {
+        Player* member = ObjectAccessor::FindPlayer(itr.first);
+        if (!member || !member->IsAlive() || member->GetBgTeamId() != bot->GetBgTeamId())
+            continue;
+
+        if (HasBurstAura(member))
+        {
+            window = true;
+            break;
+        }
+    }
+
+    if (!window)
+    {
+        Unit* killTarget = AI_VALUE(Unit*, "arena kill target");
+        window = killTarget && killTarget->GetHealthPct() <= 50.0f;
+    }
+
+    return window != botAI->HasStrategy("boost", BOT_STATE_COMBAT);
+}
