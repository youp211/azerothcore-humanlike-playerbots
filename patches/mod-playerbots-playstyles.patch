+Player* OfferQuestHelpAction::FindQuestHelpTarget(Player* bot, PlayerbotAI* botAI, int& tier)
+{
+    if (!bot->IsAlive() || bot->GetGroup() || bot->InBattleground() || bot->IsInCombat())
+        return nullptr;
+
+    uint32 questId = 0;
+    if (botAI->rpgInfo.GetStatus() == RPG_DO_QUEST)
+        questId = std::get<NewRpgInfo::DoQuest>(botAI->rpgInfo.data).questId;
+
+    GuidVector nearGuids = botAI->GetAiObjectContext()->GetValue<GuidVector>("nearest friendly players")->Get();
+    for (ObjectGuid const& guid : nearGuids)
+    {
+        Player* player = ObjectAccessor::FindPlayer(guid);
+        if (!player || player == bot || !player->IsAlive() || player->GetGroup())
+            continue;
+        if (GET_PLAYERBOT_AI(player))
+            continue; // offer to real players; bots group up via other features
+        if (player->isDND() || player->IsBeingTeleported())
+            continue;
+        if (bot->GetDistance(player) > 30.0f)
+            continue;
+        if (GetBotPlayerSentiment(bot, player) < sPlayerbotAIConfig.questHelpSentimentThreshold)
+            continue;
+
+        if (questId && player->GetQuestStatus(questId) == QUEST_STATUS_INCOMPLETE)
+            tier = 2; // confirmed: same quest in both logs
+        else if (questId)
+            tier = 1; // bot is questing here, can't confirm the player is
+        else
+            tier = 0; // not questing - the rare generic help offer
+        return player;
+    }
+
+    return nullptr;
+}
+
+bool OfferQuestHelpAction::Execute(Event /*event*/)
+{
+    int tier = 0;
+    Player* target = FindQuestHelpTarget(bot, botAI, tier);
+    if (!target)
+        return false;
+
+    std::string situation;
+    if (tier == 2)
+    {
+        uint32 questId = std::get<NewRpgInfo::DoQuest>(botAI->rpgInfo.data).questId;
+        Quest const* quest = sObjectMgr->GetQuestTemplate(questId);
+        std::string title = quest ? quest->GetTitle() : "the same quest";
+        situation = Acore::StringFormat("you and this player are both on the quest '{}'; you're inviting them to group up and finish it faster", title);
+    }
+    else if (tier == 1)
+        situation = "this player is questing near you; you're inviting them to group up";
+    else
+        situation = "you're offering this nearby player a hand with whatever they're doing";
+
+    // in-character invite line via the LLM (falls back silently if chat off)
+    SpeakSituation(bot, target, situation, false);
+    bool invited = Invite(bot, target);
+    if (invited)
+        LOG_DEBUG("playerbots", "[QuestHelp] Bot {} offered quest help to {} (tier {})",
+                  bot->GetName(), target->GetName(), tier);
+    return invited;
+}
