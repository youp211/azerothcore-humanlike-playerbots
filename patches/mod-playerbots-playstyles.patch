@@ -0,0 +1,54 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef PLAYERBOTS_ONGOINGGUILDRECRUIT_H
+#define PLAYERBOTS_ONGOINGGUILDRECRUIT_H
+
+#include "ObjectGuid.h"
+
+#include <map>
+#include <mutex>
+#include <utility>
+
+// Ongoing, opportunistic guild recruitment. Where GuildRecruitmentEvent is a
+// one-shot realm-start push (leaders teleport to the newbie areas for ~15 min),
+// this runs for the whole life of the server as normal bot life happens.
+//
+// Every ~AiPlayerbot.OngoingRecruitIntervalSec, each online random bot that
+// FOUNDED a guild (it is the guild's leader) and has a leader / interactive
+// personality opportunistically sends guild invites to nearby unguilded BOTS
+// and to the nearby unguilded real PLAYER, in its own voice. Elite (raid / pvp)
+// guilds only admit bots whose personality is in the guild's fit-set, preserving
+// exactly the purity invariant PersonalityGuildFactory establishes; casual
+// guilds take anyone. The real player is always archetype-eligible and is gated
+// on the recruiter's sentiment toward them.
+//
+// Driven from the same world-thread tick as GuildRecruitmentEvent; cheap when
+// idle (a single map walk, heavy work throttled to the configured interval).
+class OngoingGuildRecruit
+{
+public:
+    static OngoingGuildRecruit& instance();
+
+    // World-thread tick driver; call every world update. Accumulates diff and
+    // does the bot scan + grid searches only once per configured interval.
+    void Update(uint32 diff);
+
+private:
+    OngoingGuildRecruit() = default;
+
+    void Tick();
+
+    uint32 _accumMs = 0;
+
+    // Per-(recruiter, target) last-invite time in ms (getMSTime) so a target is
+    // not re-spammed within AiPlayerbot.OngoingRecruitCooldownMin. Guarded even
+    // though the driver is world-thread only, mirroring the sibling sentiment /
+    // personality caches this collaborates with.
+    std::mutex _mutex;
+    std::map<std::pair<ObjectGuid, ObjectGuid>, uint32> _lastInvite;
+};
+
+#endif
