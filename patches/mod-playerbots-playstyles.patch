     RpgStatusProbWeight[RPG_OUTDOOR_PVP] = sConfigMgr->GetOption<int32>("AiPlayerbot.RpgStatusProbWeight.OutdoorPvp", 10);
 
+    // Playstyle profiles: per-personality weight tables (personality -> playstyle
+    // mapping lives in mod-ollama-chat's personality templates). Override any
+    // default with AiPlayerbot.RpgStatusProbWeight.<Profile>.<Status>.
+    {
+        struct ProfileDefault { char const* name; char const* confName; uint32 w[RPG_STATUS_END]; };
