diff --git a/src/mod-ollama-chat_events_mail.cpp b/src/mod-ollama-chat_events_mail.cpp
new file mode 100644
index 0000000..0ec0bd0
--- /dev/null
+++ b/src/mod-ollama-chat_events_mail.cpp
@@ -0,0 +1,272 @@
+// mod-ollama-chat_events_mail.cpp
+//
+// Event-driven mail from bots: after a REAL player finishes a quest while
+// grouped with random bots, one of those bots may mail them a small reward
+// (gold or a spare green+ item) with an in-character note. The per-bot chance
+// is driven entirely by the bot's personality (reusing gearGiveChance), scaled
+// down for this passive event. Self-contained: all state and helpers are local
+// to this translation unit.
+
+#include "ScriptMgr.h"
+#include "Player.h"
+#include "Item.h"
+#include "Bag.h"
+#include "Group.h"
+#include "Mail.h"
+#include "ObjectMgr.h"
+#include "ObjectAccessor.h"
+#include "QuestDef.h"
+#include "ItemTemplate.h"
+#include "SharedDefines.h"
+#include "DatabaseEnv.h"
+#include "Random.h"
+#include "Config.h"
+#include "Log.h"
+#include "Common.h"
+#include "Timer.h"
+
+#include "PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+#include "RandomPlayerbotMgr.h"
+
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat_personality.h"
+
+#include <fmt/core.h>
+#include <mutex>
+#include <map>
+#include <utility>
+#include <string>
+#include <algorithm>
+
+// Implemented in mod-ollama-chat_handler.cpp: makes the bot say a short
+// in-character line about the given situation.
+extern void OllamaChat_SpeakSituation(Player*, Player*, std::string const&, bool);
+
+namespace
+{
+
+// --------------------------------------------------------------------------
+// Anti-spam cooldown: at most one event-mail per (bot, player) pair per hour.
+// --------------------------------------------------------------------------
+constexpr uint32 EVENT_MAIL_COOLDOWN_MIN = 60;
+
+std::mutex g_eventMailMutex;
+std::map<std::pair<uint64_t, uint64_t>, uint32> g_lastEventMail;
+
+bool CanEventMailNow(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_eventMailMutex);
+    uint32 now = getMSTime();
+    auto it = g_lastEventMail.find({bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()});
+    if (it != g_lastEventMail.end() && now - it->second < EVENT_MAIL_COOLDOWN_MIN * MINUTE * IN_MILLISECONDS)
+        return false;
+    return true;
+}
+
+void RegisterEventMail(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_eventMailMutex);
+    g_lastEventMail[{bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()}] = getMSTime();
+}
+
+// --------------------------------------------------------------------------
+// Reward helpers.
+// --------------------------------------------------------------------------
+
+// Find a spare, non-soulbound, uncommon-or-better item in the bot's backpack
+// or bags. Skips conjured items and anything the bot has equipped. Returns
+// nullptr if the bot has nothing worth parting with.
+Item* FindSpareItem(Player* bot)
+{
+    Item* best = nullptr;
+    auto consider = [&](Item* item)
+    {
+        if (!item || item->IsSoulBound())
+            return;
+        ItemTemplate const* proto = item->GetTemplate();
+        if (!proto || proto->Quality < ITEM_QUALITY_UNCOMMON || proto->Quality > ITEM_QUALITY_EPIC)
+            return;
+        if (proto->Bonding == BIND_QUEST_ITEM || proto->HasFlag(ITEM_FLAG_CONJURED))
+            return;
+        if (!best || proto->ItemLevel > best->GetTemplate()->ItemLevel)
+            best = item;
+    };
+
+    for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, i));
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (Bag* bag = bot->GetBagByPos(b))
+            for (uint32 s = 0; s < bag->GetBagSize(); ++s)
+                consider(bag->GetItemByPos(s));
+
+    return best;
+}
+
+// Mail a spare item from the bot to the player. Mirrors MailBagItemTo() in
+// mod-ollama-chat_handler.cpp. Returns the item name on success, "" on failure.
+std::string MailItemReward(Player* bot, Player* player, Item* item)
+{
+    if (!item)
+        return "";
+
+    std::string itemName = item->GetTemplate()->Name1;
+
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+
+    item->SetNotRefundable(bot);
+    bot->MoveItemFromInventory(item->GetBagSlot(), item->GetSlot(), true);
+    item->DeleteFromInventoryDB(trans);
+    if (item->GetState() == ITEM_UNCHANGED)
+        item->FSetState(ITEM_CHANGED);
+    item->SetOwnerGUID(player->GetGUID());
+    item->SaveToDB(trans);
+
+    MailDraft draft("A token of thanks", fmt::format("Good adventuring with you out there. Keep this - you earned it. - {}", bot->GetName()));
+    draft.AddItem(item);
+    draft.SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(bot), MAIL_CHECK_MASK_COPIED);
+
+    bot->SaveInventoryAndGoldToDB(trans);
+    CharacterDatabase.CommitTransaction(trans);
+    return itemName;
+}
+
+// Mail gold from the bot to the player (deducted from the bot's purse).
+// Returns a short human description on success, "" on failure.
+std::string MailGoldReward(Player* bot, Player* player, uint32 copper)
+{
+    if (copper == 0 || bot->GetMoney() < copper)
+        return "";
+
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+
+    bot->ModifyMoney(-int32(copper));
+    bot->SaveGoldToDB(trans);
+
+    MailDraft draft("A little something", fmt::format("Thanks for the help on that quest. Here's a bit of coin. - {}", bot->GetName()));
+    draft.AddMoney(copper);
+    draft.SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(bot), MAIL_CHECK_MASK_COPIED);
+
+    CharacterDatabase.CommitTransaction(trans);
+    return fmt::format("{} silver", std::max<uint32>(copper / 100, 1));
+}
+
+// Decide and deliver a reward. Prefers an item ~40% of the time when one is
+// available, otherwise gold. Returns a short description of what was mailed,
+// or "" if nothing could be delivered.
+std::string DeliverReward(Player* bot, Player* player)
+{
+    Item* spare = FindSpareItem(bot);
+
+    // Modest gold scaled to level, capped so it stays "a little something".
+    uint32 gold = std::min<uint32>(uint32(player->GetLevel()) * urand(50, 150), 50000);
+    bool botCanPayGold = gold > 0 && bot->GetMoney() >= gold;
+
+    if (spare && (!botCanPayGold || roll_chance_i(40)))
+    {
+        std::string desc = MailItemReward(bot, player, spare);
+        if (!desc.empty())
+            return desc;
+    }
+
+    if (botCanPayGold)
+    {
+        std::string desc = MailGoldReward(bot, player, gold);
+        if (!desc.empty())
+            return desc;
+    }
+
+    // Last-ditch fallback: if gold failed but an item exists, send the item.
+    if (spare)
+        return MailItemReward(bot, player, spare);
+
+    return "";
+}
+
+} // namespace
+
+// --------------------------------------------------------------------------
+// PlayerScript: reward hook on quest completion.
+// --------------------------------------------------------------------------
+class OllamaChatCompletionMailScript : public PlayerScript
+{
+public:
+    OllamaChatCompletionMailScript() : PlayerScript("OllamaChatCompletionMailScript") { }
+
+    void OnPlayerCompleteQuest(Player* player, Quest const* quest) override
+    {
+        if (!g_Enable || !player || !quest)
+            return;
+
+        if (!sConfigMgr->GetOption<bool>("OllamaChat.EnableEventMail", true))
+            return;
+
+        float mailMultiplier = sConfigMgr->GetOption<float>("OllamaChat.EventMailChanceMultiplier", 0.5f);
+        if (mailMultiplier <= 0.0f)
+            return;
+
+        // Only REAL players get rewarded - never bots.
+        if (PlayerbotsMgr::instance().GetPlayerbotAI(player))
+            return;
+
+        Group* group = player->GetGroup();
+        if (!group)
+            return;
+
+        for (auto const& slot : group->GetMemberSlots())
+        {
+            if (slot.guid == player->GetGUID())
+                continue;
+
+            Player* bot = ObjectAccessor::FindPlayer(slot.guid);
+            if (!bot)
+                continue;
+
+            // Must be a random bot (not a human, not a hand-summoned alt-bot).
+            if (!PlayerbotsMgr::instance().GetPlayerbotAI(bot))
+                continue;
+            if (!sRandomPlayerbotMgr.IsRandomBot(bot))
+                continue;
+
+            // Shared accomplishment: same map and zone as the questing player.
+            if (bot->GetMapId() != player->GetMapId() || bot->GetZoneId() != player->GetZoneId())
+                continue;
+
+            if (!CanEventMailNow(bot, player))
+                continue;
+
+            // Personality-driven chance, scaled down for this passive event.
+            std::string personality = GetBotPersonality(bot);
+            float baseChance = 2.0f;
+            auto it = g_PersonalityTemplates.find(personality);
+            if (it != g_PersonalityTemplates.end())
+                baseChance = it->second.gearGiveChance;
+
+            float effectiveChance = baseChance * mailMultiplier;
+            if (effectiveChance <= 0.0f || !roll_chance_f(effectiveChance))
+                continue;
+
+            // Roll succeeded - try to actually deliver a reward.
+            std::string rewardDesc = DeliverReward(bot, player);
+            if (rewardDesc.empty())
+                continue; // nothing to give; let another member get a chance
+
+            RegisterEventMail(bot, player);
+
+            LOG_INFO("server.loading", "[Ollama Chat] [EventMail] {} mailed {} a reward ({}) for finishing {}",
+                     bot->GetName(), player->GetName(), rewardDesc, quest->GetTitle());
+
+            OllamaChat_SpeakSituation(bot, player,
+                "you just finished a quest together and mailed them a thank-you reward", false);
+
+            break; // only one bot rewards per event
+        }
+    }
+};
+
+// Registration entry point. Call this from Addmod_ollama_chatScripts() in
+// mod-ollama-chat_main.cpp (see registration note reported to the user).
+void AddSC_mod_ollama_chat_events_mail()
+{
+    new OllamaChatCompletionMailScript();
+}
diff --git a/src/mod-ollama-chat_guildnames.cpp b/src/mod-ollama-chat_guildnames.cpp
new file mode 100644
index 0000000..bf2332a
--- /dev/null
+++ b/src/mod-ollama-chat_guildnames.cpp
@@ -0,0 +1,215 @@
+// mod-ollama-chat_guildnames.cpp
+//
+// LLM-generated guild names. When mod-playerbots forms a personality-themed
+// bot guild it starts with a static themed name; right after formation it calls
+// OllamaChat_RenameGuildInVoice (via a weak symbol) so the bot LEADER's
+// personality can invent a better, in-voice name through the local LLM. The
+// generation is fully async and never blocks guild formation.
+//
+// Thread-safety: the LLM query and string sanitizing run on a detached worker
+// thread, which only reads (SubmitQuery, name lookups) and enqueues a result.
+// The actual guild rename touches core guild state, so it is deferred to the
+// world thread: the worker pushes a pending entry, and OllamaChatGuildNameWorldScript::
+// OnUpdate drains the queue and applies renames on the world thread.
+
+#include "mod-ollama-chat_api.h"
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat_personality.h"
+
+#include "Config.h"
+#include "Guild.h"
+#include "GuildMgr.h"
+#include "Log.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "ScriptMgr.h"
+
+#include "PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+
+#include <fmt/core.h>
+#include <algorithm>
+#include <cctype>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    struct PendingGuildRename
+    {
+        uint32 guildId;
+        std::string name;
+        std::string leaderName;
+    };
+
+    // Worker thread pushes here; the world-thread WorldScript below drains it.
+    std::mutex g_GuildNameQueueMutex;
+    std::vector<PendingGuildRename> g_GuildNameQueue;
+
+    // Turn a raw model response into a clean, single-line guild name: keep only
+    // the first line, strip surrounding whitespace/quotes/punctuation, collapse
+    // internal whitespace runs, and hard-cap at the WoW client's 24-char limit.
+    // Title-casing is intentionally not applied.
+    std::string SanitizeGuildName(std::string s)
+    {
+        // Some models prefix ("Sure! ") or append an explanation on a new line;
+        // keep only the first line.
+        if (size_t nl = s.find_first_of("\r\n"); nl != std::string::npos)
+            s = s.substr(0, nl);
+
+        auto isEdgeJunk = [](unsigned char c) -> bool
+        {
+            return std::isspace(c) || c == '"' || c == '\'' || c == '.' || c == ',' || c == '!' ||
+                   c == '?' || c == ':' || c == ';' || c == '`' || c == '*' || c == '(' || c == ')' ||
+                   c == '[' || c == ']' || c == '-' || c == '_';
+        };
+
+        size_t begin = 0;
+        size_t end = s.size();
+        while (begin < end && isEdgeJunk(static_cast<unsigned char>(s[begin])))
+            ++begin;
+        while (end > begin && isEdgeJunk(static_cast<unsigned char>(s[end - 1])))
+            --end;
+        s = s.substr(begin, end - begin);
+
+        // Collapse internal whitespace runs to a single space.
+        std::string out;
+        out.reserve(s.size());
+        bool prevSpace = false;
+        for (char ch : s)
+        {
+            if (std::isspace(static_cast<unsigned char>(ch)))
+            {
+                if (!prevSpace && !out.empty())
+                    out.push_back(' ');
+                prevSpace = true;
+            }
+            else
+            {
+                out.push_back(ch);
+                prevSpace = false;
+            }
+        }
+
+        // WoW client guild-name limit is 24 characters; do not leave a dangling
+        // space after a hard cut.
+        if (out.size() > 24)
+        {
+            out.resize(24);
+            while (!out.empty() && std::isspace(static_cast<unsigned char>(out.back())))
+                out.pop_back();
+        }
+
+        return out;
+    }
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// Weak-symbol entry point called from mod-playerbots (same binary) right after
+// a personality guild is formed. Fire-and-forget: async, never blocks the
+// caller. Non-static so the weak extern in PersonalityGuildFactory.cpp binds.
+// ---------------------------------------------------------------------------
+void OllamaChat_RenameGuildInVoice(Player* leader, uint32 guildId, std::string const& archetype)
+{
+    if (!g_Enable || !leader || !guildId)
+        return;
+
+    if (!sConfigMgr->GetOption<bool>("OllamaChat.EnableGuildNameGen", true))
+        return;
+
+    PlayerbotAI* botAI = PlayerbotsMgr::instance().GetPlayerbotAI(leader);
+    if (!botAI)
+        return;
+
+    std::string personality       = GetBotPersonality(leader);
+    std::string personalityPrompt = GetPersonalityPromptAddition(personality);
+    std::string botClass =
+        botAI->GetChatHelper() ? botAI->GetChatHelper()->FormatClass(leader->getClass()) : "adventurer";
+    std::string leaderName        = leader->GetName();
+
+    std::string prompt = fmt::format(
+        "You're a Wrath-era WoW player. Name: {}, a level {} {}. "
+        "MAKE SURE YOU RESPOND USING YOUR PERSONALITY, WHICH IS: {}: {}. "
+        "You just founded a {} guild. Invent its name: a memorable 2008-era WoW guild name, "
+        "2 to 4 words, plain text, no quotes, nothing else.",
+        leaderName, leader->GetLevel(), botClass, personality, personalityPrompt, archetype);
+
+    // Nudge temperature up a touch so guild names come out more varied/creative
+    // than ordinary chat lines.
+    OllamaQueryOptions opts = GetPersonalityQueryOptions(leader);
+    float baseTemp = (opts.temperatureOverride >= 0.0f) ? opts.temperatureOverride : g_OllamaTemperature;
+    opts.temperatureOverride = std::min(baseTemp + 0.15f, 1.5f);
+
+    std::thread([guildId, prompt, opts, leaderName]()
+    {
+        try
+        {
+            std::future<std::string> fut = SubmitQuery(prompt, opts);
+            if (!fut.valid())
+                return;
+
+            std::string name = SanitizeGuildName(fut.get());
+            if (name.size() < 3)  // empty or too short to be a real guild name
+                return;
+            if (sObjectMgr->IsReservedName(name) || sObjectMgr->IsProfanityName(name))
+                return;
+            if (sGuildMgr->GetGuildByName(name))  // taken already: keep the themed name
+                return;
+
+            std::lock_guard<std::mutex> lock(g_GuildNameQueueMutex);
+            g_GuildNameQueue.push_back(PendingGuildRename{guildId, std::move(name), leaderName});
+        }
+        catch (...)
+        {
+        }
+    }).detach();
+}
+
+// ---------------------------------------------------------------------------
+// Drains pending renames on the world thread and applies them via the same
+// sequence the ".guild rename" command uses (uniqueness check + Guild::SetName,
+// which validates the name and persists it to the characters DB).
+// ---------------------------------------------------------------------------
+class OllamaChatGuildNameWorldScript : public WorldScript
+{
+public:
+    OllamaChatGuildNameWorldScript() : WorldScript("OllamaChatGuildNameWorldScript") { }
+
+    void OnUpdate(uint32 /*diff*/) override
+    {
+        std::vector<PendingGuildRename> pending;
+        {
+            std::lock_guard<std::mutex> lock(g_GuildNameQueueMutex);
+            if (g_GuildNameQueue.empty())
+                return;
+            pending.swap(g_GuildNameQueue);
+        }
+
+        for (PendingGuildRename const& entry : pending)
+        {
+            Guild* guild = sGuildMgr->GetGuildById(entry.guildId);
+            if (!guild)
+                continue;
+
+            // Re-check uniqueness on the world thread: another guild could have
+            // taken the name between the worker's check and now.
+            if (sGuildMgr->GetGuildByName(entry.name))
+                continue;
+
+            if (!guild->SetName(entry.name))
+                continue;
+
+            LOG_INFO("server.loading", "[Ollama Chat] [GuildName] renamed guild {} -> '{}' (leader {})",
