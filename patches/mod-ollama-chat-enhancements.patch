+// Give cooldowns: a bot gives at most once per g_GearGiveBotCooldownMin, and
+// never twice to the same player within g_GearGivePairCooldownMin.
+static std::mutex g_gearGiveMutex;
+static std::unordered_map<uint64_t, uint32> g_lastGiveByBot;
+static std::map<std::pair<uint64_t, uint64_t>, uint32> g_lastGiveByPair;
+
+static bool CanGiveGearNow(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_gearGiveMutex);
+    uint32 now = getMSTime();
+    auto b = g_lastGiveByBot.find(bot->GetGUID().GetRawValue());
+    if (b != g_lastGiveByBot.end() && now - b->second < g_GearGiveBotCooldownMin * MINUTE * IN_MILLISECONDS)
+        return false;
+    auto p = g_lastGiveByPair.find({bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()});
+    if (p != g_lastGiveByPair.end() && now - p->second < g_GearGivePairCooldownMin * MINUTE * IN_MILLISECONDS)
+        return false;
+    return true;
+}
+
+static void RegisterGearGive(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_gearGiveMutex);
+    uint32 now = getMSTime();
+    g_lastGiveByBot[bot->GetGUID().GetRawValue()] = now;
+    g_lastGiveByPair[{bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()}] = now;
+}
+
+// Gear COMMENTARY throttle: the inspect block only enters the prompt
+// occasionally per pair, so bots don't turn every conversation into a gear
+// review ("wanna group?" -> "nice belt"). Give events bypass this - an item
+// actually sent/parked must always be announced.
+static std::mutex g_gearCtxMutex;
+static std::map<std::pair<uint64_t, uint64_t>, uint32> g_lastGearCtxByPair;
+
+static bool GearCommentaryAllowed(Player* bot, Player* player)
+{
+    uint32 cooldownMin = sConfigMgr->GetOption<uint32>("OllamaChat.GearContextCooldownMin", 10);
+    std::lock_guard<std::mutex> lock(g_gearCtxMutex);
+    uint32 now = getMSTime();
+    auto key = std::make_pair(bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue());
+    auto it = g_lastGearCtxByPair.find(key);
+    if (it != g_lastGearCtxByPair.end() && now - it->second < cooldownMin * MINUTE * IN_MILLISECONDS)
+        return false;
+    g_lastGearCtxByPair[key] = now;
+    return true;
+}
+
+// Actually hand the item over: mail it from the bot to the player (COD for
+// seller personalities). Mirrors the core's HandleSendMail item transfer.
+static bool MailBagItemTo(Player* bot, Player* player, Item* item, uint32 codCopper)
+{
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+
+    item->SetNotRefundable(bot);
+    bot->MoveItemFromInventory(item->GetBagSlot(), item->GetSlot(), true);
+    item->DeleteFromInventoryDB(trans);
+    if (item->GetState() == ITEM_UNCHANGED)
+        item->FSetState(ITEM_CHANGED);
+    item->SetOwnerGUID(player->GetGUID());
+    item->SaveToDB(trans);
+
+    MailDraft draft(item->GetTemplate()->Name1, codCopper ? "Pay the man." : "From one adventurer to another.");
+    draft.AddItem(item);
+    draft.AddCOD(codCopper);
+    draft.SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(bot), MAIL_CHECK_MASK_COPIED);
+
+    bot->SaveInventoryAndGoldToDB(trans);
+    CharacterDatabase.CommitTransaction(trans);
+    return true;
+}
+
+// "Inspect" context for the {gear_context} placeholder: the player's weakest
+// armor slot plus class-stat knowledge. If the bot carries a tradeable
+// upgrade AND its personality's gear_give_chance roll succeeds (respecting
+// cooldowns), the item is ACTUALLY MAILED and the prompt says so - the bot
+// never talks about items it isn't really handing over.
+static std::string GenerateGearContext(Player* bot, Player* player)
+{
+    static char const* slotNames[EQUIPMENT_SLOT_END] = {
+        "head", "neck", "shoulders", "shirt", "chest", "waist", "legs", "feet", "wrists", "hands",
+        "ring", "ring", "trinket", "trinket", "cloak", "main hand", "off hand", "ranged", "tabard"};
+
+    uint32 worstIlvl = 0xFFFFFFFF;
+    uint8 worstSlot = 255;
+    uint32 epicCount = 0;
+    uint32 resilienceCount = 0;
+    bool hasSetPiece = false;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        switch (slot)
+        {
+            case EQUIPMENT_SLOT_HEAD: case EQUIPMENT_SLOT_SHOULDERS: case EQUIPMENT_SLOT_CHEST:
+            case EQUIPMENT_SLOT_WAIST: case EQUIPMENT_SLOT_LEGS: case EQUIPMENT_SLOT_FEET:
+            case EQUIPMENT_SLOT_WRISTS: case EQUIPMENT_SLOT_HANDS: case EQUIPMENT_SLOT_BACK:
+                break;
+            default:
+                continue; // armor slots only - weapons/jewelry are another conversation
+        }
+        Item* item = player->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+        uint32 ilvl = item ? item->GetTemplate()->ItemLevel : 0;
+        if (ilvl < worstIlvl)
+        {
+            worstIlvl = ilvl;
+            worstSlot = slot;
+        }
+        if (item)
+        {
+            ItemTemplate const* proto = item->GetTemplate();
+            if (proto->Quality >= ITEM_QUALITY_EPIC)
+                ++epicCount;
+            if (proto->ItemSet)
+                hasSetPiece = true;
+            for (uint32 s = 0; s < proto->StatsCount; ++s)
+                if (proto->ItemStat[s].ItemStatType == ITEM_MOD_RESILIENCE_RATING && proto->ItemStat[s].ItemStatValue > 0)
+                {
+                    ++resilienceCount;
+                    break;
+                }
+        }
+    }
+    if (worstSlot == 255)
+        return "";
+
+    // Well-geared players get recognition, not upgrade nagging - a 2008 player
+    // would know raid sets and PvP gear on sight. Commentary-only, so it is
+    // throttled per pair.
+    if (worstIlvl > 0 && worstIlvl >= player->GetLevel())
+    {
+        if (!GearCommentaryAllowed(bot, player))
+            return "";
+        if (resilienceCount >= 4)
+            return fmt::format("(You inspected {}: they are wearing serious PvP resilience gear - not someone to lecture about gear.)",
+                               player->GetName());
+        if (epicCount >= 5)
+            return fmt::format("(You inspected {}: they are decked in epic raid gear{} - nothing you carry comes close.)",
+                               player->GetName(), hasSetPiece ? ", set pieces and all" : "");
+        return fmt::format("(You inspected {}: their gear is solid for their level - no weak spots worth mentioning.)",
+                           player->GetName());
+    }
+
+    Item* offer = nullptr;
+    uint32 maxSub = MaxArmorSubclass(player->getClass(), player->GetLevel());
+    auto consider = [&](Item* item)
+    {
+        if (!item || item->IsSoulBound())
+            return;
+        ItemTemplate const* proto = item->GetTemplate();
+        if (proto->Class != ITEM_CLASS_ARMOR || proto->SubClass == ITEM_SUBCLASS_ARMOR_MISC ||
+            proto->SubClass > maxSub)
+            return;
+        if (proto->RequiredLevel > player->GetLevel() || proto->ItemLevel <= worstIlvl + 1)
+            return;
+        if (!offer || proto->ItemLevel > offer->GetTemplate()->ItemLevel)
+            offer = item;
+    };
+    for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, i));
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (Bag* bag = bot->GetBagByPos(b))
+            for (uint32 s = 0; s < bag->GetBagSize(); ++s)
+                consider(bag->GetItemByPos(s));
+
+    std::string ctx = fmt::format(
+        "(You inspected {}: their weakest piece is the {} ({}). As a class they want {}.",
+        player->GetName(), slotNames[worstSlot],
+        worstIlvl == 0 ? std::string("empty") : fmt::format("item level {}", worstIlvl),
+        ClassPrimaryStat(player->getClass()));
+
+    bool gaveSomething = false;
+    if (offer)
+    {
+        std::string personality = GetBotPersonality(bot);
+        float giveChance = 2.0f;
+        auto it = g_PersonalityTemplates.find(personality);
+        if (it != g_PersonalityTemplates.end())
+            giveChance = it->second.gearGiveChance;
+
+        if (giveChance > 0.0f && CanGiveGearNow(bot, player) && roll_chance_f(giveChance))
+        {
+            uint32 cod = IsGearSeller(personality)
+                ? std::max<uint32>(offer->GetTemplate()->SellPrice * 4, 500)
+                : 0;
+            std::string itemName = offer->GetTemplate()->Name1;
+
+            // Mail requires a relationship: same guild, or currently grouped
+            // (helping on a quest/dungeon/raid together). Strangers get the
+            // item handed over in person - a pending give that completes when
+            // the player opens a trade window with the bot (see
+            // TradeStatusAction in mod-playerbots).
+            bool mailEligible = (bot->GetGuildId() && bot->GetGuildId() == player->GetGuildId()) ||
+                                (bot->GetGroup() && bot->GetGroup()->IsMember(player->GetGUID()));
+            if (mailEligible)
+            {
+                if (MailBagItemTo(bot, player, offer, cod))
+                {
+                    RegisterGearGive(bot, player);
+                    if (cod)
+                        ctx += fmt::format(" You just mailed them your {} with a {} silver COD - tell them to check their mailbox and pay up.",
+                                           itemName, cod / 100);
+                    else
+                        ctx += fmt::format(" You just mailed them your {} as a gift - tell them to check their mailbox.",
+                                           itemName);
+                    LOG_INFO("server.loading", "[Ollama Chat] [GearGive] {} ({}) mailed {} to {} (COD {} copper)",
+                             bot->GetName(), personality, itemName, player->GetName(), cod);
+                    gaveSomething = true;
+                }
+            }
+            else
+            {
+                CharacterDatabase.Execute(
+                    "REPLACE INTO mod_ollama_chat_pending_gives (bot_guid, player_guid, item_guid, cod) VALUES ({}, {}, {}, {})",
+                    bot->GetGUID().GetCounter(), player->GetGUID().GetCounter(),
+                    offer->GetGUID().GetCounter(), cod);
+                RegisterGearGive(bot, player);
+                if (cod)
+                    ctx += fmt::format(" You have a {} for them - tell them to open trade with you to buy it for {} silver.",
+                                       itemName, cod / 100);
+                else
+                    ctx += fmt::format(" You have a {} for them - tell them to open trade with you and you'll hand it over.",
+                                       itemName);
+                LOG_INFO("server.loading", "[Ollama Chat] [GearGive] {} ({}) parked {} for in-person trade with {} (cod {} copper)",
+                         bot->GetName(), personality, itemName, player->GetName(), cod);
+                gaveSomething = true;
+            }
+        }
+        // roll failed: say nothing about the item - no empty promises
+    }
+
+    // A real give must always be announced; plain gear commentary is
+    // throttled so bots answer what was actually said instead of reviewing
+    // your outfit every message.
+    if (!gaveSomething && !GearCommentaryAllowed(bot, player))
+        return "";
+
+    ctx += ")";
+    return ctx;
+}
