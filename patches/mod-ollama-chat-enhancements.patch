+    uint64_t bGuid = b->GetGUID().GetRawValue();
+
+    // Symmetric: adjust each side's view of the other (clamping happens in the setter)
+    SetBotPlayerSentiment(aGuid, bGuid, GetBotPlayerSentiment(aGuid, bGuid) + delta);
+    SetBotPlayerSentiment(bGuid, aGuid, GetBotPlayerSentiment(bGuid, aGuid) + delta);
