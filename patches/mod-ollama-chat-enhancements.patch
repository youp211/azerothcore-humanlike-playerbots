     }
 }
+
+float GetPersonalityReplyChanceMultiplier(const std::string& personality)
+{
+    auto it = g_PersonalityTemplates.find(personality);
+    if (it != g_PersonalityTemplates.end())
+        return it->second.replyChanceMultiplier;
+    return 1.0f;
+}
+
+OllamaQueryOptions GetPersonalityQueryOptions(Player* bot)
+{
+    OllamaQueryOptions opts;
+    if (!bot)
+        return opts;
+
+    auto it = g_PersonalityTemplates.find(GetBotPersonality(bot));
+    if (it != g_PersonalityTemplates.end())
+    {
+        opts.numPredictOverride  = it->second.numPredictOverride;
+        opts.temperatureOverride = it->second.temperatureOverride;
+    }
+    return opts;
+}
