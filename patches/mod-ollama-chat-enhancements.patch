+// at the mod-playerbots call sites, bound with [[gnu::weak]] so the call is a
+// harmless no-op when this chat module is absent or sentiment tracking is off.
+//
+// GetSentiment returns the live in-memory value (fresher than the periodic DB
+// flush) and a negative sentinel when sentiment is unavailable, so the caller
+// can distinguish "unknown" from a genuine neutral 0.5.
+// ---------------------------------------------------------------------------
+float OllamaChat_GetSentiment(Player* bot, Player* player)
+{
+    if (!g_Enable || !g_EnableSentimentTracking || !bot || !player)
+        return -1.0f;  // sentinel: caller treats < 0 as "sentiment unavailable"
+    return GetBotPlayerSentiment(bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue());
+}
+
+void OllamaChat_NudgeSentiment(Player* bot, Player* player, float delta)
+{
+    if (!g_Enable || !g_EnableSentimentTracking || !bot || !player || delta == 0.0f)
+        return;
+    NudgeSentimentPair(bot, player, delta);
+}
