+
+void SentimentOnGroup::OnAddMember(Group* group, ObjectGuid guid)
+{
+    if (!group || !g_EnableSentimentTracking || g_SentimentEventGroupAdjustment == 0.0f)
+        return;
+
+    Player* newMember = ObjectAccessor::FindPlayer(guid);
+    if (!newMember)
+        return;
+
+    // Grouping together warms mutual sentiment with every existing member
+    for (auto const& slot : group->GetMemberSlots())
+    {
+        if (slot.guid == guid)
+            continue;
+
+        if (Player* member = ObjectAccessor::FindPlayer(slot.guid))
+        {
+            NudgeSentimentPair(newMember, member, g_SentimentEventGroupAdjustment);
+        }
+    }
+}
