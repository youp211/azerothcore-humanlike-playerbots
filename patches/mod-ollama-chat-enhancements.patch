+#ifndef MOD_OLLAMA_CHAT_GROUPJOIN_H
+#define MOD_OLLAMA_CHAT_GROUPJOIN_H
+
+#include <string>
+#include <cstdint>
+
+class Player;
+
+// ---------------------------------------------------------------------------
+// Group-join-on-request + addressee disambiguation.
+//
+// When a real player nearby asks to be invited/grouped/helped, a bot may send
+// a REAL group invite (gated by personality/playstyle/sentiment). When it is
+// ambiguous which of several nearby bots was addressed, bots ask "who, me?" in
+// their own voice, at staggered times, instead of all inviting at once.
+// ---------------------------------------------------------------------------
+
+// Result of evaluating a possible "invite me / group up" request.
+enum class GroupJoinOutcome
+{
+    NotAGroupRequest,   // not a group request - fall through to the normal chat flow
+    AskWhoMe,           // ambiguous addressee - bot asks whether the player meant it
+    Invited,            // bot sent the player a real group invite
+    Declined            // bot refused to group up
+};
+
+// True if the message reads like a request to be invited / grouped / helped.
+// Simple, tunable keyword list (see the .cpp for the exact patterns).
+bool LooksLikeGroupRequest(std::string const& msg);
+
+// Personality/playstyle/sentiment-weighted chance (clamped 5..95) that this
+// bot agrees to group up with the given player.
+float GroupJoinChanceFor(Player* bot, Player* player);
+
+// Pending "who, me?" disambiguation bookkeeping (60s TTL).
+void RegisterWhoMe(Player* bot, Player* player);
+bool HasPendingWhoMe(Player* bot, Player* player);
+void ClearWhoMe(Player* bot, Player* player);
+
+// Decision routine, called by the chat handler for each candidate bot BEFORE
+// the normal prompt is built. Runs on the world thread. On Invited it sends the
+// real group-invite packet immediately. `outExtraContext` receives a short
+// directive to append to the bot's prompt (empty for NotAGroupRequest).
+// `candidateBotsInRange` is how many bots are about to reply (1 == unambiguous).
+GroupJoinOutcome EvaluateGroupRequest(Player* bot, Player* player, std::string const& msg,
+                                      uint32_t candidateBotsInRange, std::string& outExtraContext);
+
+#endif // MOD_OLLAMA_CHAT_GROUPJOIN_H
