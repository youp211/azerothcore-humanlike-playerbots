diff --git a/src/mod-ollama-chat_memory.cpp b/src/mod-ollama-chat_memory.cpp
new file mode 100644
index 0000000..573b0da
--- /dev/null
+++ b/src/mod-ollama-chat_memory.cpp
@@ -0,0 +1,244 @@
+// mod-ollama-chat_memory.cpp
+//
+// Bot event-memory subsystem: a random bot keeps a small, bounded set of
+// structured memories about a REAL, currently-guilded player and references
+// them in chat via {memory_info}. See mod-ollama-chat_memory.h for the design
+// rationale. NO record-time LLM calls happen here -- memories are plain
+// structured rows; the recall text is assembled cheaply from those rows.
+
+#include "mod-ollama-chat_memory.h"
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat-utilities.h"
+
+#include "ScriptMgr.h"
+#include "Player.h"
+#include "Guild.h"
+#include "Battleground.h"
+#include "SharedDefines.h"
+#include "DatabaseEnv.h"
+#include "Log.h"
+
+#include "PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+#include "RandomPlayerbotMgr.h"
+
+#include <fmt/core.h>
+#include <array>
+#include <vector>
+#include <string>
+
+// Resolve a human-readable zone name from a bot's current position. The bot is
+// always a random bot here, so its PlayerbotAI is available.
+static std::string ResolveBotZoneName(Player* bot)
+{
+    if (PlayerbotAI* ai = PlayerbotsMgr::instance().GetPlayerbotAI(bot))
+    {
+        if (AreaTableEntry const* zone = ai->GetCurrentZone())
+            return PlayerbotAI::GetLocalizedAreaName(zone);
+    }
+    return "";
+}
+
+void RecordMemory(Player* bot, Player* player, std::string const& eventType, std::string const& detail)
+{
+    if (!g_Enable || !g_EnableEventMemory || !bot || !player || bot == player)
+        return;
+
+    // Guilded-players-only: this is the storage boundary. We never keep memories
+    // about players who are not in a guild.
+    if (player->GetGuildId() == 0)
+        return;
+
+    // The rememberer must be a random bot; the remembered side must be a real
+    // player. Bots do not keep memories about other bots.
+    if (!PlayerbotsMgr::instance().GetPlayerbotAI(bot) || !sRandomPlayerbotMgr.IsRandomBot(bot))
+        return;
+    if (PlayerbotsMgr::instance().GetPlayerbotAI(player))
+        return;
+
+    uint64_t botGuid    = bot->GetGUID().GetRawValue();
+    uint64_t playerGuid = player->GetGUID().GetRawValue();
+
+    // Escape the free-text fields before they touch the query string.
+    std::string safeType   = eventType;
+    std::string safeDetail = detail;
+    std::string safeZone   = ResolveBotZoneName(bot);
+    CharacterDatabase.EscapeString(safeType);
+    CharacterDatabase.EscapeString(safeDetail);
+    CharacterDatabase.EscapeString(safeZone);
+
+    CharacterDatabase.Execute(SafeFormat(
+        "INSERT INTO mod_ollama_chat_event_memories (bot_guid, player_guid, event_type, detail, zone) "
+        "VALUES ({}, {}, '{}', '{}', '{}')",
+        botGuid, playerGuid, safeType, safeDetail, safeZone));
+
+    // Bounded: keep only the newest g_EventMemoryMaxPerPair rows for this pair,
+    // pruning oldest-first. id is AUTO_INCREMENT so it orders by insert time.
+    if (g_EventMemoryMaxPerPair > 0)
+    {
+        CharacterDatabase.Execute(SafeFormat(
+            "DELETE FROM mod_ollama_chat_event_memories "
+            "WHERE bot_guid = {} AND player_guid = {} AND id NOT IN "
+            "(SELECT id FROM (SELECT id FROM mod_ollama_chat_event_memories "
+            "WHERE bot_guid = {} AND player_guid = {} ORDER BY id DESC LIMIT {}) AS keep)",
+            botGuid, playerGuid, botGuid, playerGuid, g_EventMemoryMaxPerPair));
+    }
+
+    if (g_DebugEnabled)
+    {
+        LOG_INFO("server.loading", "[OllamaChat] Recorded memory: bot {} remembers {} - {} ({}) in {}",
+                 bot->GetName(), player->GetName(), eventType, detail, safeZone);
+    }
+}
+
+void RecordMemoryForPair(Player* a, Player* b, std::string const& eventType, std::string const& detail)
+{
+    if (!g_EnableEventMemory || !a || !b || a == b)
+        return;
+
+    bool aIsBot = PlayerbotsMgr::instance().GetPlayerbotAI(a) != nullptr;
+    bool bIsBot = PlayerbotsMgr::instance().GetPlayerbotAI(b) != nullptr;
+
+    // Exactly one side must be a bot (the rememberer); the other is the real
+    // player it remembers. RecordMemory re-validates random-bot + guilded.
+    if (aIsBot && !bIsBot)
+        RecordMemory(a, b, eventType, detail);
+    else if (bIsBot && !aIsBot)
+        RecordMemory(b, a, eventType, detail);
+}
+
+std::string BuildMemoryInfo(Player* bot, Player* player)
+{
+    if (!g_Enable || !g_EnableEventMemory || !bot || !player)
+        return "";
+
+    uint64_t botGuid    = bot->GetGUID().GetRawValue();
+    uint64_t playerGuid = player->GetGUID().GetRawValue();
+
+    // Keep the recall short: at most 4 most-recent memories so the prompt stays
+    // compact.
+    QueryResult result = CharacterDatabase.Query(SafeFormat(
+        "SELECT detail, zone FROM mod_ollama_chat_event_memories "
+        "WHERE bot_guid = {} AND player_guid = {} ORDER BY id DESC LIMIT 4",
+        botGuid, playerGuid));
+
+    if (!result)
+        return "";
+
+    std::vector<std::string> parts;
+    do
+    {
+        Field* fields   = result->Fetch();
+        std::string det = fields[0].Get<std::string>();
+        std::string zn  = fields[1].Get<std::string>();
+        if (det.empty())
+            continue;
+        if (!zn.empty())
+            parts.push_back(SafeFormat("{} in {}", det, zn));
+        else
+            parts.push_back(det);
+    } while (result->NextRow());
+
+    if (parts.empty())
+        return "";
+
+    std::string joined;
+    for (size_t i = 0; i < parts.size(); ++i)
+    {
+        joined += parts[i];
+        if (i + 1 < parts.size())
+            joined += "; ";
+    }
+
+    return SafeFormat(
+        "You recently: {}. Reference this shared history with {} naturally if it fits.",
+        joined, player->GetName());
+}
+
+void PurgePlayerMemories(uint64_t playerGuid)
+{
+    CharacterDatabase.Execute(SafeFormat(
+        "DELETE FROM mod_ollama_chat_event_memories WHERE player_guid = {}", playerGuid));
+}
+
+// --------------------------------------------------------------------------
+// GuildScript: when a player leaves (or is removed from) a guild, purge every
+// memory about them. This is what keeps storage bounded to guilded players.
+// --------------------------------------------------------------------------
+class OllamaChatMemoryGuildScript : public GuildScript
+{
+public:
+    OllamaChatMemoryGuildScript() : GuildScript("OllamaChatMemoryGuildScript") { }
+
+    void OnRemoveMember(Guild* /*guild*/, Player* player, bool /*isDisbanding*/, bool /*isKicked*/) override
+    {
+        if (!g_EnableEventMemory || !player)
+            return;
+
+        PurgePlayerMemories(player->GetGUID().GetRawValue());
+    }
+};
+
+// --------------------------------------------------------------------------
+// BGScript: on arena/battleground end, every random bot records a memory about
+// each REAL teammate it just shared the match with. This is the memory behind
+// the driving example -- a player finishes an arena on the bot's team, then
+// flames the bot, and the bot recalls it just played an arena with them.
+// --------------------------------------------------------------------------
+class OllamaChatMemoryBGScript : public BGScript
+{
+public:
+    OllamaChatMemoryBGScript() : BGScript("OllamaChatMemoryBGScript") { }
+
+    void OnBattlegroundEnd(Battleground* bg, TeamId /*winnerTeamId*/) override
+    {
+        if (!g_Enable || !g_EnableEventMemory || !bg)
+            return;
+
+        bool isArena          = bg->isArena();
+        std::string eventType = isArena ? "arena" : "battleground";
+        std::string detail    = isArena ? "were on an arena team with them"
+                                        : "fought alongside them in a battleground";
+
+        // Split the roster by team into real players and random bots.
+        std::array<std::vector<Player*>, PVP_TEAMS_COUNT> realPlayers;
+        std::array<std::vector<Player*>, PVP_TEAMS_COUNT> bots;
+
+        for (auto const& pair : bg->GetPlayers())
+        {
+            Player* p = pair.second;
+            if (!p || !p->IsInWorld())
+                continue;
+
+            TeamId team = p->GetBgTeamId();
+            if (team != TEAM_ALLIANCE && team != TEAM_HORDE)
+                continue;
+
+            if (PlayerbotsMgr::instance().GetPlayerbotAI(p))
+            {
+                if (sRandomPlayerbotMgr.IsRandomBot(p))
+                    bots[team].push_back(p);
+            }
+            else
+            {
+                realPlayers[team].push_back(p);
+            }
+        }
+
+        // Each bot remembers each real teammate it fought alongside.
+        for (uint8 team = 0; team < PVP_TEAMS_COUNT; ++team)
+        {
+            for (Player* bot : bots[team])
+                for (Player* player : realPlayers[team])
+                    RecordMemory(bot, player, eventType, detail);
+        }
+    }
+};
+
+// Registration entry point. Call this from Addmod_ollama_chatScripts() in
+// mod-ollama-chat_main.cpp (see the registration note reported to the user).
+void AddSC_mod_ollama_chat_memory()
+{
+    new OllamaChatMemoryGuildScript();
+    new OllamaChatMemoryBGScript();
+}
