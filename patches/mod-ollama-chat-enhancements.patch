+# A kill is a gank only if the victim is at least this many levels below killer.
+OllamaChat.PvpGankLevelGap = 10
+# Base spoken-reaction chances (0..100), each scaled by personality talkativeness.
+OllamaChat.PvpRescueVoiceChance = 50.0
+OllamaChat.PvpKillVoiceChance = 25.0
+OllamaChat.PvpGankVoiceChance = 20.0
+# Chance a rescued guild-leader bot voices an on-the-spot guild pitch to a real
+# player (the actual invite still flows through the ongoing recruiter).
+OllamaChat.PvpBuddyGuildChance = 25.0
