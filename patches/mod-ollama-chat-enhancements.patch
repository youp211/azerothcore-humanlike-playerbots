diff --git a/src/mod-ollama-chat_pvp.cpp b/src/mod-ollama-chat_pvp.cpp
new file mode 100644
index 0000000..00cb59e
--- /dev/null
+++ b/src/mod-ollama-chat_pvp.cpp
@@ -0,0 +1,416 @@
+// mod-ollama-chat_pvp.cpp
+//
+// PvP appreciation / friendship. See mod-ollama-chat_pvp.h for the design.
+// On any player's PvP kill of an enemy-faction foe (the killer may be a real
+// player OR a bot), nearby friendly random bots that were fighting react:
+//   * honorable kill  -> small RESPECT bump toward the killer (+ a memory);
+//   * a SAVE (killer downs the enemy that was about to kill a low-HP friendly
+//     bot) -> a much larger respect bump, a remembered rescue, a grateful line;
+//   * an unprovoked GANK of a much-lower-level foe -> witnesses LOSE respect.
+// Respect (sentiment) and memory ALWAYS update -- that is the quiet history that
+// shapes who ends up wanting to guild with whom. SPEAKING is the optional,
+// personality-driven part: only a chatty personality actually pipes up (the
+// egirl gushes, the arena elitist grunts "good work", the quiet noob says
+// nothing), and only when a real player is close enough to hear it -- so
+// bot-vs-bot skirmishing never wakes the LLM. Because rising respect already
+// gates guild invites, quest help and gear gives elsewhere, good PvP play
+// organically earns friendship and, over time, guild spots.
+//
+// The SERVER does the sentiment/memory work; every spoken line is generated by
+// the model from explicit fight context via OllamaChat_SpeakSituation -- nothing
+// is hardcoded dialogue.
+
+#include "ScriptMgr.h"
+#include "Player.h"
+#include "Guild.h"
+#include "ObjectAccessor.h"
+#include "SharedDefines.h"
+#include "Config.h"
+#include "Random.h"
+#include "Timer.h"
+#include "Common.h"
+#include "Log.h"
+
+#include "PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+#include "RandomPlayerbotMgr.h"
+
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat_sentiment.h"
+#include "mod-ollama-chat_memory.h"
+#include "mod-ollama-chat_personality.h"
+#include "mod-ollama-chat-utilities.h"
+
+#include <mutex>
+#include <map>
+#include <utility>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+// Implemented in mod-ollama-chat_handler.cpp: makes the bot say/whisper a short
+// in-character line about the given situation. Same-module, so a plain extern.
+extern void OllamaChat_SpeakSituation(Player*, Player*, std::string const&, bool);
+
+namespace
+{
+
+// Everyone in the fight should feel it, but keep the per-kill work bounded: a
+// generous cap that still covers a couple of full parties brawling together.
+constexpr uint32 PVP_MAX_APPRECIATE_BOTS = 10;
+
+// Per-(bot, player) sentiment cooldown so a farm of kills can't spam a bot's
+// standing. One nudge per pair per this window; the rescue (which fires first)
+// claims the window, so a rescued bot gets the big bump, not the small one.
+constexpr uint32 PVP_NUDGE_COOLDOWN_SEC = 120;
+
+std::mutex g_pvpNudgeMutex;
+std::map<std::pair<uint64_t, uint64_t>, uint32> g_lastPvpNudge;
+
+// Returns true (and stamps the pair) if this (bot, player) pair is off cooldown;
+// false if a nudge for the pair happened within PVP_NUDGE_COOLDOWN_SEC.
+bool MarkNudged(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_pvpNudgeMutex);
+    uint32 now = getMSTime();
+    auto key = std::make_pair(bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue());
+    auto it = g_lastPvpNudge.find(key);
+    if (it != g_lastPvpNudge.end() && now - it->second < PVP_NUDGE_COOLDOWN_SEC * IN_MILLISECONDS)
+        return false;
+    g_lastPvpNudge[key] = now;
+    return true;
+}
+
+// A friendly, currently-fighting random bot: the kind that can appreciate a
+// nearby ally's PvP prowess (or be the one who gets saved).
+bool IsFriendlyRandomBot(Player* candidate, Player* ally)
+{
+    if (!candidate || candidate == ally)
+        return false;
+    if (candidate->GetTeamId() != ally->GetTeamId())
+        return false;
+    if (!PlayerbotsMgr::instance().GetPlayerbotAI(candidate))
+        return false;
+    if (!sRandomPlayerbotMgr.IsRandomBot(candidate))
+        return false;
+    return true;
+}
+
+// The enemy faction name relative to a friendly player, for memory text.
+std::string EnemyFactionName(Player* friendly)
+{
+    return friendly->GetTeamId() == TEAM_ALLIANCE ? "Horde" : "Alliance";
+}
+
+// "<race> <class>" of an enemy, formatted through a bot's ChatHelper (the bot is
+// always a random bot here, so its AI/helper is available). Used for both the
+// rescue and gank memory lines.
+std::string DescribeEnemy(Player* bot, Player* enemy)
+{
+    std::string race = "enemy";
+    std::string cls  = "attacker";
+    if (PlayerbotAI* ai = PlayerbotsMgr::instance().GetPlayerbotAI(bot))
+    {
+        if (ai->GetChatHelper())
+        {
+            race = ai->GetChatHelper()->FormatRace(enemy->getRace());
+            cls  = ai->GetChatHelper()->FormatClass(enemy->getClass());
+        }
+    }
+    return SafeFormat("{} {}", race, cls);
+}
+
+// How likely THIS bot pipes up about the fight, given its personality. Respect
+// and memory always update; SPEAKING is optional and personality-driven -- the
+// chatty egirl or arena elitist reacts out loud, the quiet types stay silent.
+// baseChance (0..100) is the moment's inherent noteworthiness; the personality
+// reply-chance multiplier scales it (and is what keeps the quiet noob quiet).
+bool ChimesIn(Player* bot, float baseChance)
+{
+    if (baseChance <= 0.0f)
+        return false;
+    float const mult = GetPersonalityReplyChanceMultiplier(GetBotPersonality(bot));
+    return roll_chance_f(std::min(100.0f, baseChance * mult));
+}
+
+// A guild-leader bot that thinks highly of the player may voice an on-the-spot
+// invitation. The invite itself is left to the existing OngoingGuildRecruit
+// (which already gates real-player invites on sentiment >= 0.6 and respects
+// guild caps / cooldowns / anti-popup-spam): the rescue already pushed sentiment
+// up, so the recruiter picks the player up organically on its next tick. Here we
+// only add the emotional payoff -- an in-character "you'd fit right in" line.
+void MaybeBattleBuddy(Player* bot, Player* player, float buddyChance)
+{
+    if (buddyChance <= 0.0f)
+        return;
+
+    Guild* guild = bot->GetGuild();
+    if (!guild || guild->GetLeaderGUID() != bot->GetGUID())
+        return;                                  // only a guild's leader recruits
+    if (player->GetGuildId() || player->GetGuildIdInvited())
+        return;                                  // already guilded / pending invite
+
+    uint32 cap = std::max<uint32>(2, uint32(sConfigMgr->GetOption<int32>("AiPlayerbot.RandomBotGuildSizeMax", 15)));
+    if (guild->GetMemberCount() >= cap)
+        return;                                  // guild full
+
+    float sentiment = GetBotPlayerSentiment(bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue());
+    if (sentiment < 0.6f)
+        return;                                  // not (yet) a battle-buddy
+
+    if (!roll_chance_f(buddyChance))
+        return;
+
+    OllamaChat_SpeakSituation(bot, player,
+        "you lead a guild and this player just fought bravely at your side - tell them "
+        "they'd fit right in with your guild and you'd love to have them", false);
+}
+
+} // namespace
+
+// --------------------------------------------------------------------------
+// PlayerScript: PvP kill hook. Registering with just a name enables every
+// PlayerScript hook (PlayerScript.cpp fills an empty hook list with all ids),
+// mirroring the sibling ChatOnKill event script.
+// --------------------------------------------------------------------------
+class OllamaChatPvpScript : public PlayerScript
+{
+public:
+    OllamaChatPvpScript() : PlayerScript("OllamaChatPvpScript") { }
+
+    void OnPlayerPVPKill(Player* killer, Player* killed) override
+    {
+        if (!g_Enable || !g_EnableSentimentTracking || !killer || !killed)
+            return;
+
+        if (!sConfigMgr->GetOption<bool>("OllamaChat.EnablePvpAppreciation", true))
+            return;
+
+        // Any killer -- real player OR bot -- earns the reaction: bots come to
+        // respect (or lose respect for) each other's PvP conduct exactly as they
+        // do a player's, which quietly shapes who ends up wanting to guild with
+        // whom. Only a genuine enemy-faction kill counts.
+        if (killed->GetTeamId() == killer->GetTeamId())
+            return;
+
+        bool const killerIsBot = PlayerbotsMgr::instance().GetPlayerbotAI(killer) != nullptr;
+
+        float const range            = sConfigMgr->GetOption<float>("OllamaChat.PvpAppreciationRange", 40.0f);
+        float const killSentiment    = sConfigMgr->GetOption<float>("OllamaChat.PvpKillSentiment", 0.03f);
+        float const rescueSentiment  = sConfigMgr->GetOption<float>("OllamaChat.PvpRescueSentiment", 0.12f);
+        float const rescueHealthPct  = sConfigMgr->GetOption<float>("OllamaChat.PvpRescueHealthPct", 35.0f);
+        float const buddyChance      = sConfigMgr->GetOption<float>("OllamaChat.PvpBuddyGuildChance", 25.0f);
+        // Base "noteworthiness" of each moment (0..100); ChimesIn() scales it by
+        // the bot's personality talkativeness, so respect always moves but only
+        // the chatty personalities actually speak.
+        float const rescueVoiceChance = sConfigMgr->GetOption<float>("OllamaChat.PvpRescueVoiceChance", 50.0f);
+        float const killVoiceChance   = sConfigMgr->GetOption<float>("OllamaChat.PvpKillVoiceChance", 25.0f);
+        float const gankVoiceChance   = sConfigMgr->GetOption<float>("OllamaChat.PvpGankVoiceChance", 20.0f);
+
+        std::string const enemyFaction = EnemyFactionName(killer);
+
+        // A bot only ever SPEAKS when a real player is close enough to witness it,
+        // so unwatched bot-vs-bot skirmishing never wakes the LLM. A real killer is
+        // inherently present; the map walk below flips this on for a bot killer if
+        // some other real player is nearby. Respect + memory update regardless.
+        bool realPlayerPresent = !killerIsBot;
+
+        // ---- Rescue (the big one) : sentiment + memory FIRST so it claims the
+        // pair's cooldown window and a saved bot gets the rescue bump, not the
+        // small kill bump. The killed enemy's current target (m_attacking) is who
+        // it was beating on; if that's a low-health friendly random bot, the killer
+        // just saved it. (In the normal death path the enemy's attack state is
+        // still intact at this hook -- see report note.) The grateful voice line is
+        // deferred until the walk below has decided whether a player is in earshot.
+        Player* rescuedBot = nullptr;
+        uint32 rescued = 0;
+        if (Unit* victim = killed->GetVictim())
+        {
+            if (victim->IsPlayer())
+            {
+                Player* saved = victim->ToPlayer();
+                if (saved && saved->IsAlive()
+                    && IsFriendlyRandomBot(saved, killer)
+                    && saved->GetHealthPct() <= rescueHealthPct
+                    && MarkNudged(saved, killer))
+                {
+                    NudgeSentimentPair(saved, killer, rescueSentiment);
+                    RecordMemoryForPair(saved, killer, "pvp_rescue",
+                        SafeFormat("you saved me from a {}", DescribeEnemy(saved, killed)));
+                    rescuedBot = saved;
+                    rescued = 1;
+                }
+            }
+        }
+
+        // ---- Classify the kill. A rescue (handled above) still lets the rest of
+        // the fighting group feel the small appreciation bump -- a saved ally is a
+        // fun fight for everyone. Only a GANK suppresses appreciation. So this is
+        // GANK (dishonorable, never a rescue) XOR APPRECIATION (an honorable kill,
+        // or the group's share of a rescue). The rescued bot itself is skipped in
+        // the appreciation walk by its cooldown stamp, so it keeps the big rescue
+        // bump, not the small one.
+        uint32 appreciated = 0;
+        uint32 disapproved = 0;
+
+        {
+            int32 const gankLevelGap = sConfigMgr->GetOption<int32>("OllamaChat.PvpGankLevelGap", 10);
+
+            // ONE bounded pass over the map: collect friendly in-combat random-bot
+            // witnesses, note whether a real player is in earshot (the voice gate),
+            // AND whether any high-level enemy is nearby (which would make this a
+            // skirmish, not a gank). No map walk twice.
+            int32 const highLevelThreshold = int32(killer->GetLevel()) - gankLevelGap;
+            std::vector<Player*> witnesses;
+            bool highLevelEnemyNearby = false;
+
+            for (auto const& ref : killer->GetMap()->GetPlayers())
+            {
+                Player* p = ref.GetSource();
+                if (!p || p == killer)
+                    continue;
+                if (!p->IsWithinDist(killer, range, false))
+                    continue;
+
+                if (!PlayerbotsMgr::instance().GetPlayerbotAI(p))
+                    realPlayerPresent = true;      // a real witness is in earshot
+
+                if (p->GetTeamId() == killer->GetTeamId())
+                {
+                    if (witnesses.size() < PVP_MAX_APPRECIATE_BOTS
+                        && p->IsInCombat()
+                        && PlayerbotsMgr::instance().GetPlayerbotAI(p)
+                        && sRandomPlayerbotMgr.IsRandomBot(p))
+                    {
+                        witnesses.push_back(p);
+                    }
+                }
+                else if (int32(p->GetLevel()) >= highLevelThreshold)
+                {
+                    highLevelEnemyNearby = true;   // exclusion B(ii)
+                }
+            }
+
+            // ---- Classify: is this an unprovoked gank of a much-lower-level foe?
+            // Never a gank when we just rescued someone -- the killed enemy's
+            // victim was our friendly bot (exclusion A would catch it too, but
+            // guard explicitly so a rescue is unambiguously an honorable event).
+            bool isGank = false;
+            if (!rescued
+                && sConfigMgr->GetOption<bool>("OllamaChat.EnablePvpGankDisapproval", true)
+                && int32(killer->GetLevel()) - int32(killed->GetLevel()) >= gankLevelGap)
+            {
+                // Exclusion A: a same-faction random bot was already fighting the
+                // target -> shared fight, fair game (any HP; rescue is its low-HP
+                // subcase, already handled and mutually exclusive).
+                bool botInitiated = false;
+                if (Unit* kv = killed->GetVictim())
+                    if (kv->IsPlayer() && IsFriendlyRandomBot(kv->ToPlayer(), killer))
+                        botInitiated = true;
+
+                // Exclusion B(i): the killer is in a real fight with an enemy their
+                // own size or bigger.
+                bool bigFight = false;
+                if (Unit* mv = killer->GetVictim())
+                    if (mv != killed && killer->IsHostileTo(mv)
+                        && int32(mv->GetLevel()) >= highLevelThreshold)
+                        bigFight = true;
+
+                if (!botInitiated && !bigFight && !highLevelEnemyNearby)
+                    isGank = true;
+            }
+
+            if (isGank)
+            {
+                // ---- Disapproval : witnesses that can SEE it lose respect
+                // (dishonorable). Respect always drops; one witness may call it out
+                // aloud if a real player is near and its personality is vocal.
+                float const gankSentiment = sConfigMgr->GetOption<float>("OllamaChat.PvpGankSentiment", -0.05f);
+
+                bool voiced = false;
+                for (Player* bot : witnesses)
+                {
+                    if (!bot->IsWithinLOSInMap(killer))   // behind a wall -> didn't see it
+                        continue;
+                    if (!MarkNudged(bot, killer))
+                        continue;
+
+                    NudgeSentimentPair(bot, killer, gankSentiment);
+                    RecordMemoryForPair(bot, killer, "pvp_gank",
+                        SafeFormat("saw you gank a {}", DescribeEnemy(bot, killed)));
+
+                    if (!voiced && realPlayerPresent && ChimesIn(bot, gankVoiceChance))
+                    {
+                        OllamaChat_SpeakSituation(bot, killer,
+                            "this player just ganked a much lower-level enemy while you were nearby - "
+                            "you find that dishonorable and dont respect it, react in character", false);
+                        voiced = true;
+                    }
+
+                    ++disapproved;
+                }
+            }
+            else
+            {
+                // ---- Appreciation : nearby fighting bots warm to the killer for an
+                // honorable kill. Respect always rises; one chatty witness may pipe
+                // up ("good work") when a real player is near to hear it.
+                bool voiced = false;
+                for (Player* bot : witnesses)
+                {
+                    if (!MarkNudged(bot, killer))
+                        continue;
+
+                    NudgeSentimentPair(bot, killer, killSentiment);
+                    RecordMemoryForPair(bot, killer, "pvp_kill",
+                        SafeFormat("fought the {} alongside them", enemyFaction));
+
+                    if (!voiced && realPlayerPresent && ChimesIn(bot, killVoiceChance))
+                    {
+                        OllamaChat_SpeakSituation(bot, killer,
+                            SafeFormat("you just fought at this player's side and watched them cut "
+                                       "down a {} enemy - react to the kill in your own voice", enemyFaction),
+                            false);
+                        voiced = true;
+                    }
+
+                    ++appreciated;
+                }
+            }
+        }
+
+        // ---- Deferred rescue payoff : the saved bot thanks its rescuer -- but
+        // only if a real player is in earshot AND the bot's personality is one that
+        // would speak up (quiet types just remember it). Whispered to a real
+        // rescuer; said aloud when a bot did the saving. A grateful guild-leader
+        // bot pitches its guild only to a real player -- bot-to-bot recruiting
+        // already flows from the raised respect via OngoingGuildRecruit.
+        if (rescuedBot && realPlayerPresent && ChimesIn(rescuedBot, rescueVoiceChance))
+        {
+            OllamaChat_SpeakSituation(rescuedBot, killer,
+                "this player just saved you from an enemy that was about to kill you - "
+                "thank them, in character", !killerIsBot);
+        }
+        if (rescuedBot && !killerIsBot)
+            MaybeBattleBuddy(rescuedBot, killer, buddyChance);
+
+        std::string where = killer->GetMap() ? killer->GetMap()->GetMapName() : "the field";
+        if (rescued || appreciated)
+        {
+            LOG_INFO("server.loading", "[PvpFriend] {} appreciated by {} bot(s), {} rescued near {}",
+                     killer->GetName(), appreciated, rescued, where);
+        }
+        if (disapproved)
+        {
+            LOG_INFO("server.loading", "[PvpFriend] gank near {} disapproved by {} witness(es)",
+                     where, disapproved);
+        }
+    }
+};
+
+// Registration entry point. Call this from Addmod_ollama_chatScripts() in
+// mod-ollama-chat_main.cpp (see the registration note reported to the user).
+void AddSC_mod_ollama_chat_pvp()
+{
+    new OllamaChatPvpScript();
+}
