+// mod-ollama-chat_memory.cpp
+//
+// Bot event-memory subsystem: a random bot keeps a small, bounded set of
+// structured memories about a REAL, currently-guilded player and references
+// them in chat via {memory_info}. See mod-ollama-chat_memory.h for the design
+// rationale. NO record-time LLM calls happen here -- memories are plain
+// structured rows; the recall text is assembled cheaply from those rows.
+
+#include "mod-ollama-chat_memory.h"
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat-utilities.h"
+
+#include "ScriptMgr.h"
