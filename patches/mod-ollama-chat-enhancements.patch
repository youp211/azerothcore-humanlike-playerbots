+// Declared as a plain extern at the mod-playerbots call sites (same binary).
+// ---------------------------------------------------------------------------
+void OllamaChat_SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper)
+{
+    if (!g_Enable || !bot)
+        return;
