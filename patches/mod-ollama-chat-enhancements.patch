+// ---------------------------------------------------------------------------
+// Shared situational-line generator. Any code (this module or mod-playerbots)
+// can make a bot SAY or WHISPER a short, in-character, LLM-generated line about
+// a concrete situation ("a player opened trade to buy your Cured Leather Belt
+// for 15 silver"), so scripted interactions get personality-flavored dialogue
+// instead of canned strings. Fire-and-forget: async, never blocks the caller.
+// Declared as a plain extern at the mod-playerbots call sites (same binary).
+// ---------------------------------------------------------------------------
+void OllamaChat_SpeakSituation(Player* bot, Player* target, std::string const& situation, bool whisper)
+{
+    if (!g_Enable || !bot)
+        return;
+
+    PlayerbotAI* botAI = PlayerbotsMgr::instance().GetPlayerbotAI(bot);
+    if (!botAI)
+        return;
+
+    std::string personality       = GetBotPersonality(bot);
+    std::string personalityPrompt = GetPersonalityPromptAddition(personality);
+    std::string botClass          = botAI->GetChatHelper() ? botAI->GetChatHelper()->FormatClass(bot->getClass()) : "adventurer";
+    std::string targetName        = target ? target->GetName() : "someone";
+
+    std::string prompt = fmt::format(
+        "You're a Wrath-era WoW player. Name: {}, a level {} {}. "
+        "MAKE SURE YOU RESPOND USING YOUR PERSONALITY, WHICH IS: {}: {}. "
+        "Situation: {} (speaking to {}). Say one short in-character line about it, "
+        "under 15 words. No narration, no quotes, just the line.",
+        bot->GetName(), bot->GetLevel(), botClass, personality, personalityPrompt,
+        situation, targetName);
+
+    OllamaQueryOptions opts = GetPersonalityQueryOptions(bot);
+    uint64_t botGuid = bot->GetGUID().GetRawValue();
+    uint64_t targetGuid = target ? target->GetGUID().GetRawValue() : 0;
+
+    std::thread([botGuid, targetGuid, prompt, opts, whisper]() {
+        try {
+            auto fut = SubmitQuery(prompt, opts);
+            if (!fut.valid())
+                return;
+            std::string response = fut.get();
+            if (response.empty())
+                return;
+            Player* botPtr = ObjectAccessor::FindPlayer(ObjectGuid(botGuid));
+            if (!botPtr)
+                return;
+            PlayerbotAI* ai = PlayerbotsMgr::instance().GetPlayerbotAI(botPtr);
+            Player* targetPtr = targetGuid ? ObjectAccessor::FindPlayer(ObjectGuid(targetGuid)) : nullptr;
+            if (whisper && targetPtr)
+                botPtr->Whisper(response, LANG_UNIVERSAL, targetPtr);
+            else if (ai)
+                ai->Say(response);
+        } catch (...) {}
+    }).detach();
+}
