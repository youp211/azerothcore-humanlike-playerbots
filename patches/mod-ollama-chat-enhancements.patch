@@ -0,0 +1,60 @@
+#ifndef MOD_OLLAMA_CHAT_CHANNELS_H
+#define MOD_OLLAMA_CHAT_CHANNELS_H
+
+// mod-ollama-chat_channels.cpp/.h
+//
+// Public-channel (General / Trade / LookingForGroup / ...) behavior overhaul.
+// Channels should host group-up asks, trade, guild recruitment and real
+// conversation - not per-message banter. Most personalities stay quiet in
+// General (they quest with you in person); only the personalities who would
+// actually use a public channel (LFG spammers, guild recruiters, traders,
+// dungeon advertisers) speak there, and even they are throttled hard and only
+// on RELEVANT messages. Participating bots are given the channel's recent
+// conversation as lightweight session memory.
+//
+// All of the heavy lifting lives in the .cpp; mod-ollama-chat_handler.cpp calls
+// only the small surface declared here (plus main.cpp registers the announcer).
+
+#include <cstdint>
+#include <string>
+
+class Player;
+
+// --- Channel session log (RAM only; no DB) ------------------------------------
+// Record every channel line that reaches the module (players AND bots - bot
+// replies re-enter ProcessChat via ProcessBotChatMessage, so a single hook at
+// the top of ProcessChat captures both). Bounded to the last 30 lines per
+// channel id.
+void RecordChannelLine(uint32_t channelId, std::string const& speaker, std::string const& msg);
+
+// Build "Recent channel conversation:\n<name>: <msg>\n..." for the last
+// maxLines lines of a channel, or "" if the channel has no history. Injected
+// into a replying bot's prompt as session memory.
+std::string BuildChannelHistory(uint32_t channelId, uint32_t maxLines = 10);
+
+// --- Reply gating -------------------------------------------------------------
+// Per-personality channel talkativeness (0..100). High for the personalities
+// that would use public channels; 8 by default for everyone else.
+float ChannelTalkChanceFor(Player* bot);
+
+// True when a channel message is relevant to this specific bot: group/dungeon/
+// lfg/quest keywords (any channel-active bot), trade keywords (trader set),
+// guild-recruit keywords (recruiter set / guild officers), or the bot's name.
+bool ChannelMessageRelevantTo(Player* bot, std::string const& msg);
+
+// Single gate used by the handler's channel reply roll. Returns false to skip
+// the bot entirely (off-cooldown / irrelevant / personality won't talk). On
+// return true, effChance has been scaled in place by the personality's channel
+// talkativeness (or set to a small flat chance for generic chatter from the
+// chatty set). When the overhaul is disabled this returns true and leaves
+// effChance untouched (legacy behavior).
+bool ShouldBotReplyInChannel(Player* bot, std::string const& msg, uint32_t& effChance);
+
+// Mark that a bot just sent a channel line (starts its per-bot cooldown).
+// Called at the actual send site for replies; the announcer marks itself.
+void MarkChannelReply(Player* bot);
+
+// Registration entry point (called from Addmod_ollama_chatScripts).
+void AddSC_mod_ollama_chat_channels();
+
+#endif // MOD_OLLAMA_CHAT_CHANNELS_H
