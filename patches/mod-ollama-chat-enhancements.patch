+# Sentiment nudges from world events (only active when EnableSentimentTracking = 1).
+# Applied directly to the mutual sentiment of the pair involved - no LLM call.
+# Set a value to 0 to disable that nudge.
+# Defaults: group 0.02, guild 0.01, duel 0.03
+OllamaChat.SentimentEventGroupAdjustment = 0.02
+OllamaChat.SentimentEventGuildAdjustment = 0.01
+OllamaChat.SentimentEventDuelAdjustment = 0.03
+
+# ---------------------------------------------------------------------------
+# PvP appreciation / friendship (mod-ollama-chat_pvp.cpp)
+# ---------------------------------------------------------------------------
+# When someone downs an enemy-faction foe alongside fighting friendly bots, the
+# nearby bots gain (or lose) RESPECT for them. This applies whether the killer
+# is a real player OR another bot - bots judge each other's conduct too, which
+# quietly shapes who wants to guild with whom (rising respect already gates
+# guild invites / quest help / gear gives elsewhere).
+#
+# Respect (sentiment) + memory ALWAYS update. The spoken reaction is a separate
+# CHANCE, scaled by the bot's personality talkativeness, and only fires when a
+# real player is close enough to hear it - so bot-vs-bot fights never wake the
+# LLM. Every line is generated by the model from fight context, not hardcoded.
+#
+# Three cases, in priority order:
+#   RESCUE       - killer downs the enemy that was about to kill a low-HP
+#                  friendly bot -> big respect bump + a grateful line.
+#   APPRECIATION - an honorable kill -> small respect bump; a chatty witness may
+#                  say "good work". A rescue also gives the rest of the group
+#                  this small bump.
+#   GANK         - an unprovoked kill of a foe PvpGankLevelGap+ levels below the
+#                  killer, with no bigger fight around -> witnesses LOSE respect.
+#                  Suppressed if a friendly bot was already fighting the target,
+#                  the killer is fighting an enemy their own size, or a
+#                  high-level enemy is nearby (all = a real skirmish, not a gank).
+OllamaChat.EnablePvpAppreciation = 1
+OllamaChat.EnablePvpGankDisapproval = 1
+# Radius (yards) for finding fighting witnesses / nearby high-level enemies.
+OllamaChat.PvpAppreciationRange = 40.0
+# Respect deltas (applied to 0..1 mutual sentiment; clamped).
+OllamaChat.PvpKillSentiment = 0.03
+OllamaChat.PvpRescueSentiment = 0.12
+OllamaChat.PvpGankSentiment = -0.05
+# A saved bot counts as rescued only if at/under this health % when saved.
+OllamaChat.PvpRescueHealthPct = 35.0
+# A kill is a gank only if the victim is at least this many levels below killer.
+OllamaChat.PvpGankLevelGap = 10
+# Base spoken-reaction chances (0..100), each scaled by personality talkativeness.
+OllamaChat.PvpRescueVoiceChance = 50.0
+OllamaChat.PvpKillVoiceChance = 25.0
+OllamaChat.PvpGankVoiceChance = 20.0
+# Chance a rescued guild-leader bot voices an on-the-spot guild pitch to a real
+# player (the actual invite still flows through the ongoing recruiter).
+OllamaChat.PvpBuddyGuildChance = 25.0
+
