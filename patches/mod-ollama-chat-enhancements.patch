diff --git a/src/mod-ollama-chat_events_mail.cpp b/src/mod-ollama-chat_events_mail.cpp
new file mode 100644
index 0000000..0ec0bd0
--- /dev/null
+++ b/src/mod-ollama-chat_events_mail.cpp
@@ -0,0 +1,272 @@
+// mod-ollama-chat_events_mail.cpp
+//
+// Event-driven mail from bots: after a REAL player finishes a quest while
+// grouped with random bots, one of those bots may mail them a small reward
+// (gold or a spare green+ item) with an in-character note. The per-bot chance
+// is driven entirely by the bot's personality (reusing gearGiveChance), scaled
+// down for this passive event. Self-contained: all state and helpers are local
+// to this translation unit.
+
+#include "ScriptMgr.h"
+#include "Player.h"
+#include "Item.h"
+#include "Bag.h"
+#include "Group.h"
+#include "Mail.h"
+#include "ObjectMgr.h"
+#include "ObjectAccessor.h"
+#include "QuestDef.h"
+#include "ItemTemplate.h"
+#include "SharedDefines.h"
+#include "DatabaseEnv.h"
+#include "Random.h"
+#include "Config.h"
+#include "Log.h"
+#include "Common.h"
+#include "Timer.h"
+
+#include "PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+#include "RandomPlayerbotMgr.h"
+
+#include "mod-ollama-chat_config.h"
+#include "mod-ollama-chat_personality.h"
+
+#include <fmt/core.h>
+#include <mutex>
+#include <map>
+#include <utility>
+#include <string>
+#include <algorithm>
+
+// Implemented in mod-ollama-chat_handler.cpp: makes the bot say a short
+// in-character line about the given situation.
+extern void OllamaChat_SpeakSituation(Player*, Player*, std::string const&, bool);
+
+namespace
+{
+
+// --------------------------------------------------------------------------
+// Anti-spam cooldown: at most one event-mail per (bot, player) pair per hour.
+// --------------------------------------------------------------------------
+constexpr uint32 EVENT_MAIL_COOLDOWN_MIN = 60;
+
+std::mutex g_eventMailMutex;
+std::map<std::pair<uint64_t, uint64_t>, uint32> g_lastEventMail;
+
+bool CanEventMailNow(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_eventMailMutex);
+    uint32 now = getMSTime();
+    auto it = g_lastEventMail.find({bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()});
+    if (it != g_lastEventMail.end() && now - it->second < EVENT_MAIL_COOLDOWN_MIN * MINUTE * IN_MILLISECONDS)
+        return false;
+    return true;
+}
+
+void RegisterEventMail(Player* bot, Player* player)
+{
+    std::lock_guard<std::mutex> lock(g_eventMailMutex);
+    g_lastEventMail[{bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue()}] = getMSTime();
+}
+
+// --------------------------------------------------------------------------
+// Reward helpers.
+// --------------------------------------------------------------------------
+
+// Find a spare, non-soulbound, uncommon-or-better item in the bot's backpack
+// or bags. Skips conjured items and anything the bot has equipped. Returns
+// nullptr if the bot has nothing worth parting with.
+Item* FindSpareItem(Player* bot)
+{
+    Item* best = nullptr;
+    auto consider = [&](Item* item)
+    {
+        if (!item || item->IsSoulBound())
+            return;
+        ItemTemplate const* proto = item->GetTemplate();
+        if (!proto || proto->Quality < ITEM_QUALITY_UNCOMMON || proto->Quality > ITEM_QUALITY_EPIC)
+            return;
+        if (proto->Bonding == BIND_QUEST_ITEM || proto->HasFlag(ITEM_FLAG_CONJURED))
+            return;
+        if (!best || proto->ItemLevel > best->GetTemplate()->ItemLevel)
+            best = item;
+    };
+
+    for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, i));
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (Bag* bag = bot->GetBagByPos(b))
+            for (uint32 s = 0; s < bag->GetBagSize(); ++s)
+                consider(bag->GetItemByPos(s));
+
+    return best;
+}
+
+// Mail a spare item from the bot to the player. Mirrors MailBagItemTo() in
+// mod-ollama-chat_handler.cpp. Returns the item name on success, "" on failure.
+std::string MailItemReward(Player* bot, Player* player, Item* item)
+{
+    if (!item)
+        return "";
+
+    std::string itemName = item->GetTemplate()->Name1;
+
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+
+    item->SetNotRefundable(bot);
+    bot->MoveItemFromInventory(item->GetBagSlot(), item->GetSlot(), true);
+    item->DeleteFromInventoryDB(trans);
+    if (item->GetState() == ITEM_UNCHANGED)
+        item->FSetState(ITEM_CHANGED);
+    item->SetOwnerGUID(player->GetGUID());
+    item->SaveToDB(trans);
+
+    MailDraft draft("A token of thanks", fmt::format("Good adventuring with you out there. Keep this - you earned it. - {}", bot->GetName()));
+    draft.AddItem(item);
+    draft.SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(bot), MAIL_CHECK_MASK_COPIED);
+
+    bot->SaveInventoryAndGoldToDB(trans);
+    CharacterDatabase.CommitTransaction(trans);
+    return itemName;
+}
+
+// Mail gold from the bot to the player (deducted from the bot's purse).
+// Returns a short human description on success, "" on failure.
+std::string MailGoldReward(Player* bot, Player* player, uint32 copper)
+{
+    if (copper == 0 || bot->GetMoney() < copper)
+        return "";
+
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+
+    bot->ModifyMoney(-int32(copper));
+    bot->SaveGoldToDB(trans);
+
+    MailDraft draft("A little something", fmt::format("Thanks for the help on that quest. Here's a bit of coin. - {}", bot->GetName()));
+    draft.AddMoney(copper);
+    draft.SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()), MailSender(bot), MAIL_CHECK_MASK_COPIED);
+
+    CharacterDatabase.CommitTransaction(trans);
+    return fmt::format("{} silver", std::max<uint32>(copper / 100, 1));
+}
+
+// Decide and deliver a reward. Prefers an item ~40% of the time when one is
+// available, otherwise gold. Returns a short description of what was mailed,
+// or "" if nothing could be delivered.
+std::string DeliverReward(Player* bot, Player* player)
+{
+    Item* spare = FindSpareItem(bot);
+
+    // Modest gold scaled to level, capped so it stays "a little something".
+    uint32 gold = std::min<uint32>(uint32(player->GetLevel()) * urand(50, 150), 50000);
+    bool botCanPayGold = gold > 0 && bot->GetMoney() >= gold;
+
+    if (spare && (!botCanPayGold || roll_chance_i(40)))
+    {
+        std::string desc = MailItemReward(bot, player, spare);
+        if (!desc.empty())
+            return desc;
+    }
+
+    if (botCanPayGold)
+    {
+        std::string desc = MailGoldReward(bot, player, gold);
+        if (!desc.empty())
+            return desc;
+    }
+
+    // Last-ditch fallback: if gold failed but an item exists, send the item.
+    if (spare)
+        return MailItemReward(bot, player, spare);
+
+    return "";
+}
+
+} // namespace
+
+// --------------------------------------------------------------------------
+// PlayerScript: reward hook on quest completion.
+// --------------------------------------------------------------------------
+class OllamaChatCompletionMailScript : public PlayerScript
+{
+public:
+    OllamaChatCompletionMailScript() : PlayerScript("OllamaChatCompletionMailScript") { }
+
+    void OnPlayerCompleteQuest(Player* player, Quest const* quest) override
+    {
+        if (!g_Enable || !player || !quest)
+            return;
+
+        if (!sConfigMgr->GetOption<bool>("OllamaChat.EnableEventMail", true))
+            return;
+
+        float mailMultiplier = sConfigMgr->GetOption<float>("OllamaChat.EventMailChanceMultiplier", 0.5f);
+        if (mailMultiplier <= 0.0f)
+            return;
+
+        // Only REAL players get rewarded - never bots.
+        if (PlayerbotsMgr::instance().GetPlayerbotAI(player))
+            return;
+
+        Group* group = player->GetGroup();
+        if (!group)
+            return;
+
+        for (auto const& slot : group->GetMemberSlots())
+        {
+            if (slot.guid == player->GetGUID())
+                continue;
+
+            Player* bot = ObjectAccessor::FindPlayer(slot.guid);
+            if (!bot)
+                continue;
+
+            // Must be a random bot (not a human, not a hand-summoned alt-bot).
+            if (!PlayerbotsMgr::instance().GetPlayerbotAI(bot))
+                continue;
+            if (!sRandomPlayerbotMgr.IsRandomBot(bot))
+                continue;
+
+            // Shared accomplishment: same map and zone as the questing player.
+            if (bot->GetMapId() != player->GetMapId() || bot->GetZoneId() != player->GetZoneId())
+                continue;
+
+            if (!CanEventMailNow(bot, player))
+                continue;
+
+            // Personality-driven chance, scaled down for this passive event.
+            std::string personality = GetBotPersonality(bot);
+            float baseChance = 2.0f;
+            auto it = g_PersonalityTemplates.find(personality);
+            if (it != g_PersonalityTemplates.end())
+                baseChance = it->second.gearGiveChance;
+
+            float effectiveChance = baseChance * mailMultiplier;
+            if (effectiveChance <= 0.0f || !roll_chance_f(effectiveChance))
+                continue;
+
+            // Roll succeeded - try to actually deliver a reward.
+            std::string rewardDesc = DeliverReward(bot, player);
+            if (rewardDesc.empty())
+                continue; // nothing to give; let another member get a chance
+
+            RegisterEventMail(bot, player);
+
+            LOG_INFO("server.loading", "[Ollama Chat] [EventMail] {} mailed {} a reward ({}) for finishing {}",
+                     bot->GetName(), player->GetName(), rewardDesc, quest->GetTitle());
+
+            OllamaChat_SpeakSituation(bot, player,
+                "you just finished a quest together and mailed them a thank-you reward", false);
+
+            break; // only one bot rewards per event
+        }
+    }
+};
+
+// Registration entry point. Call this from Addmod_ollama_chatScripts() in
+// mod-ollama-chat_main.cpp (see registration note reported to the user).
+void AddSC_mod_ollama_chat_events_mail()
+{
+    new OllamaChatCompletionMailScript();
+}
diff --git a/src/mod-ollama-chat_groupjoin.cpp b/src/mod-ollama-chat_groupjoin.cpp
new file mode 100644
index 0000000..bafaf9e
--- /dev/null
+++ b/src/mod-ollama-chat_groupjoin.cpp
@@ -0,0 +1,363 @@
+#include "mod-ollama-chat_groupjoin.h"
+
+#include "Common.h"
+#include "Player.h"
+#include "Group.h"
+#include "WorldSession.h"
+#include "WorldPacket.h"
+#include "Config.h"
+#include "Log.h"
+#include "Random.h"
+#include "Timer.h"
+#include "DatabaseEnv.h"
+#include "ObjectGuid.h"
+
+#include "mod-ollama-chat_personality.h"
+#include "mod-ollama-chat_sentiment.h"
+
+#include <algorithm>
+#include <cctype>
+#include <map>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <utility>
+
+// ---------------------------------------------------------------------------
+// Small string helpers (local, header-free).
+// ---------------------------------------------------------------------------
+namespace
+{
+    std::string ToLower(std::string const& in)
+    {
+        std::string out = in;
+        for (char& c : out)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        return out;
+    }
+
+    // True if `word` appears in `lowerMsg` bounded by non-alphanumeric characters
+    // (so "us" does not match "focus", and "u" does not match "group").
+    bool ContainsWholeWord(std::string const& lowerMsg, std::string const& word)
+    {
+        if (word.empty())
+            return false;
+
+        size_t pos = 0;
+        while ((pos = lowerMsg.find(word, pos)) != std::string::npos)
+        {
+            bool validStart = (pos == 0 || !std::isalnum(static_cast<unsigned char>(lowerMsg[pos - 1])));
+            size_t endPos = pos + word.size();
+            bool validEnd = (endPos >= lowerMsg.size() || !std::isalnum(static_cast<unsigned char>(lowerMsg[endPos])));
+            if (validStart && validEnd)
+                return true;
+            ++pos;
+        }
+        return false;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// LooksLikeGroupRequest - keyword heuristic. Two tiers:
+//   * "strong" phrases are unambiguous requests on their own;
+//   * "weak" keywords only count when paired with a first/second-person cue
+//     ('?' or the whole words "me"/"us"), so "the party was fun" is ignored.
+// Kept deliberately simple and listed here for easy tuning.
+// ---------------------------------------------------------------------------
+bool LooksLikeGroupRequest(std::string const& msg)
+{
+    std::string const m = ToLower(msg);
+
+    static char const* const kStrongPhrases[] = {
+        "inv me", "invite me", "join me", "carry me", "help me", "give me a hand",
+        "wanna group", "want to group", "can you help", "could you help",
+        "group up", "lets group", "let's group", "party up",
+        "lfg", "looking for group", "need a group", "need a healer", "need a tank"
+    };
+    for (char const* phrase : kStrongPhrases)
+        if (m.find(phrase) != std::string::npos)
+            return true;
+
+    static char const* const kWeakKeywords[] = { "invite", "party", "group", "help" };
+    bool hasWeak = false;
+    for (char const* kw : kWeakKeywords)
+    {
+        if (m.find(kw) != std::string::npos)
+        {
+            hasWeak = true;
+            break;
+        }
+    }
+    if (!hasWeak)
+        return false;
+
+    bool cue = (m.find('?') != std::string::npos) || ContainsWholeWord(m, "me") || ContainsWholeWord(m, "us");
+    return cue;
+}
+
+// ---------------------------------------------------------------------------
+// LooksLikeGuildFormRequest - the player proposing the party turn into a guild.
+// Deliberately narrow phrase list (no weak tier): only unambiguous "let's make a
+// guild" style lines match, so ordinary guild chatter does not trigger formation.
+// ---------------------------------------------------------------------------
+bool LooksLikeGuildFormRequest(std::string const& msg)
+{
+    std::string const m = ToLower(msg);
+
+    static char const* const kPhrases[] = {
+        "start a guild", "make a guild", "form a guild", "found a guild", "create a guild",
+        "start our own guild", "make our own guild", "guild up", "lets guild", "let's guild",
+        "should be a guild", "become a guild", "turn this into a guild"
+    };
+    for (char const* phrase : kPhrases)
+        if (m.find(phrase) != std::string::npos)
+            return true;
+
+    return false;
+}
+
+// ---------------------------------------------------------------------------
+// GroupJoinChanceFor - base chance from personality key, else playstyle, else
+// 40; plus a sentiment bonus when the bot already likes the player. Clamped
+// 5..95. Playstyle is resolved via the shared characters DB and cached per bot.
+// ---------------------------------------------------------------------------
+namespace
+{
+    // Resolve a bot's playstyle from its mod-ollama-chat personality via the
+    // personality-templates join, mirroring mod-playerbots' GetBotPlaystyle.
+    // Cached per guid; empty results retried every 5 min so late personality
+    // assignment still picks up a profile.
+    std::mutex g_playstyleCacheMutex;
+    std::unordered_map<ObjectGuid::LowType, std::pair<std::string, uint32>> g_playstyleCache;
+
+    std::string GetBotPlaystyle(Player* bot)
+    {
+        static int hasPlaystyleColumn = -1;
+        if (hasPlaystyleColumn == -1)
+        {
+            QueryResult probe = CharacterDatabase.Query(
+                "SELECT 1 FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() "
+                "AND TABLE_NAME = 'mod_ollama_chat_personality_templates' AND COLUMN_NAME = 'playstyle'");
+            hasPlaystyleColumn = probe ? 1 : 0;
+        }
+        if (!hasPlaystyleColumn)
+            return "";
+
+        ObjectGuid::LowType guid = bot->GetGUID().GetCounter();
+        uint32 now = getMSTime();
+        {
+            std::lock_guard<std::mutex> lock(g_playstyleCacheMutex);
+            auto it = g_playstyleCache.find(guid);
+            if (it != g_playstyleCache.end() &&
+                (!it->second.first.empty() || getMSTimeDiff(it->second.second, now) < 5 * MINUTE * IN_MILLISECONDS))
+                return it->second.first;
+        }
+
+        std::string playstyle;
+        QueryResult result = CharacterDatabase.Query(
+            "SELECT t.playstyle FROM mod_ollama_chat_personality p "
+            "JOIN mod_ollama_chat_personality_templates t ON t.`key` = p.personality "
+            "WHERE p.guid = {}", guid);
+        if (result)
+            playstyle = (*result)[0].Get<std::string>();
+        if (playstyle == "default")
+            playstyle.clear();
+
+        std::lock_guard<std::mutex> lock(g_playstyleCacheMutex);
+        g_playstyleCache[guid] = { playstyle, now };
+        return playstyle;
+    }
+}
+
+float GroupJoinChanceFor(Player* bot, Player* player)
+{
+    if (!bot)
+        return 0.0f;
+
+    static std::unordered_map<std::string, float> const kByPersonality = {
+        { "LFG_SPAMMER",       95.0f }, { "GUILD_RECRUITER",   85.0f },
+        { "HEALER_MAIN",       75.0f }, { "WOW_MOM",           75.0f },
+        { "CHILL_DAD",         70.0f }, { "MENTOR",            75.0f },
+        { "HEROIC_LEADER",     70.0f }, { "EGIRL",             65.0f },
+        { "SCARED_NEWBIE",     55.0f }, { "ELITE_ARENA_PVPER",  5.0f },
+        { "PVP_TRASHTALKER",   10.0f }, { "SILENT_TYPE",       15.0f },
+        { "ONE_WORD_GRUNTER",  15.0f }, { "GRUMPY_VETERAN",    20.0f },
+        { "UNHINGED_TROLL",    25.0f }, { "MIN_MAXER",         20.0f },
+        { "HARDCORE_RAIDLEAD", 15.0f }
+    };
+    static std::unordered_map<std::string, float> const kByPlaystyle = {
+        { "socializer", 65.0f }, { "quester",  55.0f }, { "idler",    40.0f },
+        { "explorer",   40.0f }, { "grinder",  25.0f }, { "pvper",    20.0f }
+    };
+
+    float chance = 40.0f;
+
+    std::string const personality = GetBotPersonality(bot);
+    auto pit = kByPersonality.find(personality);
+    if (pit != kByPersonality.end())
+    {
+        chance = pit->second;
+    }
+    else
+    {
+        std::string const playstyle = GetBotPlaystyle(bot);
+        auto sit = kByPlaystyle.find(playstyle);
+        if (sit != kByPlaystyle.end())
+            chance = sit->second;
+    }
+
+    if (player)
+    {
+        float sentiment = GetBotPlayerSentiment(bot->GetGUID().GetRawValue(), player->GetGUID().GetRawValue());
+        if (sentiment >= 0.6f)
+            chance += sConfigMgr->GetOption<float>("OllamaChat.GroupJoinSentimentBonus", 20.0f);
+    }
+
+    return std::clamp(chance, 5.0f, 95.0f);
+}
+
+// ---------------------------------------------------------------------------
+// Pending "who, me?" state: (bot low guid, player low guid) -> timestamp(ms).
+// 60s TTL - after that the disambiguation is stale and forgotten.
+// ---------------------------------------------------------------------------
+namespace
+{
+    std::mutex g_whoMeMutex;
+    std::map<std::pair<ObjectGuid::LowType, ObjectGuid::LowType>, uint32> g_pendingWhoMe;
+    constexpr uint32 kWhoMeTtlMs = 60 * IN_MILLISECONDS;
+
+    std::pair<ObjectGuid::LowType, ObjectGuid::LowType> WhoMeKey(Player* bot, Player* player)
+    {
+        return { bot->GetGUID().GetCounter(), player->GetGUID().GetCounter() };
+    }
+}
+
+void RegisterWhoMe(Player* bot, Player* player)
+{
+    if (!bot || !player)
+        return;
+    std::lock_guard<std::mutex> lock(g_whoMeMutex);
+    g_pendingWhoMe[WhoMeKey(bot, player)] = getMSTime();
+}
+
+bool HasPendingWhoMe(Player* bot, Player* player)
+{
+    if (!bot || !player)
+        return false;
+    std::lock_guard<std::mutex> lock(g_whoMeMutex);
+    auto it = g_pendingWhoMe.find(WhoMeKey(bot, player));
+    if (it == g_pendingWhoMe.end())
+        return false;
+    if (getMSTimeDiff(it->second, getMSTime()) > kWhoMeTtlMs)
+    {
+        g_pendingWhoMe.erase(it);
+        return false;
+    }
+    return true;
+}
+
+void ClearWhoMe(Player* bot, Player* player)
+{
+    if (!bot || !player)
+        return;
+    std::lock_guard<std::mutex> lock(g_whoMeMutex);
+    g_pendingWhoMe.erase(WhoMeKey(bot, player));
+}
+
+// ---------------------------------------------------------------------------
+// Invite packet - mirrors mod-playerbots InviteToGroupAction::Invite: build a
+// CMSG_GROUP_INVITE payload (target name + roles mask) and feed it straight to
+// the bot's session handler, exactly as the client would.
+// ---------------------------------------------------------------------------
+namespace
+{
+    void SendGroupInvite(Player* bot, Player* player)
+    {
+        if (!bot || !player || !bot->GetSession())
+            return;
+        WorldPacket p;
+        uint32 roles_mask = 0;
+        p << player->GetName();
+        p << roles_mask;
+        bot->GetSession()->HandleGroupInviteOpcode(p);
+    }
+
+    bool MessageNamesBot(Player* bot, std::string const& lowerMsg)
+    {
+        std::string const name = ToLower(bot->GetName());
+        return !name.empty() && lowerMsg.find(name) != std::string::npos;
+    }
+
+    bool MessageHasAffirmative(std::string const& lowerMsg)
+    {
+        static char const* const kAffirmatives[] = { "you", "yes", "yeah", "yep", "u" };
+        for (char const* word : kAffirmatives)
+            if (ContainsWholeWord(lowerMsg, word))
+                return true;
+        return false;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// EvaluateGroupRequest - see header. World-thread only.
+// ---------------------------------------------------------------------------
+GroupJoinOutcome EvaluateGroupRequest(Player* bot, Player* player, std::string const& msg,
+                                      uint32_t candidateBotsInRange, std::string& outExtraContext)
+{
+    outExtraContext.clear();
+
+    if (!sConfigMgr->GetOption<bool>("OllamaChat.EnableGroupJoin", true))
+        return GroupJoinOutcome::NotAGroupRequest;
+
+    if (!bot || !player)
+        return GroupJoinOutcome::NotAGroupRequest;
+
+    std::string const lowerMsg = ToLower(msg);
+
+    // A fresh request needs group-request phrasing; a bare confirmation
+    // ("yes, you") only counts as a continuation if we recently asked who-me.
+    bool const affirmedPending = HasPendingWhoMe(bot, player) && MessageHasAffirmative(lowerMsg);
+    if (!LooksLikeGroupRequest(msg) && !affirmedPending)
+        return GroupJoinOutcome::NotAGroupRequest;
+
+    // Already grouped together -> nothing to do, treat as normal chat.
+    Group* botGroup = bot->GetGroup();
+    if (botGroup && botGroup->IsMember(player->GetGUID()))
+        return GroupJoinOutcome::NotAGroupRequest;
+
+    // Bot's group is full (and the player isn't in it) -> can't invite.
+    if (botGroup && botGroup->IsFull())
+    {
+        outExtraContext = "(They asked to group but you're already grouped up - let them down briefly.)";
+        return GroupJoinOutcome::Declined;
+    }
+
+    bool const named = MessageNamesBot(bot, lowerMsg);
+    bool const resolved = named || candidateBotsInRange <= 1 || affirmedPending;
+
+    if (resolved)
+    {
+        ClearWhoMe(bot, player);
+        float const chance = GroupJoinChanceFor(bot, player);
+        if (roll_chance_f(chance))
+        {
+            SendGroupInvite(bot, player);
+            LOG_INFO("server.loading", "[GroupJoin] {} invited {} (chance {})",
+                     bot->GetName(), player->GetName(), chance);
+            outExtraContext = "(You just sent them a group invite - tell them it's on the way.)";
+            return GroupJoinOutcome::Invited;
+        }
+
+        LOG_INFO("server.loading", "[GroupJoin] {} declined {}", bot->GetName(), player->GetName());
+        outExtraContext = "(They asked you to group up but you don't feel like it - decline in your own words, "
+                          "true to your personality.)";
+        return GroupJoinOutcome::Declined;
+    }
+
+    // Ambiguous: several bots could be the addressee. Ask, and remember we asked.
+    RegisterWhoMe(bot, player);
+    LOG_INFO("server.loading", "[GroupJoin] {} asks who-me to {}", bot->GetName(), player->GetName());
+    outExtraContext = "(There are several of you nearby and you're not sure " + std::string(player->GetName()) +
+                      " meant you - ask briefly, in your own way, whether they mean you.)";
+    return GroupJoinOutcome::AskWhoMe;
+}
