diff --git a/data/sql/characters/base/2026_07_03_event_memories.sql b/data/sql/characters/base/2026_07_03_event_memories.sql
new file mode 100644
index 0000000..c84fa0e
--- /dev/null
+++ b/data/sql/characters/base/2026_07_03_event_memories.sql
@@ -0,0 +1,17 @@
+-- Bot event-memory subsystem: bounded, structured memories a random bot keeps
+-- about a REAL, currently-guilded player (duel, group, guild, shared
+-- arena/battleground). Storage is bounded two ways -- at most N rows per
+-- (bot_guid, player_guid) pair, and rows are purged entirely when the player
+-- leaves their guild -- so NO row compression is needed here; the bounding plus
+-- guilded-only recording IS the performance strategy.
+CREATE TABLE IF NOT EXISTS mod_ollama_chat_event_memories (
+    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
+    bot_guid BIGINT UNSIGNED NOT NULL,
+    player_guid BIGINT UNSIGNED NOT NULL,
+    event_type VARCHAR(24) NOT NULL COMMENT 'Structured tag: duel, group, guild, arena, battleground, trade',
+    detail VARCHAR(128) NOT NULL DEFAULT '' COMMENT 'Short human phrase, e.g. "were on an arena team with them"',
+    zone VARCHAR(48) NOT NULL DEFAULT '' COMMENT 'Zone name where the moment happened',
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    -- Primary lookup path for recall and pruning is by (bot, player).
+    KEY idx_bot_player (bot_guid, player_guid)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
diff --git a/data/sql/characters/base/2026_07_03_personality_gear_give.sql b/data/sql/characters/base/2026_07_03_personality_gear_give.sql
new file mode 100644
index 0000000..fa77423
--- /dev/null
+++ b/data/sql/characters/base/2026_07_03_personality_gear_give.sql
@@ -0,0 +1,28 @@
+-- Chance (percent, rolled per gear-inspect context, subject to per-bot and
+-- per-pair cooldowns) that a bot with a suitable spare item ACTUALLY mails it
+-- to the player it is talking to. Seller personalities send it COD instead of
+-- gifting (see IsGearSeller in mod-ollama-chat_handler.cpp).
+ALTER TABLE `mod_ollama_chat_personality_templates`
+    ADD COLUMN IF NOT EXISTS `gear_give_chance` FLOAT NOT NULL DEFAULT 2.0;
+
+-- Upstream-33 tuning (the custom personalities are tuned in personalities.sql)
+UPDATE `mod_ollama_chat_personality_templates` SET `gear_give_chance` = 12
+    WHERE `key` IN ('TRADER', 'GOBLIN_MERCHANT');
+UPDATE `mod_ollama_chat_personality_templates` SET `gear_give_chance` = 8
+    WHERE `key` IN ('MENTOR', 'JOLLY_BEER_LOVER', 'HEROIC_LEADER');
+UPDATE `mod_ollama_chat_personality_templates` SET `gear_give_chance` = 6
+    WHERE `key` IN ('LOOTGOBLIN', 'CASUAL');
+UPDATE `mod_ollama_chat_personality_templates` SET `gear_give_chance` = 1
+    WHERE `key` IN ('GRUMPY_VETERAN', 'EDGE_LORD', 'WANNABE_VILLAIN', 'RAGER', 'PARANOID', 'TRICKSTER');
+
+-- In-person hand-overs: a give to a stranger (no shared guild/group) parks the
+-- item here; mod-playerbots completes it when the player opens a trade window
+-- with the bot. Rows older than 10 minutes are ignored.
+CREATE TABLE IF NOT EXISTS `mod_ollama_chat_pending_gives` (
+    `bot_guid` BIGINT UNSIGNED NOT NULL,
+    `player_guid` BIGINT UNSIGNED NOT NULL,
+    `item_guid` BIGINT UNSIGNED NOT NULL,
+    `cod` INT UNSIGNED NOT NULL DEFAULT 0,
+    `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY (`bot_guid`, `player_guid`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
diff --git a/data/sql/characters/base/2026_07_03_personality_playstyle.sql b/data/sql/characters/base/2026_07_03_personality_playstyle.sql
new file mode 100644
index 0000000..5e6b5d7
--- /dev/null
+++ b/data/sql/characters/base/2026_07_03_personality_playstyle.sql
@@ -0,0 +1,22 @@
+-- Playstyle: gameplay profile consumed by mod-playerbots' New RPG strategy
+-- (per-personality activity weights: what a bot *does*, not just how it talks).
+-- Values: default | grinder | quester | socializer | explorer | pvper | idler
+-- Weight tables live in playerbots config (AiPlayerbot.RpgStatusProbWeight.<Profile>.*).
+ALTER TABLE `mod_ollama_chat_personality_templates`
+    ADD COLUMN IF NOT EXISTS `playstyle` VARCHAR(16) NOT NULL DEFAULT 'default';
+
+-- Map the upstream 33 personalities onto profiles (the 40 archetypes from
+-- personalities.sql carry their own mapping there).
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'grinder'
+    WHERE `key` IN ('GAMER', 'LOOTGOBLIN', 'LONE_WOLF');
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'quester'
+    WHERE `key` IN ('FANATIC', 'YOUNG_APPRENTICE');
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'socializer'
+    WHERE `key` IN ('ROLEPLAYER', 'TRADER', 'BARD', 'HYPE_MAN', 'FLIRT', 'MENTOR', 'GOBLIN_MERCHANT', 'CHEF');
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'explorer'
+    WHERE `key` IN ('TRICKSTER', 'FOOL', 'CONSPIRACY_THEORIST', 'SCHOLAR', 'PIRATE', 'POET', 'GLITCHED_AI');
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'pvper'
+    WHERE `key` IN ('PVP_HARDCORE', 'HEROIC_LEADER', 'EDGE_LORD', 'RAGER', 'WANNABE_VILLAIN');
+UPDATE `mod_ollama_chat_personality_templates` SET `playstyle` = 'idler'
+    WHERE `key` IN ('NPC_IMPERSONATOR', 'GRUMPY_VETERAN', 'ANCIENT_WISE_ONE', 'PARANOID', 'STONER', 'JOLLY_BEER_LOVER');
+-- RAIDER and CASUAL stay 'default' (balanced mix)
