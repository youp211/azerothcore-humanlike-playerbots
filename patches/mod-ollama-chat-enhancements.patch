+++ b/src/mod-ollama-chat_memory.h
@@ -0,0 +1,52 @@
+#ifndef MOD_OLLAMA_CHAT_MEMORY_H
+#define MOD_OLLAMA_CHAT_MEMORY_H
+
+#include <string>
+#include <cstdint>
+
+class Player;
+
+// --------------------------------------------------------------------------
+// Bot event-memory subsystem.
+//
+// A random bot records a small, bounded set of "meaningful" shared moments with
+// a REAL, currently-guilded player (duel, group, guild, shared arena/
+// battleground) and later references them in chat via the {memory_info}
+// prompt placeholder.
+//
+// Performance strategy (deliberately simple -- do NOT add DB compression):
+//   * guilded-players-only : memories are only recorded/kept about players who
+//                            are in a guild, and every row about a player is
+//                            purged when they leave one. This bounds the table
+//                            to currently-guilded players.
+//   * per-pair cap         : at most g_EventMemoryMaxPerPair rows per
+//                            (bot, player) pair; the oldest are pruned on
+//                            insert.
+// Bounding + guilded-only IS the performance strategy; row compression here
+// would be over-engineering.
+// --------------------------------------------------------------------------
+
+// Record one meaningful moment: `bot` (a random bot) remembers `player`.
+// No-op unless memory is enabled, `player` is guilded, `bot` is a random bot,
+// and `player` is a real (non-bot) player.
+void RecordMemory(Player* bot, Player* player, std::string const& eventType, std::string const& detail);
+
+// Record a moment for an unordered pair, auto-detecting which side is the bot
+// and which is the real player. Convenient to drop in beside a symmetric
+// NudgeSentimentPair() call. Records at most one direction (bot remembers
+// player); a no-op unless exactly one side is a bot.
+void RecordMemoryForPair(Player* a, Player* b, std::string const& eventType, std::string const& detail);
+
+// Build the "{memory_info}" prompt fragment listing a bot's recent memories of
+// a player, most-recent first. Returns "" when there is nothing to recall.
+std::string BuildMemoryInfo(Player* bot, Player* player);
+
+// Delete every memory row referencing this player (called when the player
+// leaves a guild). Keeps storage bounded to currently-guilded players.
+void PurgePlayerMemories(uint64_t playerGuid);
+
+// Registers the memory hook scripts (guild-leave purge + arena/BG recorder).
+// Call from Addmod_ollama_chatScripts() in mod-ollama-chat_main.cpp.
+void AddSC_mod_ollama_chat_memory();
+
+#endif // MOD_OLLAMA_CHAT_MEMORY_H
