# Copy to .env (gitignored) and edit. Scripts fall back to these defaults if
# no .env exists, so the repo carries no personal/secret values.
#
#   cp .env.example .env

# GM account that reset-world.sh (re)creates after a wipe
WOW_GM_ACCOUNT=admin
WOW_GM_PASSWORD=changeme123

# Realm name written to acore_auth.realmlist
WOW_REALM_NAME=Gigi
